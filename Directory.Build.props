<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>preview-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <!-- Web SDK defaults this true; on Linux that forces RID=linux-x64 for every project.
         Container publishes opt back in via PublishProfiles/Container.pubxml + deploy.yml. -->
    <EnableSdkContainerSupport>false</EnableSdkContainerSupport>
  </PropertyGroup>
  <!-- GitHub Actions sets CI=true. Keep solution builds portable (no -r on .slnx). -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <RuntimeIdentifier></RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
    <Authors>Digital Brain Tech</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/intochat/digitalbrain</PackageProjectUrl>
    <RepositoryUrl>https://github.com/intochat/digitalbrain</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>agents;orleans;aspire;durable;actors</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Every test project in the repo. Replaces the per-project boilerplate that used to be
       copied into each .csproj; package consumers get the same shape from buildTransitive. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or $(MSBuildProjectName.Contains('.Tests.'))">
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <RootNamespace Condition="'$(RootNamespace)' == ''">DigitalBrain.Tests</RootNamespace>
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
    <NoWarn>$(NoWarn);ORLEANSEXP005;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or $(MSBuildProjectName.Contains('.Tests.'))">
    <PackageReference Include="xunit.v3.mtp-v2" />
    <Using Include="Xunit" />
    <Using Include="DigitalBrain.Testing" />
  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests.Unit'))">
    <Using Include="DigitalBrain.Testing.Unit" />
  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests.E2E'))">
    <Using Include="DigitalBrain.Testing.E2E" />
  </ItemGroup>

  <PropertyGroup>
    <CodeGraphRefresh Condition="'$(CodeGraphRefresh)' == ''">true</CodeGraphRefresh>
    <_CodeGraphRepositoryRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory).'))</_CodeGraphRepositoryRoot>
    <_CodeGraphIndex>$([System.IO.Path]::Combine('$(_CodeGraphRepositoryRoot)', '.codegraph'))</_CodeGraphIndex>
    <_CodeGraphStamp>$([System.IO.Path]::Combine('$(_CodeGraphIndex)', 'msbuild-refresh.stamp'))</_CodeGraphStamp>
    <_CodeGraphCommand Condition="'$(_CodeGraphCommand)' == ''">npx -y @colbymchenry/codegraph@latest</_CodeGraphCommand>
  </PropertyGroup>
</Project>

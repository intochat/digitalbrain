* text=auto eol=crlf

# Explicit for .NET to ensure `dotnet format` + editorconfig (crlf) + git stay in sync across OSes.
# Run `dotnet format` from root after edits; it will normalize ws + selected styles + eol.
*.cs text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.slnx text eol=crlf
*.targets text eol=crlf
*.json text eol=crlf
*.xml text eol=crlf

*.sh text eol=lf
*.bash text eol=lf
app/lib/grpc/ui.pb.dart text eol=lf
app/lib/grpc/ui.pbenum.dart text eol=lf
app/lib/grpc/ui.pbgrpc.dart text eol=lf

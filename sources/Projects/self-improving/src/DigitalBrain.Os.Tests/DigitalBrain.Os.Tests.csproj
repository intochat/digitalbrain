<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>preview</LangVersion>
    <!-- xUnit v3 + MTP: standalone exe, MTP runner for dotnet run, IsTestProject for tooling. global.json enables MTP for `dotnet test` from root -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsTestProject>true</IsTestProject>
    <!-- Enable MTP under dotnet test (VSTest mode bridge); works with net11+ and Reqnroll/xunit.v3 setup for `dotnet test` from root -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformCaptureOutput>false</TestingPlatformCaptureOutput>
    <!-- Suppress experimental preview on IDurableList for the in-memory test impl (updated Simulation for complete Journaling switch). -->
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <!-- Imposter latest for fast mocks in simulations (verify via Context7 before heavy use) -->
    <PackageReference Include="Imposter" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" />
    <!-- Explicit for AddJournalStorage + IJournal* types in Simulation (for custom DurableNeuron + IDurableList with Orleans.Journaling brought back per user request). -->
    <!-- Reqnroll + xunit.v3 via dedicated v3 adapter for BDD (MTP enabled via global.json + props) -->
    <PackageReference Include="Reqnroll" />
    <PackageReference Include="Reqnroll.xunit.v3" />
    <PackageReference Include="Reqnroll.Tools.MsBuild.Generation" />
    <!-- Aspire.Hosting.Testing for E2E harness (port ino NeuronE2ETest + prepare for Playwright/gRPC surfaces vs file poller). -->
    <PackageReference Include="Aspire.Hosting.Testing" />
    <!-- Playwright .NET 1.60.0 for browser E2E on UI surfaces in ino/terminals port. -->
    <PackageReference Include="Microsoft.Playwright" />
    <!-- Grpc.Net.Client (central 2.80) for gRPC drive prep in E2E harness (sub SurfaceStream for surfaces from neurons/InoSession; complements Orleans client already used). Ties to prior gRPC slices (hex1b TUI terminals + Flutter wiring). -->
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <!-- Explicit central MessagePack latest to override Orleans etc transitive 2.5.192 (high sev). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigitalBrain.Os\DigitalBrain.Os.csproj" />
    <ProjectReference Include="..\DigitalBrain.Hosting\DigitalBrain.Hosting.csproj" />
    <ProjectReference Include="..\DigitalBrain.Kernel\DigitalBrain.Kernel.csproj" />
    <!-- For shared DigitalBrainSiloConfiguration + ConfigureDigitalBrainDefaults (reused by Simulation TestCluster setup). -->
    <ProjectReference Include="..\DigitalBrain.Aspire.Hosting\DigitalBrain.Aspire.Hosting.csproj" />
    <ProjectReference Include="..\DigitalBrain.SourceGen\DigitalBrain.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- For ino E2E port stub (NeuronE2ETest harness using DistributedApplicationTesting per official Aspire docs + ino pattern in 01/03/09). IsAspireProjectResource=false for test access to AppHost type. -->
    <ProjectReference Include="..\DigitalBrain.AppHost\DigitalBrain.AppHost.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
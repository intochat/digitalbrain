    <!-- MessagePack: bumped to latest (3.1.7 per dnx dotnet-inspect) to address high-severity vuln in 2.5.192
         (seen as NU1903 warning in Sdk, Kernel, AppHost, Clients, Core.Tests, simulation). CPM central pin
         overrides transitive pulls from Orleans etc. Always use latest per rules. -->
    <PackageVersion Include="MessagePack" Version="3.1.7" />
    <!-- YamlDotNet 18.0.0 (latest per Context7 dnx dotnet-inspect on 2026-06-15) for os-on-yaml schema parsing.
         Added after exhaustive Context7 lookup of DeserializerBuilder, IDeserializer.Deserialize<string>, WithCaseInsensitivePropertyMatching etc.
         Used for Y2+ per OS-ON-YAML-SPEC.md and PLAN. Central management for latest. -->
    <PackageVersion Include="YamlDotNet" Version="18.0.0" />

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire 13.3 -->
    <PackageVersion Include="Aspire.Hosting.Orleans" Version="13.5.0-preview.1.26310.9" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.5.0-preview.1.26310.9" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.3.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="13.3.0" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.5.0-preview.1.26310.9" />
    <!-- Orleans 10.1 -->
    <PackageVersion Include="Grpc.Net.Client.Web" Version="2.80.0" />
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.1.1-preview.1" />
    <PackageVersion Include="Microsoft.Orleans.Serialization" Version="10.1.1-preview.1" />
    <PackageVersion Include="Microsoft.Orleans.Core.Abstractions" Version="10.1.1-preview.1" />
    <PackageVersion Include="Microsoft.Orleans.Core" Version="10.1.1-preview.1" />
    <PackageVersion Include="Microsoft.Orleans.Client" Version="10.1.1-preview.1" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.1.1-preview.1" />
    <PackageVersion Include="Microsoft.Orleans.Clustering.Redis" Version="10.1.1-preview.1" />
    <PackageVersion Include="Microsoft.Orleans.Reminders" Version="10.1.1-preview.1" />
    <PackageVersion Include="Microsoft.Orleans.Streaming" Version="10.1.1-preview.1" />
    <PackageVersion Include="Microsoft.Orleans.Persistence.Memory" Version="10.1.1-preview.1" />
    <PackageVersion Include="Microsoft.Orleans.Journaling" Version="10.1.1-preview.1.alpha.1" />
    <!-- AI abstractions -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <PackageVersion Include="OpenAI" Version="2.10.0" />
    <!-- Whisper.net 1.9 — implements ISpeechToTextClient. Runtime packs are
         conditionally referenced per OS in DigitalBrain.Domains.Ai.csproj so we
         don't pull GPU binaries on platforms that can't use them. -->
    <PackageVersion Include="Whisper.net" Version="1.9.1-preview1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1-preview1" />
    <PackageVersion Include="Whisper.net.Runtime.Cuda" Version="1.9.1-preview1" />
    <PackageVersion Include="Whisper.net.Runtime.CoreML" Version="1.9.1-preview1" />
    <PackageVersion Include="Whisper.net.Runtime.Vulkan" Version="1.9.1-preview1" />
    <!-- Hosting + service defaults -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0-preview.4.26230.115" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0-preview.4.26230.115" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0-preview.4.26230.115" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <!-- gRPC -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageVersion Include="Grpc.AspNetCore.Web" Version="2.80.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.81.0-pre1" />
    <PackageVersion Include="Google.Protobuf" Version="4.0.0-rc2" />
    <PackageVersion Include="IF.APM.OpenTelemetry.Proto" Version="8.1.2" />
    <!-- Model Context Protocol (BrainMCP server) -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <!-- Roslyn scripting (pinned to 5.0.0 to match Microsoft.CodeAnalysis.Workspaces.Common 5.0.0 pulled by Orleans 10.1 codegen) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <!-- Test -->
    <PackageVersion Include="Microsoft.Orleans.TestingHost" Version="10.1.1-preview.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.0-pre.108" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.0-pre.108" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <!-- BDD -->
    <PackageVersion Include="Gherkin" Version="39.1.0" />
    <PackageVersion Include="Reqnroll" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.xunit.v3" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.Microsoft.Extensions.DependencyInjection" Version="3.3.4" />
    <!-- Logging -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-preview.4.26230.115" />
    <!-- Data -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0-preview.4.26230.115" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="11.0.0-preview.4.26230.115" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0-preview.4.26230.115" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0-preview.4.26230.115" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-preview.4.26230.115" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0-preview.4.26230.115" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-preview.4.26230.115" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-preview.4" />
    <!-- Google APIs (Gmail + Auth + YouTube) -->
    <PackageVersion Include="Google.Apis.Gmail.v1" Version="1.74.0.4148" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.74.0" />
    <PackageVersion Include="Google.Apis.YouTube.v3" Version="1.74.0.4137" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0-preview.4.26230.115" />
    <PackageVersion Include="Stripe.net" Version="51.2.0-beta.2" />
    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.0.0-1.25277.114" />
    <!-- Public ABI freeze guard (E-ABI #25) -->
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <!-- Azure Resource Manager -->
    <PackageVersion Include="Azure.ResourceManager" Version="1.14.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>
</Project>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DigitalBrain.SDK</RootNamespace>
    <AssemblyName>DigitalBrain.SDK</AssemblyName>
    <UserSecretsId>digitalbrain-unified-sdk</UserSecretsId>
    <NoWarn>$(NoWarn);MEAI001</NoWarn>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\kernel\DigitalBrain.Runtime\DigitalBrain.Runtime.csproj" />
    <ProjectReference Include="..\..\inolang\DigitalBrain.InoLang\DigitalBrain.InoLang.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />

    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="Whisper.net.Runtime.Cuda" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Whisper.net.Runtime.CoreML" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />

    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Clustering.Redis" />
    <PackageReference Include="Microsoft.Orleans.Reminders" />
    <PackageReference Include="Microsoft.Orleans.Streaming" />
    <PackageReference Include="Microsoft.Orleans.Journaling" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    
    <PackageReference Include="Aspire.StackExchange.Redis" />
    <PackageReference Include="Aspire.Hosting.AppHost" VersionOverride="13.4.0-preview.1.26276.1" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.Orleans" />

    <PackageReference Include="Google.Apis.Gmail.v1" />
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="Google.Apis.YouTube.v3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Stripe.net" />

    <PackageReference Include="Azure.ResourceManager" />
    <PackageReference Include="Azure.Identity" />

    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.ino" />
    <AdditionalFiles Include="**\*.ino" Exclude="bin\**\*;obj\**\*" />
  </ItemGroup>

  <!-- Widget-canvas demo neurons live under samples/ as the authoring source;
       embed them here (with stable logical names) so WidgetCanvasInoSource can
       register them at runtime without copying. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\widget-canvas\ClockNeuron.ino" LogicalName="DigitalBrain.WidgetCanvas.ClockNeuron.ino" />
    <EmbeddedResource Include="..\..\samples\widget-canvas\ReminderNeuron.ino" LogicalName="DigitalBrain.WidgetCanvas.ReminderNeuron.ino" />
    <EmbeddedResource Include="..\..\samples\widget-canvas\FlightNeuron.ino" LogicalName="DigitalBrain.WidgetCanvas.FlightNeuron.ino" />
  </ItemGroup>
</Project>

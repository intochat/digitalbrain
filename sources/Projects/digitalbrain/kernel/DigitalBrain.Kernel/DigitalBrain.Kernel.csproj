<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- The kernel no longer serves any static/Flutter content (the bundle
         moved to the standalone flutter-web Aspire resource). Disable the
         Web SDK static-web-assets pipeline so WebApplication.CreateBuilder
         does not try to PhysicalFileProvider a now-deleted wwwroot/ and
         crash at host bootstrap. Web hosting (Kestrel/gRPC) is unaffected. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Client" />
    <PackageReference Include="Microsoft.Orleans.Clustering.Redis" />
    <PackageReference Include="Microsoft.Orleans.Reminders" />
    <PackageReference Include="Microsoft.Orleans.Streaming" />
    <PackageReference Include="Aspire.StackExchange.Redis" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Web" />
    <PackageReference Include="Gherkin" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="IF.APM.OpenTelemetry.Proto" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DigitalBrain.Runtime\DigitalBrain.Runtime.csproj" />
    <ProjectReference Include="..\..\inolang\DigitalBrain.InoLang\DigitalBrain.InoLang.csproj" />
    <ProjectReference Include="..\..\sdk\DigitalBrain.SDK\DigitalBrain.SDK.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="**\*.Tests.cs" />
    <Compile Remove="User\UserNeuron.Steps.cs" />
    <Compile Remove="Introspector\IntrospectorNeuron.Steps.cs" />
    <Compile Remove="Creator\CreatorNeuron.Steps.cs" />
    <Compile Remove="Visualization\TaskManagerNeuron.Steps.cs" />
    <Compile Remove="Visualization\FlutterPerfNeuron.Steps.cs" />
    <None Include="**\*.Tests.cs" />
    <EmbeddedResource Include="**\*.feature" />
    <EmbeddedResource Include="Runtime\Settings\settings.ino" />
    <EmbeddedResource Include="Ino\Ino.ino" />
    <AdditionalFiles Include="**\*.ino" Exclude="bin\**\*;obj\**\*" />
  </ItemGroup>

</Project>

<Project>
  <PropertyGroup>
    <_ToolsManifest>$(MSBuildThisFileDirectory).config\dotnet-tools.json</_ToolsManifest>
    <_ToolsRestoredSentinel>$(MSBuildThisFileDirectory).config\.tools-restored</_ToolsRestoredSentinel>
  </PropertyGroup>

  <Target Name="RestoreDotnetTools"
          BeforeTargets="Restore;Build"
          Condition="Exists('$(_ToolsManifest)')"
          Inputs="$(_ToolsManifest)"
          Outputs="$(_ToolsRestoredSentinel)">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    <Touch Files="$(_ToolsRestoredSentinel)" AlwaysCreate="true" />
  </Target>
</Project>

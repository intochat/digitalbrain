<Project Sdk="Aspire.AppHost.Sdk/13.2.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>ino-apphost-phase-2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ino.Kernel\Ino.Kernel.csproj">
      <OutputItemType>IsAspireProjectResource</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Ino.Identity\Ino.Identity.csproj">
      <OutputItemType>IsAspireProjectResource</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\domains\travel\Ino.Domains.Travel\Ino.Domains.Travel.csproj">
      <OutputItemType>IsAspireProjectResource</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\domains\taxi\Ino.Domains.Taxi\Ino.Domains.Taxi.csproj">
      <OutputItemType>IsAspireProjectResource</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\domains\location\Ino.Domains.Location\Ino.Domains.Location.csproj">
      <OutputItemType>IsAspireProjectResource</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\domains\reminders\Ino.Domains.Reminders\Ino.Domains.Reminders.csproj">
      <OutputItemType>IsAspireProjectResource</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\domains\recall\Ino.Domains.Recall\Ino.Domains.Recall.csproj">
      <OutputItemType>IsAspireProjectResource</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\domains\genesis\Ino.Domains.Genesis\Ino.Domains.Genesis.csproj">
      <OutputItemType>IsAspireProjectResource</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\clients\Telegram\Ino.Telegram.Host.csproj">
      <OutputItemType>IsAspireProjectResource</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Ino.Aspire.Hosting\Ino.Aspire.Hosting.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Ino.Core\Ino.Core.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Ino.Llm.Xai\Ino.Llm.Xai.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <PropertyGroup>
    <WebsiteDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\website'))</WebsiteDir>
  </PropertyGroup>

  <Target Name="InstallWebsiteDependencies"
          BeforeTargets="Build"
          Inputs="$(WebsiteDir)\package-lock.json"
          Outputs="$(WebsiteDir)\node_modules\.package-lock.json">
    <Message Importance="high" Text="Installing website (VitePress) npm dependencies in $(WebsiteDir)" />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(WebsiteDir)" />
  </Target>

</Project>

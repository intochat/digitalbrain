<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Public NuGet package consumed by third-party neuron authors -->
    <IsPackable>true</IsPackable>
    <PackageId>Ino.Core.Hosting</PackageId>
    <Description>ino Core Hosting — handler interfaces (INeuron&lt;T&gt;, IReactsTo&lt;T&gt;, Neuron&lt;TEvent&gt; base class) built on Orleans 10 DurableGrain + Journaling.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Journaling" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Ulid" />
    <PackageReference Include="Gherkin" />
    <!-- NeuronOptimizer (Phase 4 Slice D) — LightGBM binary classifier
         trained per neuron+user from journaled decision records. -->
    <PackageReference Include="Microsoft.ML" />
    <PackageReference Include="Microsoft.ML.LightGbm" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Ino.Core.Hosting.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ino.Core\Ino.Core.csproj" />
    <!-- CortexCapability fires UnroutedIntent and writes to ICortexJournal + ICorrelationRegistry,
         all of which are declared in Ino.Kernel.Contracts. Kernel.Contracts only references
         Ino.Core, so no circular dependency is introduced here. -->
    <ProjectReference Include="..\Ino.Kernel.Contracts\Ino.Kernel.Contracts.csproj" />
    <!-- LlmNeuron&lt;TEvent&gt; inherits IAW's Agent, gaining IChatClient streaming,
         tool registration, durable chat history, and middleware. The
         journal-event API of Neuron&lt;TEvent&gt; is layered on top so neurons
         that need an LLM get both contracts in one base class. -->
    <ProjectReference Include="..\..\iaw\src\Core\Core.csproj" />
  </ItemGroup>
</Project>

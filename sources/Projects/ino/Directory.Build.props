<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Orleans 10 Journaling (IDurableList<T>, DurableGrain, WriteStateAsync) is marked
         [Experimental("ORLEANSEXP005")] in 10.0.1-alpha.1. It's the load-bearing primitive
         for Neuron<TEvent>. TripRadar's tripradar/Directory.Build.props is empty and
         stops MSBuild's parent walk, so these settings only apply to the ino tree. -->
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Avoids "you cannot copy assembly X to itself" errors when iaw + ino
         projects in this slnx happen to land the same assembly into the same
         output folder via NuGet transitive resolution. -->
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>Ino.Domains.Taxi</RootNamespace>
    <AssemblyName>Ino.Domains.Taxi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Ino.Core\Ino.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Ino.Core.Hosting\Ino.Core.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\Ino.ServiceDefaults\Ino.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\src\Ino.Llm.Xai\Ino.Llm.Xai.csproj" />
    <ProjectReference Include="..\Ino.Domains.Taxi.Contracts\Ino.Domains.Taxi.Contracts.csproj" />
    <!-- The ride-home plan reads the user's Location journal via
         IJournaledNeuronQuery<LocationVisited>. Cross-silo grain calls only
         need the contracts assembly on disk — the LocationNeuron
         implementation lives in its own silo (Ino.Domains.Location). -->
    <ProjectReference Include="..\..\location\Ino.Domains.Location.Contracts\Ino.Domains.Location.Contracts.csproj" />
  </ItemGroup>

  <!-- Gherkin scenarios consumed by BddMockChatClient + INeuronPromptCorpus
       — same content-copy pattern as the Travel domain. Tagged scenarios
       (@neuron:<id>) feed Cortex's regex fast-path; reply text feeds the
       mock LLM. -->
  <ItemGroup>
    <Content Include="Features\**\*.feature">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Features\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>

         Program.cs calls Aspire.IAW.AddIAW() before AddDomain to register
         IawMemoryProvider + IMemoryLookup + QdrantClient + IEmbeddingGenerator.
         Same wiring pattern as Reminders (Phase 4 Slice B). -->
    <ProjectReference Include="..\..\..\iaw\src\Aspire.Client\Aspire.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Features\**\*.feature">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Features\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>

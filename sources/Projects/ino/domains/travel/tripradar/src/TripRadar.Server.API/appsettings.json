{
  "ConnectionStrings": {
    "AppDb": "Server=trdev-pg-dev.postgres.database.azure.com;Database=TripRadarServerDb;Port=5432;User Id=postgres;Password=${DB_PASSWORD};Ssl Mode=Require;",
    "Tracing": "${JAEGER_ENDPOINT}"
  },
  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "TripRadarClient",
    "Audience": "TripRadarAPI",
    "DurationInMinutes": 1000,
    "RefreshTokenKey": "${JWT_REFRESH_TOKEN_KEY}"
  },
  "Encryption": {
    "UserDataKey": "${ENCRYPTION_USER_DATA_KEY}"
  },
  "GoogleAuth": {
    "ClientId": "${GOOGLE_CLIENT_ID}",
    "ClientSecret": "${GOOGLE_CLIENT_SECRET}"
  },
  "CorsOriginsWhiteList": "${CORS_ORIGINS}",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "BootstrapServers": "${KAFKA_BOOTSTRAP_SERVERS}",
    "SaslMechanism": "Plain",
    "SecurityProtocol": "SaslSsl",
    "SaslUsername": "$ConnectionString",
    "SaslPassword": "${KAFKA_CONNECTION_STRING}"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "Microsoft.AspNetCore.HttpsPolicy.HttpsRedirectionMiddleware": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Hangfire": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "${ELASTICSEARCH_URI}",
          "autoRegisterTemplate": true,
          "indexFormat": "tripradar-{Environment}-{0:yyyy.MM}",
          "bufferBaseFilename": "./Logs/log",
          "bufferFileSizeLimitBytes": 5242880,
          "bufferLogShippingInterval": 5,
          "registerTemplateFailure": "IndexAnyway",
          "emitEventFailure": "WriteToSelfLog, WriteToFailureSink",
          "numberOfReplicas": 1,
          "numberOfShards": 2,
          "restrictedToMinimumLevel": "Information",
          "inlineFields": true,
          "autoRegisterTemplateVersion": "ESv8",
          "detectElasticsearchVersion": true,
          "customFormatter": "Serilog.Formatting.Elasticsearch.ElasticsearchJsonFormatter, Serilog.Formatting.Elasticsearch"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithExceptionDetails",
      "WithMachineName",
      "WithEnvironmentName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "TripRadar"
    }
  },
  "ElasticConfiguration": {
    "Uri": "${ELASTICSEARCH_URI}"
  },
  "SerpApiSettings": {
    "ApiKey": "${SERP_API_KEY}",
    "RequestTimeoutSeconds": 150,
    "SearchEndpoint": "https://serpapi.com/search"
  },
  "KiwiCalendarSettings": {
    "BaseUrl": "https://api.skypicker.com",
    "RequestTimeoutSeconds": 30,
    "DefaultLocale": "en",
    "Market": "bg",
    "Partner": "skypicker"
  },
  "PaymentSettings": {
    "Stripe": {
      "SecretKey": "${STRIPE_SECRET_KEY}",
      "PublishableKey": "${STRIPE_PUBLISHABLE_KEY}",
      "WebhookSecret": "${STRIPE_WEBHOOK_SECRET}",
      "AllowUnverifiedWebhooksInDevelopment": "${STRIPE_ALLOW_UNVERIFIED_WEBHOOKS_IN_DEVELOPMENT}",
      "Currency": "usd",
      "SuccessUrl": "${STRIPE_SUCCESS_URL}",
      "CancelUrl": "${STRIPE_CANCEL_URL}",
      "Prices": {
        "BasicTierPriceId": "${STRIPE_BASIC_TIER_PRICE_ID}",
        "EssentialTierPriceId": "${STRIPE_ESSENTIAL_TIER_PRICE_ID}",
        "AdvancedTierPriceId": "${STRIPE_ADVANCED_TIER_PRICE_ID}",
        "BasicTierYearlyPriceId": "${STRIPE_BASIC_TIER_YEARLY_PRICE_ID}",
        "EssentialTierYearlyPriceId": "${STRIPE_ESSENTIAL_TIER_YEARLY_PRICE_ID}",
        "AdvancedTierYearlyPriceId": "${STRIPE_ADVANCED_TIER_YEARLY_PRICE_ID}"
      }
    }
  },
  "ApiKey": "${API_KEY}",
  "InternalApiKey": "${INTERNAL_API_KEY}",
  "App": {
    "Secret": "${APP_SECRET}",
    "BehindSSLProxy": false
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "EndpointWhitelist": [
      "get:/health",
      "head:/health",
      "get:/health/ready",
      "head:/health/ready",
      "get:/health/live",
      "head:/health/live",
      "get:/metrics"
    ],
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*/graphql",
        "Period": "1m",
        "Limit": 25
      },
      {
        "Endpoint": "*tokens/sessions",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "post:*/api/v*/users/email-confirmation-requests",
        "Period": "1h",
        "Limit": 5
      },
      {
        "Endpoint": "post:*/api/v*/users/password-reset-requests",
        "Period": "1h",
        "Limit": 5
      },
      {
        "Endpoint": "post:*/api/v*/users",
        "Period": "1h",
        "Limit": 10
      }
    ]
  },
  "Cache": {
    "SchemaName": "public",
    "TableName": "distributed_cache",
    "CreateIfNotExists": true,
    "ExpiredItemsDeletionInterval": "00:30:00"
  },
  "Caching": {
    "Enabled": true,
    "DefaultExpirationHours": 1,
    "PricesCache": {
      "ExpirationHours": 24,
      "CacheKey": "prices"
    },
    "Preferences": {
      "PreferencesCacheKey": "user_preferences:{0}",
      "PreferenceCategoriesCacheKey": "user_preference_categories:{0}",
      "AllPreferenceTypesCacheKey": "all_preference_types",
      "ServicePreferenceTypesCacheKey": "service_preference_types:{0}",
      "DefaultTtlMinutes": 60
    }
  },
  "GraphQL": {
    "ExecutionTimeoutSeconds": 90,
    "MaxPageSize": 100,
    "MaxExecutionDepth": 8
  },
  "HealthChecks": {
    "Enabled": true,
    "Path": "/health",
    "ReadinessPath": "/health/ready",
    "LivenessPath": "/health/live"
  },
  "Metrics": {
    "EnableEndpoint": false,
    "RequireInternalAuth": true
  },
  "AllowedHosts": "*",
  "EmailSettings": {
    "ConnectionString": "${EMAIL_CONNECTION_STRING}",
    "SenderEmail": "${EMAIL_SENDER_EMAIL}",
    "SenderName": "${EMAIL_SENDER_NAME}",
    "BaseUrl": "${EMAIL_BASE_URL}",
    "LogoUrl": "${EMAIL_LOGO_URL}",
    "EmailLogoUrl": "${EMAIL_LOGO_URL}",
    "BlobStorageUrl": "${BLOB_STORAGE_URL}",
    "BlobStorageSasToken": "${BLOB_STORAGE_SAS_TOKEN}",
    "RedirectUrl": "${REDIRECT_URL}",
    "SocialLinks": {
      "Telegram": "https://t.me/tripradar",
      "Instagram": "https://instagram.com/tripradar",
      "TikTok": "https://tiktok.com/@tripradar",
      "Facebook": "https://facebook.com/tripradar",
      "X": "https://twitter.com/tripradar",
      "YouTube": "https://youtube.com/@tripradar",
      "LinkedIn": "https://linkedin.com/company/tripradar"
    }
  },
  "TelegramSettings": {
    "BotToken": "${TELEGRAM_BOT_TOKEN}",
    "ClientId": "${TELEGRAM_CLIENT_ID}",
    "ClientSecret": "${TELEGRAM_CLIENT_SECRET}"
  },
  "ResiliencePolicySettings": {
    "RetryCount": 3,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 60,
    "TimeoutSeconds": 60
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": "Server=trdev-pg-dev.postgres.database.azure.com;Database=TripRadarServerDb;Port=5432;User Id=postgres;Password=${DB_PASSWORD};Ssl Mode=Require;"
  },
  "Encryption": {
    "UserDataKey": "${ENCRYPTION_USER_DATA_KEY}"
  },
  "Cache": {
    "SchemaName": "public",
    "TableName": "distributed_cache",
    "CreateIfNotExists": true,
    "ExpiredItemsDeletionInterval": "00:30:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Information",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level}] {SourceContext}: {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/jobs-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "TripRadar.Jobs"
    }
  },
  "Hangfire": {
    "WorkerCount": 5,
    "Queues": [
      "default",
      "critical"
    ],
    "IsFullAccessModeEnabled": false,
    "Dashboard": {
      "Authorization": {
        "Users": [
          {
            "Username": "__ADMIN_USERNAME__",
            "Password": "__ADMIN_PASSWORD__"
          }
        ]
      }
    },
    "JobExpirationDays": 7,
    "SchedulerPollingIntervalSeconds": 15
  },
  "JobSettings": {
    "MetterBillingJob": {
      "StaleProcessingMaxAgeMinutes": 360
    }
  },
  "AppSettings": {
    "ApplicationUrl": "https://api-dev.tripradar.io",
    "JobsEnabled": true
  },
  "Security": {
    "DashboardIpWhitelist": [
      "127.0.0.1",
      "::1"
    ]
  },
  "HealthChecks": {
    "Enabled": true,
    "Path": "/health"
  },
  "SerpApiSettings": {
    "ApiKey": "${SERP_API_KEY}",
    "RequestTimeoutSeconds": 150
  },
  "Kafka": {
    "BootstrapServers": "trdev-evhns-dev.servicebus.windows.net:9093",
    "SaslMechanism": "Plain",
    "SecurityProtocol": "SaslSsl",
    "SaslUsername": "$ConnectionString",
    "SaslPassword": "${KAFKA_CONNECTION_STRING}"
  },
  "ResiliencePolicySettings": {
    "RetryCount": 3,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 60,
    "TimeoutSeconds": 15
  }
}

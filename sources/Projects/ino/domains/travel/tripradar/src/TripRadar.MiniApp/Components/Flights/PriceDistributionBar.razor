@using TripRadar.MiniApp.Client.Infrastructure.Localization
@inject IStringLocalizer<SharedResource> L

@if (High > 0)
{
    var lowPercent = Percent(Low, High);
    var typicalPercent = Percent(Typical - Low, High);
    var highPercent = Math.Max(0, 100 - lowPercent - typicalPercent);

    <div class="space-y-2">
        <svg class="price-distribution-track" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
            <rect class="price-distribution-low" x="0" y="0" width="@lowPercent" height="12" />
            <rect class="price-distribution-typical" x="@lowPercent" y="0" width="@typicalPercent" height="12" />
            <rect class="price-distribution-high" x="@(lowPercent + typicalPercent)" y="0" width="@highPercent" height="12" />
        </svg>
        <div class="flex justify-between text-xs">
            <div class="flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-green-500"></span>
                <span class="text-slate-500 dark:text-slate-400">@L["PriceIntelLow"]</span>
                <span class="font-medium">@CurrencyFormat.FormatPrice(Low, Currency)</span>
            </div>
            <div class="flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-yellow-400"></span>
                <span class="text-slate-500 dark:text-slate-400">@L["PriceIntelTypical"]</span>
                <span class="font-medium">@CurrencyFormat.FormatPrice(Typical, Currency)</span>
            </div>
            <div class="flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-red-400"></span>
                <span class="text-slate-500 dark:text-slate-400">@L["PriceIntelHigh"]</span>
                <span class="font-medium">@CurrencyFormat.FormatPrice(High, Currency)</span>
            </div>
        </div>
    </div>
}

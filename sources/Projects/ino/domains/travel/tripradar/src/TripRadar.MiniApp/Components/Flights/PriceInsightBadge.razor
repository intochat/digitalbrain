@using TripRadar.MiniApp.Client.Infrastructure.Localization
@inject IStringLocalizer<SharedResource> L

@if (Insight is not null)
{
    var (color, icon, label) = GetLevel(Insight.PriceLevel);
    <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800">
        <span class="@Css.Join("material-symbols-outlined text-lg", color)">@icon</span>
        <div>
            <p class="text-xs font-semibold">@label</p>
            @if (Insight.TypicalPriceRange is { Length: 2 } range)
            {
                <p class="text-xs text-slate-500">@string.Format(L["PriceInsightRange"], range[0], range[1])</p>
            }
        </div>
    </div>
}

@attribute [Route(AppRoutes.FlightBooking)]
@inject IFlightManager FlightApi
@inject FlightSearchState SearchState
@inject UserPreferencesState UserPrefs
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS
@using TripRadar.MiniApp.Client.Infrastructure.Contracts
@using TripRadar.MiniApp.Client.Infrastructure.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.State
@implements IDisposable

<PageHeader Title="@_title" Subtitle="@_subtitle" ShowBack BackRoute="@AppRoutes.FlightResults" />

@if (SearchState.IsMultiLeg)
{
    <div class="flex gap-1 px-4 pt-2">
        @foreach (var flight in SearchState.Itinerary)
        {
            <div class="@Css.Join("flex-1 h-1 rounded-full",
                flight.IsBooked ? "bg-green-500" :
                flight.Index == _bookingFlightIndex ? flight.ButtonColorClass :
                "bg-slate-200 dark:bg-slate-700")">
            </div>
        }
    </div>
}

<div class="miniapp-scroll-surface">
    <div class="p-4 space-y-4">
        @if (SearchState.AllFlightsBooked)
        {
            <div class="py-6 px-5 bg-green-50 dark:bg-green-950/30 border border-green-200 dark:border-green-800 rounded-2xl text-center">
                <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3">
                    <span class="material-symbols-outlined material-symbols-filled text-white text-2xl">celebration</span>
                </div>
                <p class="text-lg font-bold text-green-800 dark:text-green-200">@L["BookingTripBooked"]</p>
                <p class="text-sm text-green-600 dark:text-green-400 mt-1">@L["BookingCheckEmail"]</p>
            </div>
        }

        <BoardingPass Itinerary="SearchState.Itinerary"
                      Currency="@UserPrefs.Currency"
                      CurrentIndex="@_bookingFlightIndex"
                      ShowTotal="@(SearchState.Itinerary.Count > 1)" />

        @if (!SearchState.AllFlightsBooked)
        {
            var currentBookingFlight = SearchState.Itinerary.ElementAtOrDefault(_bookingFlightIndex);
            @if (currentBookingFlight is not null)
            {
                <div class="flex items-center gap-2 pt-1">
                    <span class="@Css.Join("w-5 h-5 rounded-full flex items-center justify-center text-white text-[11px] font-bold", currentBookingFlight.ButtonColorClass)">
                        @(_bookingFlightIndex + 1)
                    </span>
                    <span class="text-sm font-bold">@string.Format(L["BookingBookFlight"], LocalizedLegLabel(currentBookingFlight).ToLower(System.Globalization.CultureInfo.CurrentUICulture))</span>
                </div>

                @if (_loading)
                {
                    <div class="flex items-center justify-center py-8">
                        <div class="w-5 h-5 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
                    </div>
                }
                else if (_error is not null)
                {
                    <ErrorDisplay Title="@L["BookingFailed"]" Message="@_error" OnRetry="LoadCurrentProviders" />
                }
                else if (_currentProviders is { Count: > 0 })
                {
                    <div class="space-y-2">
                        @foreach (var option in _currentProviders)
                        {
                            <div @onclick="() => OnBookClick(option)">
                                <BookingProviderCard Option="option" Currency="@UserPrefs.Currency" />
                            </div>
                        }
                    </div>
                }
            }
        }

        <p class="text-center text-[11px] text-slate-400 leading-relaxed py-2">
            @L["BookingDisclaimer"]
        </p>
    </div>
</div>


@using TripRadar.MiniApp.Client.Infrastructure.Localization
@attribute [Route(AppRoutes.NotFound)]
@layout MainLayout
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<div class="flex flex-col items-center justify-center min-h-[60vh] p-8 text-center">
    <span class="material-symbols-outlined text-6xl text-slate-300 dark:text-slate-600 mb-4">explore_off</span>
    <h1 class="text-xl font-bold mb-2">@L["NotFoundTitle"]</h1>
    <p class="text-sm text-slate-500 mb-6">@L["NotFoundMessage"]</p>
    <button @onclick="GoHome"
            class="bg-primary text-white px-6 py-2.5 rounded-xl text-sm font-semibold hover:bg-primary-dark transition-colors">
        @L["NotFoundGoSearch"]
    </button>
</div>

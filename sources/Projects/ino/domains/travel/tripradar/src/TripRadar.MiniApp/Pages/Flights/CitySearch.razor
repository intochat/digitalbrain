@attribute [Route(AppRoutes.FlightCitySearch)]
@inject IAirportManager AirportApi
@inject NavigationManager Nav
@inject FlightSearchState SearchState
@inject IStringLocalizer<SharedResource> L
@inject CountryNameLocalizer Countries
@inject CityNameLocalizer CityNames
@inject AirportNameLocalizer AirportNames
@using TripRadar.MiniApp.Client.Infrastructure.Contracts
@using TripRadar.MiniApp.Client.Infrastructure.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.State
@implements IDisposable

<div class="fixed inset-0 z-50 bg-white dark:bg-slate-900 flex flex-col">
    <div class="flex items-center gap-3 p-3 border-b border-slate-200 dark:border-slate-800">
        <button @onclick="GoBack" class="text-primary p-1">
            <span class="material-symbols-outlined">arrow_back</span>
        </button>
        <div class="flex-1 flex items-center gap-2 bg-slate-100 dark:bg-slate-800 rounded-xl px-3 py-2.5">
            <span class="material-symbols-outlined text-slate-400 text-lg">search</span>
            <input @ref="_inputRef"
                   type="text"
                   class="flex-1 bg-transparent border-none outline-none text-sm font-medium text-slate-900 dark:text-white placeholder:text-slate-400"
                   placeholder="@L["CitySearchPlaceholder"]"
                   value="@_query"
                   @oninput="OnInput" />
            @if (!string.IsNullOrEmpty(_query))
            {
                <button @onclick="ClearInput" class="text-slate-400">
                    <span class="material-symbols-outlined text-lg">close</span>
                </button>
            }
        </div>
    </div>

    <div class="flex-1 overflow-y-auto">
        @if (_suggestions.Count > 0)
        {
            <div class="py-1">
                @foreach (var city in _suggestions)
                {
                    <div class="flex items-center border-b border-slate-100 dark:border-slate-800 last:border-0">
                        <button @onclick="() => SelectCity(city)"
                                disabled="@IsSameAsOpposite(city)"
                                class="flex-1 flex items-center gap-3 px-4 py-3 text-left transition-colors @(IsSameAsOpposite(city) ? "opacity-40 cursor-not-allowed" : "hover:bg-slate-50 dark:hover:bg-slate-800 active:bg-slate-100 dark:active:bg-slate-700")">
                            <span class="text-xl w-8 text-center">@city.Flag</span>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-semibold text-slate-900 dark:text-white truncate">@CityNames.GetName(city.City)</span>
                                    @if (city.IsMultiAirport)
                                    {
                                        <span class="text-[10px] font-bold bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 px-1.5 py-0.5 rounded-full">
                                            @string.Format(L["CitySearchAirports"], city.Airports.Count)
                                        </span>
                                    }
                                </div>
                                <p class="text-xs text-slate-500 truncate">
                                    @Countries.GetName(city.CountryCode) · @FormatAirportCodes(city)
                                </p>
                            </div>
                        </button>
                        @if (city.IsMultiAirport)
                        {
                            <button @onclick="() => OpenAirportDetail(city)"
                                    class="px-3 py-3 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors border-l border-slate-100 dark:border-slate-800">
                                <span class="material-symbols-outlined text-slate-400 text-lg">chevron_right</span>
                            </button>
                        }
                    </div>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(_query) && !_isLoading)
        {
            <div class="flex flex-col items-center justify-center py-16 text-slate-400">
                <span class="material-symbols-outlined text-4xl mb-2">flight</span>
                <p class="text-sm">@L["CitySearchNoResults"]</p>
            </div>
        }
        else if (string.IsNullOrEmpty(_query))
        {
            <div class="flex flex-col items-center justify-center py-16 text-slate-400">
                <span class="material-symbols-outlined text-4xl mb-2">flight</span>
                <p class="text-sm">@L["CitySearchStartTyping"]</p>
            </div>
        }
    </div>
</div>

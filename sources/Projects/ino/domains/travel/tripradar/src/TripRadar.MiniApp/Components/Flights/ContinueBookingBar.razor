@inject FlightSearchState SearchState
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@using TripRadar.MiniApp.Client.Infrastructure.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.State
@implements IDisposable

@if (Visible)
{
    <div @onclick="NavigateToBooking"
         class="bg-slate-900 dark:bg-slate-800 px-4 py-2.5 flex items-center gap-3 cursor-pointer border-b border-slate-700">
        <div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-white text-sm">flight</span>
        </div>
        <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-white">@L["ContinueBooking"]</p>
            <p class="text-[10px] text-slate-400 truncate">@Summary</p>
        </div>
        <span class="material-symbols-outlined text-slate-400 text-lg">chevron_right</span>
    </div>
}

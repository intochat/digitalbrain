@using TripRadar.MiniApp.Client.Infrastructure.Localization
@inject IStringLocalizer<SharedResource> L

<div class="mx-4 my-4 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl">
    <div class="flex items-start gap-3">
        <span class="material-symbols-outlined text-red-500 mt-0.5">error</span>
        <div class="flex-1">
            <p class="text-sm font-semibold text-red-700 dark:text-red-400">@(string.IsNullOrEmpty(Title) ? L["CommonError"].Value : Title)</p>
            <p class="text-sm text-red-600 dark:text-red-300 mt-1">@Message</p>
            @if (OnRetry.HasDelegate)
            {
                <button @onclick="OnRetry" class="mt-3 px-4 py-1.5 bg-red-100 dark:bg-red-800 text-red-700 dark:text-red-200 rounded-lg text-xs font-semibold hover:bg-red-200 dark:hover:bg-red-700 transition-colors">
                    @L["CommonRetry"]
                </button>
            }
        </div>
    </div>
</div>

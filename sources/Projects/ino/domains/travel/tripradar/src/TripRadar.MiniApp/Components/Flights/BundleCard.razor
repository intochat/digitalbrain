@using TripRadar.MiniApp.Client.Infrastructure.Localization
@inject IStringLocalizer<SharedResource> L

<div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800
            hover:shadow-md transition-shadow cursor-pointer overflow-hidden"
     @onclick="OnSelect">

    <div class="flex items-center justify-between px-4 pt-3 pb-2">
        @if (Bundle.Tag != FlightBundleTag.None)
        {
            <span class="@TagCss">@TagLabel</span>
        }
        else
        {
            <span></span>
        }
        <p class="text-lg font-bold text-primary">@CurrencyFormat.FormatPrice(Bundle.TotalPrice, Currency)</p>
    </div>

    <div class="px-3 pb-1">
        <div class="flex items-center gap-1.5 px-1 pb-1">
            <span class="material-symbols-outlined text-xs text-blue-500">flight_takeoff</span>
            <span class="text-[11px] font-semibold text-blue-600 dark:text-blue-400 uppercase">@L["FlightsOutbound"]</span>
        </div>
        <FlightCard Flight="Bundle.Outbound" ReadOnly Currency="@Currency" />
    </div>

    <div class="border-t border-dashed border-slate-200 dark:border-slate-700 mx-4"></div>

    <div class="px-3 pt-1 pb-3">
        <div class="flex items-center gap-1.5 px-1 pb-1">
            <span class="material-symbols-outlined text-xs text-amber-500">flight_land</span>
            <span class="text-[11px] font-semibold text-amber-600 dark:text-amber-400 uppercase">@L["FlightsReturn"]</span>
        </div>
        <FlightCard Flight="Bundle.Return" ReadOnly Currency="@Currency" />
    </div>
</div>

@inherits LayoutComponentBase
@inject TopBarState TopBar
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IUserManager UserApi
@inject IStringLocalizer<SharedResource> L
@using TripRadar.MiniApp.Client.Infrastructure.Contracts
@using TripRadar.MiniApp.Client.Infrastructure.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.State

<div class="miniapp-shell shadow-sm">
    @if (!_ready)
    {
        <div class="flex-1 flex items-center justify-center">
            <div class="w-8 h-8 border-2 border-slate-200 border-t-primary rounded-full animate-spin"></div>
        </div>
    }
    else
    {
        <ContinueBookingBar />
        <main class="miniapp-main">
            @Body
        </main>
    }
</div>

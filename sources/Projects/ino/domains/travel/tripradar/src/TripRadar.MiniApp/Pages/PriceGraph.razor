@attribute [Route(AppRoutes.PriceGraph)]
@inject FlightSearchState SearchState
@inject UserPreferencesState UserPrefs
@inject IStringLocalizer<SharedResource> L
@using TripRadar.MiniApp.Client.Infrastructure.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.State
@implements IDisposable

<PageHeader Title="@L["PriceIntelTitle"]" ShowBack BackRoute="@AppRoutes.FlightResults" />

<div class="flex-1">
    @if (SearchState.Results?.PriceInsights is null)
    {
        <EmptyState Icon="show_chart" Title="@L["PriceIntelTitle"]" Message="@L["CommonError"]" />
    }
    else
    {
        var insights = SearchState.Results.PriceInsights;
        var hasHistory = insights.PriceHistory is { Count: > 0 };
        var hasRange = insights.TypicalPriceRange is { Length: 2 };

        <div class="p-4 space-y-6">
            @if (insights.LowestPrice.HasValue)
            {
                <div class="text-center py-4">
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide">
                        @L["PriceIntelCheapest"]
                    </p>
                    <p class="text-3xl font-bold text-slate-900 dark:text-white mt-1">
                        @CurrencyFormat.FormatPrice(insights.LowestPrice.Value, UserPrefs.Currency)
                    </p>
                </div>
            }

            @if (IsLowPrice)
            {
                <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-green-50 dark:bg-green-950/30 border border-green-200 dark:border-green-800">
                    <span class="material-symbols-outlined text-green-600 dark:text-green-400">trending_down</span>
                    <p class="text-sm font-medium text-green-700 dark:text-green-300">
                        @L["PriceIntelGoodPrice", DepartureMonth]
                    </p>
                </div>
            }

            <div class="flex rounded-lg bg-slate-100 dark:bg-slate-800 p-1">
                <button @onclick='() => _activeTab = "grid"'
                        class="@TabClass("grid")">
                    @L["PriceIntelDateGrid"]
                </button>
                <button @onclick='() => _activeTab = "graph"'
                        class="@TabClass("graph")">
                    @L["PriceIntelPriceGraph"]
                </button>
            </div>

            @if (_activeTab == "graph" && hasHistory)
            {
                <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-100 dark:border-slate-800 p-4 space-y-3">
                    <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300">@L["PriceIntelPriceGraph"]</h3>
                    <PriceBarChart Points="insights.PriceHistory"
                                   SelectedPoint="_selectedHistoryPoint"
                                   Currency="@UserPrefs.Currency"
                                   OnPointClicked="OnHistoryPointClicked" />
                </div>
            }
            else if (_activeTab == "grid")
            {
                <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-100 dark:border-slate-800 p-4">
                    <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">@L["PriceIntelDateGrid"]</h3>
                    @if (hasHistory)
                    {
                        <div class="grid grid-cols-7 gap-1">
                            @foreach (var point in insights.PriceHistory!)
                            {
                                var isSelected = _selectedHistoryPoint?.Date == point.Date;
                                var isCheapest = point.Price == insights.PriceHistory.Min(p => p.Price);
                                <button @onclick="() => OnHistoryPointClicked(point)"
                                        class="@Css.Join("flex flex-col items-center justify-center py-2 rounded-lg text-xs transition-colors",
                                            isSelected ? "bg-primary text-white" : isCheapest ? "bg-green-50 dark:bg-green-950/30 text-green-700 dark:text-green-400" : "hover:bg-slate-50 dark:hover:bg-slate-800")">
                                    <span class="text-[10px] opacity-70">@FormatShortDate(point.Date)</span>
                                    <span class="font-semibold">@CurrencyFormat.FormatPrice(point.Price, UserPrefs.Currency)</span>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-sm text-slate-400 text-center py-6">@L["CommonLoading"]</p>
                    }
                </div>
            }

            @if (hasRange)
            {
                <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-100 dark:border-slate-800 p-4 space-y-3">
                    <PriceDistributionBar Low="insights.TypicalPriceRange![0]"
                                          Typical="(insights.TypicalPriceRange[0] + insights.TypicalPriceRange[1]) / 2"
                                          High="insights.TypicalPriceRange[1]"
                                          Currency="@UserPrefs.Currency" />
                </div>
            }

            @if (CheaperThanPercent > 0)
            {
                <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-800">
                    <span class="material-symbols-outlined text-blue-600 dark:text-blue-400">insights</span>
                    <p class="text-sm text-blue-700 dark:text-blue-300">
                        @L["PriceIntelCheaperThan", $"{CheaperThanPercent}%"]
                    </p>
                </div>
            }
        </div>
    }
</div>

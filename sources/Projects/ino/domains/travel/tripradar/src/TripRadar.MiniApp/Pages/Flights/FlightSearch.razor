@using TripRadar.MiniApp.Client.Infrastructure.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.State

@attribute [Route(AppRoutes.Flights)]
@inject FlightSearchState SearchState
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@inject FlightPrefetchService Prefetch

<PageHeader Title="@L["FlightsTitle"].Value" />

<div class="p-4 space-y-4">
    <TripTypeSelector Value="SearchState.Params.Type" ValueChanged="t => SearchState.Params.Type = t" />

    @if (SearchState.Params.Type == FlightType.MultiCity)
    {
        <MultiCityForm OnLegDateClick="OnMultiCityDateClick" />

        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4">
            <PassengerSelector Adults="SearchState.Params.Adults"
                               Children="SearchState.Params.Children"
                               Infants="SearchState.Params.Infants"
                               OnChanged="OnPassengersChanged" />
        </div>
    }
    else
    {
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 space-y-3 relative">
            <AirportAutocomplete Placeholder="@L["FlightsDepartureCity"].Value"
                                 Icon="flight_takeoff"
                                 DisplayText="@SearchState.Params.DepartureName"
                                 CityName="@GetCityName(SearchState.Params.DepartureName)"
                                 Flag="@GetFlag(SearchState.Params.DepartureCountryCode)"
                                 Badge="@GetBadge(SearchState.Params.DepartureId)"
                                 Field="departure" />

            <div class="relative">
                <div class="absolute -top-4 right-6 z-10">
                    <button @onclick="SwapAirports" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-full p-1.5 shadow-sm hover:bg-slate-50 transition-colors">
                        <span class="material-symbols-outlined text-primary text-lg">sync_alt</span>
                    </button>
                </div>
            </div>

            <AirportAutocomplete Placeholder="@L["FlightsArrivalCity"].Value"
                                 Icon="flight_land"
                                 DisplayText="@SearchState.Params.ArrivalName"
                                 CityName="@GetCityName(SearchState.Params.ArrivalName)"
                                 Flag="@GetFlag(SearchState.Params.ArrivalCountryCode)"
                                 Badge="@GetBadge(SearchState.Params.ArrivalId)"
                                 Field="arrival" />

            <div class="@DateGridClass">
                <div>
                    <label class="text-xs text-slate-500 mb-1 block">@L["FlightsDeparture"]</label>
                    <div @onclick="OnDepartureDateClick"
                         class="@(HasRoute ? "cursor-pointer" : "cursor-default opacity-60") rounded-xl border transition-colors py-2.5 px-3 flex items-center gap-2 @(string.IsNullOrEmpty(SearchState.Params.OutboundDate) ? "border-slate-200 dark:border-slate-700" : "border-primary/30 bg-blue-50/30 dark:bg-blue-900/10")">
                        <span class="material-symbols-outlined text-lg @(string.IsNullOrEmpty(SearchState.Params.OutboundDate) ? "text-slate-400" : "text-primary")">calendar_today</span>
                        <span class="text-sm @(string.IsNullOrEmpty(SearchState.Params.OutboundDate) ? "text-slate-400" : "font-semibold text-slate-900 dark:text-white")">
                            @(FormatDateDisplay(SearchState.Params.OutboundDate) ?? L["FlightsSelectDate"].Value)
                        </span>
                    </div>
                </div>
                @if (SearchState.Params.Type == FlightType.RoundTrip)
                {
                    <div>
                        <label class="text-xs text-slate-500 mb-1 block">@L["FlightsReturn"]</label>
                        @if (HasRoute)
                        {
                            <div @onclick="OnReturnDateClick"
                                 class="cursor-pointer rounded-xl border transition-colors py-2.5 px-3 flex items-center gap-2 @(string.IsNullOrEmpty(SearchState.Params.ReturnDate) ? "border-slate-200 dark:border-slate-700" : "border-primary/30 bg-blue-50/30 dark:bg-blue-900/10")">
                                <span class="material-symbols-outlined text-lg @(string.IsNullOrEmpty(SearchState.Params.ReturnDate) ? "text-slate-400" : "text-primary")">calendar_today</span>
                                <span class="text-sm @(string.IsNullOrEmpty(SearchState.Params.ReturnDate) ? "text-slate-400" : "font-semibold text-slate-900 dark:text-white")">
                                    @(FormatDateDisplay(SearchState.Params.ReturnDate) ?? L["FlightsSelectDate"].Value)
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="cursor-default opacity-60 rounded-xl border border-slate-200 dark:border-slate-700 py-2.5 px-3 flex items-center gap-2">
                                <span class="material-symbols-outlined text-lg text-slate-400">calendar_today</span>
                                <span class="text-sm text-slate-400">@L["FlightsSelectDate"]</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <PassengerSelector Adults="SearchState.Params.Adults"
                               Children="SearchState.Params.Children"
                               Infants="SearchState.Params.Infants"
                               OnChanged="OnPassengersChanged" />
        </div>
    }

    <button @onclick="Search"
            disabled="@(!CanSearch)"
            class="w-full bg-primary hover:bg-primary-dark disabled:opacity-50 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-primary/20 transition-all flex items-center justify-center gap-2 active:scale-[0.98]">
        <span class="material-symbols-outlined">search</span>
        @L["FlightsSearchFlights"]
    </button>

</div>

<PriceCalendar DepartureId="@SearchState.Params.DepartureId"
               ArrivalId="@SearchState.Params.ArrivalId"
               Visible="@_showPriceCalendar"
               CanLoadPrices="@HasRoute"
               TripLengthDays="@CalendarTripLengthDays"
               MinDate="@(_calendarIsReturn ? ReturnMinDate : null)"
               OnDateSelected="OnPriceCalendarDateSelected"
               OnClose="() => _showPriceCalendar = false" />


@using TripRadar.MiniApp.Client.Infrastructure.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.State
@attribute [Route(AppRoutes.Hotels)]
@inject HotelSearchState SearchState
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageHeader Title="@L["HotelsTitle"]" ShowBack BackRoute="@AppRoutes.Home" />

<div class="p-4 space-y-4">
    <p class="text-lg font-bold">@L["HotelsFindStay"]</p>

    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 space-y-3">
        <div class="flex items-center bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden focus-within:border-primary">
            <span class="material-symbols-outlined text-slate-400 px-3">location_on</span>
            <input type="text"
                   class="w-full py-3 pr-4 bg-transparent border-none focus:ring-0 text-sm font-medium text-slate-900 dark:text-white placeholder:text-slate-400 outline-none"
                   placeholder="@L["HotelsWherePlaceholder"]"
                   value="@SearchState.Params.Query"
                   @oninput="e => SearchState.Params.Query = e.Value?.ToString() ?? string.Empty" />
        </div>

        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="text-xs text-slate-500 mb-1 block">@L["HotelsCheckIn"]</label>
                <input type="date" value="@SearchState.Params.CheckInDate"
                       @onchange="e => SearchState.Params.CheckInDate = e.Value?.ToString() ?? string.Empty"
                       class="w-full py-2.5 px-3 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm focus:ring-1 focus:ring-primary outline-none" />
            </div>
            <div>
                <label class="text-xs text-slate-500 mb-1 block">@L["HotelsCheckOut"]</label>
                <input type="date" value="@SearchState.Params.CheckOutDate"
                       @onchange="e => SearchState.Params.CheckOutDate = e.Value?.ToString() ?? string.Empty"
                       class="w-full py-2.5 px-3 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm focus:ring-1 focus:ring-primary outline-none" />
            </div>
        </div>

        <GuestSelector Adults="SearchState.Params.Adults"
                        Children="SearchState.Params.Children"
                        OnChanged="OnGuestsChanged" />
    </div>

    <button @onclick="Search"
            disabled="@(!CanSearch)"
            class="w-full bg-primary hover:bg-primary-dark disabled:opacity-50 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-primary/20 transition-all flex items-center justify-center gap-2 active:scale-[0.98]">
        <span class="material-symbols-outlined">search</span>
        @L["HotelsSearch"]
    </button>
</div>

@using TripRadar.MiniApp.Client.Infrastructure.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.Localization
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@inject CountryNameLocalizer Countries

<div class="@CardCss"
     @onclick="ViewDetails">
    <div class="flex items-center gap-3">
        @if (!string.IsNullOrEmpty(Flight.AirlineLogo))
        {
            <img src="@Flight.AirlineLogo" alt="" class="w-8 h-8 rounded" />
        }
        <p class="flex-1 text-sm font-bold">@AirlineName</p>
        <div class="text-right">
            <div class="flex items-center justify-end gap-2">
                <p class="text-lg font-bold text-primary">@CurrencyFormat.FormatPrice(Flight.Price, Currency)</p>
                @if (IsSelected)
                {
                    <div class="w-5 h-5 bg-primary rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-white text-xs">check</span>
                    </div>
                }
            </div>
            @if (RunningTotal.HasValue)
            {
                <p class="text-[10px] text-slate-400">@L["FlightsRunningTotal"]: @CurrencyFormat.FormatPrice(RunningTotal.Value, Currency)</p>
            }
        </div>
    </div>

    @if (Flight.Flights.Count > 0)
    {
        var first = Flight.Flights[0];
        var last = Flight.Flights[^1];
        var stops = Flight.Flights.Count - 1;

        <div class="flex items-center justify-between text-sm">
            <div>
                <p class="font-semibold">@first.DepartureAirport.Time</p>
                <p class="text-xs text-slate-500">@first.DepartureAirport.Name</p>
            </div>
            <div class="flex-1 mx-4 flex flex-col items-center">
                <p class="text-xs text-slate-400">@FormatDuration(Flight.TotalDuration)</p>
                <div class="w-full h-px bg-slate-200 dark:bg-slate-700 relative my-1">
                    @if (stops == 0)
                    {
                        <span class="material-symbols-outlined text-[10px] text-slate-400 absolute left-1/2 -translate-x-1/2 -translate-y-1/2">flight</span>
                    }
                    else
                    {
                        <span class="flight-stop-markers px-2">
                            @for (var i = 0; i < stops; i++)
                            {
                                <span class="w-[7px] h-[7px] rounded-full bg-amber-400 border border-white dark:border-slate-900"></span>
                            }
                        </span>
                    }
                </div>
                <p class="@Css.Join("text-xs", stops == 0 ? "text-green-600 dark:text-green-400 font-medium" : "text-slate-500")">
                    @StopsLabel
                </p>
            </div>
            <div class="text-right">
                <p class="font-semibold">@last.ArrivalAirport.Time</p>
                <p class="text-xs text-slate-500">@last.ArrivalAirport.Name</p>
            </div>
        </div>

        @if (stops > 0 && Flight.Layovers is { Count: > 0 })
        {
            <div class="flex flex-col gap-1 mt-1">
                @for (var i = 0; i < Flight.Layovers.Count; i++)
                {
                    var layover = Flight.Layovers[i];
                    var arrivalAirport = Flight.Flights[i].ArrivalAirport;
                    <div class="flex items-center gap-1.5 text-xs min-w-0">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0"></span>
                        <span class="truncate text-slate-500 dark:text-slate-400">@LayoverName(layover, arrivalAirport)</span>
                        <span class="text-slate-300 dark:text-slate-600 shrink-0">·</span>
                        <span class="text-amber-600 dark:text-amber-400 font-medium shrink-0 whitespace-nowrap">
                            @string.Format(L["FlightsLayover"], FormatDuration(layover.Duration))
                        </span>
                    </div>
                }
            </div>
        }
    }
</div>


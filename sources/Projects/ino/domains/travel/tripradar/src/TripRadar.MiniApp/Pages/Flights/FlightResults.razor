@attribute [Route(AppRoutes.FlightResults)]
@inject FlightSearchState SearchState
@inject IFlightManager FlightApi
@inject UserPreferencesState UserPrefs
@inject TrackingState Tracking
@inject AuthState Auth
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav
@inject BundlePrefetchService BundlePrefetch
@using TripRadar.MiniApp.Client.Infrastructure.Contracts
@using TripRadar.MiniApp.Client.Infrastructure.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.State
@implements IDisposable

@if (SearchState.IsMultiLeg)
{
    <div class="flex-shrink-0 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center px-4 pt-3 pb-0">
            <button @onclick='() => Nav.NavigateTo(AppRoutes.Flights)' class="mr-2">
                <span class="material-symbols-outlined text-slate-600">arrow_back</span>
            </button>
            <h1 class="text-base font-bold flex-1">@HeaderTitle</h1>
        </div>
        <div class="flex">
            @foreach (var leg in SearchState.Itinerary)
            {
                var isDone = leg.Index < SearchState.CurrentFlightIndex && leg.SelectedFlight is not null;
                var isCurrent = leg.Index == SearchState.CurrentFlightIndex;
                var isFuture = leg.Index > SearchState.CurrentFlightIndex;
                var tabIndex = leg.Index;
                <button @onclick="() => OnTabClick(tabIndex)"
                        disabled="@isFuture"
                        class="@Css.Join("flex-1 py-3 px-4 text-center transition-colors",
                            isDone ? "opacity-80" : "",
                            isCurrent ? $"border-b-2 {leg.BorderColorClass}" : "",
                            isFuture ? "opacity-40" : "")">
                    @if (isDone)
                    {
                        <p class="text-[11px] font-bold text-green-600 uppercase">
                            <span class="material-symbols-outlined material-symbols-filled text-xs align-middle">check_circle</span>
                            @LocalizedLegLabel(leg)
                        </p>
                        <p class="text-xs text-slate-600 mt-0.5">@leg.GetFlightSummary(UserPrefs.Currency)</p>
                    }
                    else
                    {
                        <p class="@Css.Join("text-[11px] font-bold uppercase", isCurrent ? leg.ColorClass : "text-slate-400")">Step @(leg.Index + 1) — @LocalizedLegLabel(leg)</p>
                        <p class="text-xs text-slate-500 mt-0.5">@leg.RouteLabel</p>
                    }
                </button>
            }
        </div>
    </div>
}
else
{
    <PageHeader Title="@HeaderTitle" ShowBack BackRoute="@AppRoutes.Flights" />
}

@if (SearchState.Params.Type == FlightType.RoundTrip)
{
    <div class="flex-shrink-0 bg-slate-100 dark:bg-slate-900 p-1">
        <div class="flex">
            @foreach (var (mode, icon, label) in RoundTripModes)
            {
                var isActive = SearchState.RoundTripMode == mode;
                <button @onclick="() => SwitchMode(mode)"
                        class="@Css.Join("flex-1 flex items-center justify-center gap-1 py-2 text-xs font-semibold rounded-md transition-all",
                            isActive ? "bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-sm" : "text-slate-500")">
                    <span class="material-symbols-outlined text-sm">@icon</span>
                    @label
                </button>
            }
        </div>
    </div>
}

<div class="flex flex-col flex-1 min-h-0">
    @if (SearchState.IsBundleMode)
    {
        @if (SearchState.IsBundlesLoading)
        {
            <div class="flex-1 flex items-center justify-center">
                <LoadingSpinner Message="@L["FlightsBundlesLoading"]" />
            </div>
        }
        else if (SortedBundles.Count > 0)
        {
            <div class="flex-shrink-0 bg-white dark:bg-slate-950 px-4 py-2 border-b border-slate-100 dark:border-slate-800">
                <div class="flex gap-1">
                    @foreach (var sort in Enum.GetValues<PairedSortOrder>())
                    {
                        <button @onclick="() => SetPairedSort(sort)"
                                class="@Css.Join("px-3 py-1.5 text-xs font-semibold rounded-full transition-colors",
                                    SearchState.PairedSort == sort ? "bg-primary text-white" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400")">
                            @PairedSortLabel(sort)
                        </button>
                    }
                </div>
            </div>
            <div class="flex-1 overflow-y-auto min-h-0 p-4 space-y-4">
                @foreach (var bundle in SortedBundles)
                {
                    <BundleCard Bundle="bundle" Currency="@UserPrefs.Currency" OnSelect="() => OnBundleSelected(bundle)" />
                }
            </div>
        }
        else
        {
            <div class="flex-1">
                <EmptyState Icon="package_2" Title="@L["FlightsBundlesEmpty"]" Message="@L["FlightsBundlesEmptyDesc"]" />
            </div>
        }
    }
    else if (ActiveLoading)
    {
        <div class="flex-1 flex items-center justify-center">
            <LoadingSpinner Message="@string.Format(L["FlightsSearching"], LocalizedCurrentLegLabelLower())" />
        </div>
    }
    else if (SearchState.Error is not null)
    {
        <div class="flex-1">
            <ErrorDisplay Title="@L["ResultsSearchFailed"]" Message="@SearchState.Error"
                          OnRetry="LoadCurrentFlightResults" />
        </div>
    }
    else if (ActiveResults is not null)
    {
        <div class="flex-shrink-0 bg-white dark:bg-slate-950 px-4 pt-3 pb-2 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2 miniapp-horizontal-scroll no-scrollbar">
                <FilterPill Label='@L["FlightsFilters"]' Icon="tune" IsActive="_filters.HasActiveFilters" OnClick='() => OpenSheet("filters")' />
                <FilterPill Label='@L["FlightsStops"]' ShowDropdown IsActive="_filters.Stops.Count > 0" OnClick='() => OpenSheet("stops")' />
                <FilterPill Label='@L["FlightsAirlines"]' ShowDropdown IsActive="_filters.Airlines.Count > 0" OnClick='() => OpenSheet("airlines")' />
                <FilterPill Label='@L["FlightsPrice"]' ShowDropdown IsActive="_filters.MaxPrice.HasValue" OnClick='() => OpenSheet("price")' />
                <FilterPill Label='@L["ResultsTimes"]' ShowDropdown IsActive="_filters.TimeRange.HasValue" OnClick='() => OpenSheet("times")' />
            </div>
        </div>

        @if (SearchState.IsPairedMode && SearchState.CurrentFlightIndex == 0)
        {
            <div class="flex-shrink-0 bg-white dark:bg-slate-950 px-4 py-2 border-b border-slate-100 dark:border-slate-800">
                <div class="flex gap-1">
                    @foreach (var sort in Enum.GetValues<PairedSortOrder>())
                    {
                        <button @onclick="() => SetPairedSort(sort)"
                                class="@Css.Join("px-3 py-1.5 text-xs font-semibold rounded-full transition-colors",
                                    SearchState.PairedSort == sort ? "bg-primary text-white" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400")">
                            @PairedSortLabel(sort)
                        </button>
                    }
                </div>
            </div>
        }

        <div class="flex-1 overflow-y-auto min-h-0 p-4 space-y-4">
            @if (SortedFilteredBest.Count > 0)
            {
                <div>
                    @if (!ShowSortTabs)
                    {
                        <h3 class="text-sm font-semibold text-slate-500 mb-2">@L["ResultsBestFlights"]</h3>
                    }
                    <div class="space-y-3">
                        @foreach (var flight in SortedFilteredBest)
                        {
                            @if (SearchState.IsMultiLeg)
                            {
                                <FlightCard Flight="flight" IsSelected="IsFlightSelected(flight)"
                                            Currency="@UserPrefs.Currency"
                                            RunningTotal="@GetRunningTotal(flight)"
                                            OnSelect="() => OnFlightSelected(flight)" />
                            }
                            else
                            {
                                <FlightCard Flight="flight" Currency="@UserPrefs.Currency" OnSelect="() => OnFlightSelected(flight)" />
                            }
                        }
                    </div>
                </div>
            }

            @if (SortedFilteredOther.Count > 0)
            {
                <div>
                    @if (!ShowSortTabs)
                    {
                        <h3 class="text-sm font-semibold text-slate-500 mb-2">@L["ResultsOtherFlights"]</h3>
                    }
                    <div class="space-y-3">
                        @foreach (var flight in SortedFilteredOther)
                        {
                            @if (SearchState.IsMultiLeg)
                            {
                                <FlightCard Flight="flight" IsSelected="IsFlightSelected(flight)"
                                            Currency="@UserPrefs.Currency"
                                            RunningTotal="@GetRunningTotal(flight)"
                                            OnSelect="() => OnFlightSelected(flight)" />
                            }
                            else
                            {
                                <FlightCard Flight="flight" Currency="@UserPrefs.Currency" OnSelect="() => OnFlightSelected(flight)" />
                            }
                        }
                    </div>
                </div>
            }

            @if (SortedFilteredBest.Count == 0 && SortedFilteredOther.Count == 0)
            {
                <EmptyState Icon="flight_takeoff"
                            Title="@string.Format(L["ResultsNoLegFlights"], LocalizedCurrentLegLabelLower())"
                            Message="@(_filters.HasActiveFilters ? L["ResultsAdjustFilters"] : L["ResultsAdjustSearch"])" />
            }
        </div>
    }

    @if (SearchState.IsMultiLeg && !ActiveLoading && CurrentFlight?.SelectedFlight is not null)
    {
        <div class="flex-shrink-0 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <div class="min-w-0">
                    <p class="text-xs text-slate-400">@string.Format(L["ResultsLegSelected"], LocalizedLegLabel(CurrentFlight))</p>
                    <p class="text-sm font-bold text-slate-800 dark:text-slate-200 truncate">@CurrentFlight.GetFlightSummary(UserPrefs.Currency)</p>
                </div>
                @if (SearchState.IsLastFlight)
                {
                    <button @onclick="OnViewBooking"
                            class="bg-green-600 text-white px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap shadow-sm">
                        @L["ResultsViewBooking"] →
                    </button>
                }
                else
                {
                    var nextFlight = SearchState.Itinerary[SearchState.CurrentFlightIndex + 1];
                    <button @onclick="OnChooseNext"
                            class="@Css.Join("text-white px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap shadow-sm", nextFlight.ButtonColorClass)">
                        @string.Format(L["ResultsChooseLeg"], LocalizedLegLabel(nextFlight)) →
                    </button>
                }
            </div>
        </div>
    }

    @if (Auth.IsAuthenticated)
    {
        <div class="flex-shrink-0 border-t @(_isTracking ? "border-emerald-200 bg-emerald-50 dark:bg-emerald-950/30 dark:border-emerald-800" : "border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900") px-4 py-3.5">
            <div class="space-y-3">
                @if (_trackingError is not null)
                {
                    <div class="flex items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2.5 text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-100">
                        <span class="material-symbols-outlined text-base text-amber-600 dark:text-amber-300 mt-0.5">info</span>
                        <div class="min-w-0">
                            <p class="text-xs font-bold">@_trackingErrorTitle</p>
                            <p class="text-xs leading-snug text-amber-800 dark:text-amber-200">@_trackingError</p>
                        </div>
                    </div>
                }

                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl @(_isTracking ? "bg-emerald-100 dark:bg-emerald-900/40" : "bg-blue-100 dark:bg-blue-900/30") flex items-center justify-center flex-shrink-0">
                        <span class="@Css.Join("material-symbols-outlined", _isTracking ? "material-symbols-filled text-emerald-600 dark:text-emerald-400" : "text-blue-600 dark:text-blue-400")">
                            @(_isTracking ? "notifications_active" : "notifications")
                        </span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-bold @(_isTracking ? "text-emerald-800 dark:text-emerald-200" : "text-slate-800 dark:text-slate-200")">
                            @(_isTracking ? L["TrackingActive"] : L["PriceAlerts"])
                        </p>
                        <p class="text-xs @(_isTracking ? "text-emerald-600 dark:text-emerald-400" : "text-slate-500 dark:text-slate-400")">
                            @(_isTracking ? L["TrackingActiveDesc"] : L["PriceAlertsDesc"])
                        </p>
                    </div>
                    <button @onclick="ToggleTracking"
                            disabled="@_trackingInProgress"
                            class="@Css.Join("w-12 h-7 rounded-full relative flex-shrink-0 transition-colors",
                                _isTracking ? "bg-emerald-500" : "bg-slate-200 dark:bg-slate-600")">
                        @if (_trackingInProgress)
                        {
                            <span class="absolute inset-0 flex items-center justify-center">
                                <span class="material-symbols-outlined text-sm animate-spin text-white">progress_activity</span>
                            </span>
                        }
                        else
                        {
                            <span class="@Css.Join("absolute top-1 w-5 h-5 bg-white rounded-full shadow transition-transform",
                                _isTracking ? "left-6" : "left-1")"></span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>
@* Filter sheets *@
<FilterSheet IsOpen='_activeSheet == "filters"' Title='@L["FlightsFilters"]' OnClose="CloseSheet">
    <ChildContent>
        <p class="text-sm text-slate-500 mb-4">@L["ResultsActiveFilters"] @(_filters.HasActiveFilters ? "" : L["ResultsNoActiveFilters"])</p>
        @if (_filters.Stops.Count > 0)
        {
            <p class="text-sm mb-1"><span class="font-medium">@L["FlightsStops"]:</span> @string.Join(", ", _filters.Stops.Order().Select(s => s == 0 ? L["FlightsNonstop"] : string.Format(s > 1 ? L["FlightsStopsCount"] : L["FlightsStopCount"], s)))</p>
        }
        @if (_filters.Airlines.Count > 0)
        {
            <p class="text-sm mb-1"><span class="font-medium">@L["FlightsAirlines"]:</span> @string.Join(", ", _filters.Airlines.Order())</p>
        }
        @if (_filters.MaxPrice.HasValue)
        {
            <p class="text-sm mb-1"><span class="font-medium">@L["ResultsMaxPrice"]</span> @CurrencyFormat.FormatPrice(_filters.MaxPrice.Value, UserPrefs.Currency)</p>
        }
        @if (_filters.TimeRange.HasValue)
        {
            <p class="text-sm mb-1"><span class="font-medium">@L["ResultsDeparture"]</span> @FormatTimeRange(_filters.TimeRange.Value)</p>
        }
    </ChildContent>
    <FooterContent>
        <button @onclick="ClearFilters" class="w-full py-2.5 text-sm font-semibold text-red-500 hover:bg-red-50 dark:hover:bg-red-950 rounded-xl transition-colors">
            @L["ResultsClearAll"]
        </button>
    </FooterContent>
</FilterSheet>

<FilterSheet IsOpen='_activeSheet == "stops"' Title='@L["FlightsStops"]' OnClose="CloseSheet">
    <ChildContent>
        <div class="space-y-1">
            @foreach (var stopCount in new[] { 0, 1, 2 })
            {
                var label = stopCount == 0 ? L["FlightsNonstop"] : string.Format(stopCount > 1 ? L["FlightsStopsCount"] : L["FlightsStopCount"], stopCount);
                var isChecked = _filters.Stops.Contains(stopCount);
                <label class="flex items-center gap-3 py-3 border-b border-slate-100 dark:border-slate-800 last:border-0 cursor-pointer">
                    <input type="checkbox" checked="@isChecked" @onchange="() => ToggleStop(stopCount)"
                           class="w-5 h-5 rounded border-slate-300 text-primary focus:ring-primary" />
                    <span class="text-sm font-medium">@label</span>
                </label>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <button @onclick="() => { _filters.Stops.Clear(); }" class="w-full py-2.5 text-sm font-semibold text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-xl transition-colors">
            @L["ResultsClear"]
        </button>
    </FooterContent>
</FilterSheet>

<FilterSheet IsOpen='_activeSheet == "airlines"' Title='@L["FlightsAirlines"]' OnClose="CloseSheet">
    <ChildContent>
        <div class="space-y-1">
            @foreach (var airline in AvailableAirlines.Order())
            {
                var isChecked = _filters.Airlines.Contains(airline);
                <label class="flex items-center gap-3 py-3 border-b border-slate-100 dark:border-slate-800 last:border-0 cursor-pointer">
                    <input type="checkbox" checked="@isChecked" @onchange="() => ToggleAirline(airline)"
                           class="w-5 h-5 rounded border-slate-300 text-primary focus:ring-primary" />
                    <span class="text-sm font-medium">@airline</span>
                </label>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <button @onclick="() => { _filters.Airlines.Clear(); }" class="w-full py-2.5 text-sm font-semibold text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-xl transition-colors">
            @L["ResultsClear"]
        </button>
    </FooterContent>
</FilterSheet>

<FilterSheet IsOpen='_activeSheet == "price"' Title='@L["FilterMaxPrice"]' OnClose="CloseSheet">
    <ChildContent>
        @{ var (minPrice, maxPrice) = PriceRange; }
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <span class="text-sm font-medium">@L["FilterEnablePrice"]</span>
                <button @onclick="TogglePriceFilter"
                        class="@Css.Join("w-10 h-6 rounded-full relative transition-colors",
                            _filters.MaxPrice.HasValue ? "bg-primary" : "bg-slate-200 dark:bg-slate-700")">
                    <span class="@Css.Join("absolute top-1 w-4 h-4 bg-white rounded-full shadow transition-transform",
                        _filters.MaxPrice.HasValue ? "left-5" : "left-1")"></span>
                </button>
            </div>

            @if (_filters.MaxPrice.HasValue && maxPrice > minPrice)
            {
                <p class="text-sm text-slate-500">@string.Format(L["FilterPriceRange"], minPrice, maxPrice)</p>
                <input type="range" min="@minPrice" max="@maxPrice" step="10"
                       value="@_filters.MaxPrice.Value"
                       @onchange="OnPriceChanged"
                       class="w-full accent-primary" />
                <p class="text-center text-lg font-bold text-primary">
                    @string.Format(L["FilterUpTo"], _filters.MaxPrice.Value)
                </p>
            }
            else if (!_filters.MaxPrice.HasValue)
            {
                <p class="text-sm text-slate-400 text-center py-4">@L["FilterNoPriceLimit"]</p>
            }
        </div>
    </ChildContent>
</FilterSheet>

<FilterSheet IsOpen='_activeSheet == "times"' Title='@L["FilterDepartureTime"]' OnClose="CloseSheet">
    <ChildContent>
        <div class="space-y-1">
            @foreach (var range in Enum.GetValues<DepartureTimeRange>())
            {
                var isSelected = _filters.TimeRange == range;
                <button @onclick="() => SetTimeRange(range)"
                        class="@Css.Join("w-full text-left px-4 py-3 rounded-xl text-sm font-medium transition-colors",
                            isSelected ? "bg-primary/10 text-primary" : "hover:bg-slate-50 dark:hover:bg-slate-800")">
                    @FormatTimeRange(range)
                </button>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <button @onclick="() => { _filters.TimeRange = null; }" class="w-full py-2.5 text-sm font-semibold text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-xl transition-colors">
            @L["ResultsClear"]
        </button>
    </FooterContent>
</FilterSheet>


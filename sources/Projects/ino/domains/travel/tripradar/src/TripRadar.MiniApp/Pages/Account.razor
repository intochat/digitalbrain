@attribute [Route(AppRoutes.Account)]
@inject IStringLocalizer<SharedResource> L
@inject IUserManager UserApi
@inject AuthState Auth
@inject MiniAppConfigService MiniAppConfig
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject TopBarState TopBar
@using TripRadar.MiniApp.Client.Infrastructure.Contracts
@using TripRadar.MiniApp.Client.Infrastructure.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.State

<PageHeader Title="@L["AccountTitle"].Value" ShowBack />

<div class="miniapp-scroll-surface p-4 space-y-4">
    <div class="flex items-center gap-4 p-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl">
        <div class="relative flex-shrink-0">
            <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center overflow-hidden">
                @if (_profile?.ProfilePictureUrl is not null)
                {
                    <img src="@_profile.ProfilePictureUrl" alt="" class="w-full h-full object-cover" />
                }
                else
                {
                    <span class="material-symbols-outlined text-3xl text-primary">person</span>
                }
            </div>
            @if (UserTier.IsPaid(_profile?.TierName))
            {
                <span class="tier-indicator absolute -right-1 -bottom-1" title='@L["AccountPaidTierIndicator", _profile?.TierName ?? string.Empty]'>
                    <span class="material-symbols-outlined">workspace_premium</span>
                </span>
            }
        </div>
        <div class="flex-1 min-w-0">
            <p class="text-base font-bold">@(_profile?.DisplayName ?? L["AccountTraveler"])</p>
            <p class="text-sm text-slate-500">@L["AccountManage"]</p>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden">
        <div class="flex items-center gap-3 px-4 py-3.5 border-b border-slate-100 dark:border-slate-800">
            <span class="material-symbols-outlined text-slate-400">language</span>
            <span class="flex-1 text-sm font-medium">@L["AccountLanguage"]</span>
            <select value="@_selectedLanguage"
                    @onchange="OnLanguageChanged"
                    class="bg-transparent text-sm text-slate-600 dark:text-slate-300 font-medium text-right border-none outline-none cursor-pointer">
                <option value="en">English</option>
                <option value="ru">Русский</option>
            </select>
        </div>

        <button class="w-full flex items-center gap-3 px-4 py-3.5 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors border-b border-slate-100 dark:border-slate-800">
            <span class="material-symbols-outlined text-slate-400">notifications</span>
            <span class="flex-1 text-left text-sm font-medium">@L["AccountNotifications"]</span>
            <span class="material-symbols-outlined text-slate-300 text-lg">chevron_right</span>
        </button>

        <button @onclick="OpenOnWebsite" disabled="@_openingWebsite"
                class="w-full flex items-center gap-3 px-4 py-3.5 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors border-b border-slate-100 dark:border-slate-800 disabled:opacity-50">
            <span class="material-symbols-outlined text-slate-400">open_in_new</span>
            <span class="flex-1 text-left text-sm font-medium">@L["AccountOpenOnWebsite"]</span>
            <span class="material-symbols-outlined text-slate-300 text-lg">chevron_right</span>
        </button>

        @if (_openOnWebsiteError is not null)
        {
            <p class="px-4 py-2 text-xs text-red-500 border-b border-slate-100 dark:border-slate-800">@_openOnWebsiteError</p>
        }

        <button @onclick="SignOut"
                class="w-full flex items-center gap-3 px-4 py-3.5 hover:bg-red-50 dark:hover:bg-red-900/10 transition-colors">
            <span class="material-symbols-outlined text-red-500">logout</span>
            <span class="flex-1 text-left text-sm font-medium text-red-500">@L["AccountSignOut"]</span>
        </button>
    </div>

    <div class="text-center pt-4">
        <p class="text-xs text-slate-400">@L["AccountVersion"]</p>
    </div>
</div>

@using TripRadar.MiniApp.Client.Infrastructure.Localization
@inject IStringLocalizer<SharedResource> L

<div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
    @foreach (var flight in Itinerary)
    {
        var isBooked = flight.IsBooked;
        var isCurrent = flight.Index == CurrentIndex;

        @if (flight.Index > 0)
        {
            <div class="mx-5 border-t border-dashed border-slate-200 dark:border-slate-700"></div>
        }

        <div class="@Css.Join("px-4 py-3 relative", isBooked ? "bg-green-50/50 dark:bg-green-950/20" : isCurrent ? flight.BgColorClass : "opacity-50")">
            <div class="flex items-center justify-between mb-1.5">
                <span class="@Css.Join("text-[10px] font-bold uppercase tracking-wider flex items-center gap-1",
                    isBooked ? "text-green-600" : flight.ColorClass)">
                    <span class="@Css.Join("material-symbols-outlined text-xs", isBooked ? "material-symbols-filled" : "")">
                        @(isBooked ? "check_circle" : flight.Icon)
                    </span>
                    @FormatLabelWithDate(flight)
                </span>
                @if (isBooked)
                {
                    <span class="text-[10px] font-semibold text-green-700 bg-green-100 dark:bg-green-900 dark:text-green-300 px-2 py-0.5 rounded flex items-center gap-1">
                        <span class="material-symbols-outlined text-[10px]">check</span>
                        @L["BoardingPassBooked"]
                    </span>
                }
                else if (flight.SelectedFlight is not null)
                {
                    <span class="font-mono text-sm font-semibold">@CurrencyFormat.FormatPrice(flight.SelectedFlight.Price, Currency)</span>
                }
            </div>

            @if (flight.SelectedFlight is { Flights.Count: > 0 } selected)
            {
                var first = selected.Flights[0];
                var last = selected.Flights[^1];
                var stops = selected.Flights.Count - 1;

                <div class="flex items-center">
                    <div>
                        <div class="font-mono text-lg font-medium leading-tight">@ExtractTime(first.DepartureAirport.Time)</div>
                        <div class="text-[10px] text-slate-400 font-medium">@AirportCode(first.DepartureAirport)</div>
                    </div>
                    <div class="flex-1 mx-3 flex flex-col items-center">
                        <div class="text-[10px] text-slate-400">@FormatDuration(selected.TotalDuration)</div>
                        <div class="w-full h-px bg-slate-200 dark:bg-slate-700 my-0.5 relative">
                            <div class="absolute right-0 top-[-2.5px] w-[6px] h-[6px] rounded-full bg-slate-300"></div>
                        </div>
                        <div class="text-[10px] font-medium @(stops == 0 ? "text-green-600" : "text-slate-500")">
                            @(stops == 0 ? L["BoardingPassNonstop"] : string.Format(stops > 1 ? L["BoardingPassStopsPlural"] : L["BoardingPassStops"], stops))
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="font-mono text-lg font-medium leading-tight">@ExtractTime(last.ArrivalAirport.Time)</div>
                        <div class="text-[10px] text-slate-400 font-medium">@AirportCode(last.ArrivalAirport)</div>
                    </div>
                </div>

                <div class="flex items-center gap-1.5 mt-1.5">
                    @if (!string.IsNullOrEmpty(selected.AirlineLogo))
                    {
                        <img src="@selected.AirlineLogo" alt="" class="w-4 h-4 rounded" />
                    }
                    <span class="text-[11px] text-slate-500">
                        @(first.Airline ?? "")
                        @if (isBooked && !string.IsNullOrEmpty(flight.BookedVia))
                        {
                            <span> · @string.Format(L["BoardingPassVia"], flight.BookedVia)</span>
                        }
                    </span>
                </div>
            }
        </div>
    }

    @if (ShowTotal && Itinerary.Count > 1)
    {
        var allBooked = Itinerary.All(f => f.IsBooked);
        <div class="@Css.Join("px-4 py-2.5 flex justify-between items-center border-t",
            allBooked ? "bg-green-50 dark:bg-green-950/30 border-green-200 dark:border-green-800" : "bg-slate-50 dark:bg-slate-800/50 border-slate-200 dark:border-slate-700")">
            <span class="@Css.Join("text-xs font-medium", allBooked ? "text-green-700 dark:text-green-300" : "text-slate-500")">
                @(allBooked ? L["BoardingPassTotalPaid"] : L["BoardingPassTotal"])
            </span>
            <span class="@Css.Join("font-mono text-base font-bold", allBooked ? "text-green-700 dark:text-green-300" : "")">
                @CurrencyFormat.FormatPrice(Itinerary.Where(f => f.SelectedFlight is not null).Sum(f => f.SelectedFlight!.Price), Currency)
            </span>
        </div>
    }
</div>


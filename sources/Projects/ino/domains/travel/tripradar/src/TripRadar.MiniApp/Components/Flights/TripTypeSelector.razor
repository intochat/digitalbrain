@using TripRadar.MiniApp.Client.Infrastructure.Localization
@inject IStringLocalizer<SharedResource> L

<div class="flex bg-slate-100 dark:bg-slate-800 p-1 rounded-lg">
    @foreach (var type in Types)
    {
        var isActive = Value == type.Type;
        <button @onclick="() => Select(type.Type)"
                class="@Css.Join("flex-1 py-1.5 text-xs font-medium rounded-md transition-all",
                    isActive ? "bg-white dark:bg-slate-700 shadow-sm text-primary" : "text-slate-500 hover:text-slate-700")">
            @type.Label
        </button>
    }
</div>

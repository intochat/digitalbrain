@using TripRadar.MiniApp.Client.Infrastructure.Localization
@attribute [Route(AppRoutes.Companion)]
@inject IStringLocalizer<SharedResource> L


<div class="flex flex-col flex-1 min-h-0 overflow-hidden">

    <PageHeader Title="@L["CompanionTitle"].Value" ShowBack BackRoute="@AppRoutes.Home" />

    <!-- Chat body -->
    <div class="miniapp-scroll-surface bg-slate-50 dark:bg-slate-900 px-4 py-4 space-y-4">

        <!-- Today pill -->
        <div class="flex justify-center">
            <span class="text-[11px] text-slate-400 bg-white dark:bg-slate-800 px-3 py-0.5 rounded-full shadow-sm">
                @L["CompanionToday"]
            </span>
        </div>

        <!-- 1. Bot: Greeting -->
        <div class="flex items-start gap-2 max-w-[85%]">
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-violet-600 to-indigo-600 flex items-center justify-center text-xs shrink-0">🧭</div>
            <div>
                <div class="companion-bubble-bot bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-sm px-3 py-2 shadow-sm">
                    @L["CompanionGreeting"]
                </div>
                <span class="text-[10px] text-slate-400 mt-0.5 block">9:41 AM</span>
            </div>
        </div>

        <!-- 2. Bot: Weather card + AI suggestion -->
        <div class="flex items-start gap-2 max-w-[88%]">
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-violet-600 to-indigo-600 flex items-center justify-center text-xs shrink-0">🧭</div>
            <div>
                <div class="companion-bubble-bot bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-sm px-3 py-2 shadow-sm">
                    <p>@L["CompanionWeatherUpdate"]</p>

                    <!-- Weather card -->
                    <div class="companion-weather-card rounded-xl p-3 mt-2 border border-blue-900/30">
                        <div class="flex justify-between items-center mb-2">
                            <span class="font-semibold text-[13px] text-blue-300">🏛️ Athens, Greece</span>
                            <span class="text-2xl font-bold text-slate-200">14°</span>
                        </div>
                        <div class="flex gap-3 text-[11px] text-slate-400">
                            <span>🌙 Night: 8°</span>
                            <span>💧 40% rain</span>
                        </div>
                        <div class="companion-weather-alert flex items-center gap-1.5 mt-2 rounded-lg px-2.5 py-1.5 text-[11px] text-orange-300 border border-orange-400/30">
                            ⚠️ @L["CompanionWeatherAlert"]
                        </div>
                    </div>

                    <!-- AI-suggested action -->
                    <div class="companion-suggestion-card flex items-center gap-2 mt-2.5 rounded-xl px-3 py-2.5 border border-dashed border-violet-500/35">
                        <div class="w-8 h-8 rounded-[10px] bg-gradient-to-br from-violet-600 to-indigo-600 flex items-center justify-center text-[15px] shrink-0">
                            🧥
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="text-[10px] font-semibold text-violet-400 uppercase tracking-wide">@L["CompanionSuggested"]</div>
                            <div class="text-[13px] text-slate-200 font-medium">@L["CompanionAddHoodie"]</div>
                        </div>
                        <div class="w-7 h-7 rounded-full bg-violet-600 flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-white text-base">add</span>
                        </div>
                    </div>
                </div>
                <span class="text-[10px] text-slate-400 mt-0.5 block">9:41 AM</span>
            </div>
        </div>

        <!-- 3. User: Add jacket -->
        <div class="flex justify-end">
            <div class="max-w-[75%]">
                <div class="companion-bubble-user bg-[#7c3aed] text-white text-sm px-3 py-2 shadow-sm">
                    @L["CompanionUserJacket"]
                </div>
                <span class="text-[10px] text-slate-400 mt-0.5 block text-right">9:42 AM</span>
            </div>
        </div>

        <!-- 4. Bot: Packing checklist -->
        <div class="flex items-start gap-2 max-w-[85%]">
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-violet-600 to-indigo-600 flex items-center justify-center text-xs shrink-0">🧭</div>
            <div>
                <div class="companion-bubble-bot bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-sm px-3 py-2 shadow-sm space-y-1.5">
                    <p>@L["CompanionPacking"]</p>
                    <div class="space-y-1 text-[13px]">
                        <div class="flex items-center gap-1.5">
                            <span>✅</span><span>@L["CompanionPackPassport"]</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span>✅</span><span>@L["CompanionPackAdapter"]</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span>✅</span><span>@L["CompanionPackSunscreen"]</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-violet-400">
                            <span>✅</span>
                            <span>@L["CompanionPackJacket"]</span>
                            <span class="text-[11px] opacity-70">— @L["CompanionPackJacketAdded"]</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-red-500">
                            <span>⬜</span><span>@L["CompanionPackSlippers"]</span>
                        </div>
                    </div>
                </div>
                <span class="text-[10px] text-slate-400 mt-0.5 block">9:42 AM</span>
            </div>
        </div>

        <!-- 5. Bot: Deal card -->
        <div class="flex items-start gap-2 max-w-[88%]">
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-violet-600 to-indigo-600 flex items-center justify-center text-xs shrink-0">🧭</div>
            <div>
                <div class="companion-bubble-bot bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-sm px-3 py-2 shadow-sm">
                    <p>@L["CompanionDealIntro"]</p>

                    <!-- Deal card -->
                    <div class="companion-deal-card rounded-xl p-3 mt-2 border border-green-900/30">
                        <div class="flex items-center gap-2 font-semibold text-[13px] text-green-300 mb-1.5">
                            ✈️ @L["CompanionDealRoute"]
                        </div>
                        <div class="flex items-baseline gap-2.5">
                            <span class="text-sm text-slate-500 line-through">$312</span>
                            <span class="text-[22px] font-extrabold text-emerald-400">$241</span>
                            <span class="text-[11px] font-semibold text-slate-900 bg-emerald-400 px-2 py-0.5 rounded-full">-23%</span>
                        </div>
                        <div class="text-[11px] text-slate-500 mt-1.5">📉 @L["CompanionDealLowest"]</div>
                    </div>
                </div>
                <div class="flex gap-2 mt-2">
                    <span class="text-xs px-3 py-1 rounded-full border border-slate-300 dark:border-slate-600 text-slate-500 dark:text-slate-400">
                        @L["CompanionMaybeLater"]
                    </span>
                    <span class="text-xs px-3 py-1 rounded-full bg-[#7c3aed] text-white">
                        @L["CompanionShowDeal"]
                    </span>
                </div>
                <span class="text-[10px] text-slate-400 mt-1 block">9:43 AM</span>
            </div>
        </div>

        <!-- 6. Bot: Typing indicator -->
        <div class="flex items-start gap-2">
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-violet-600 to-indigo-600 flex items-center justify-center text-xs shrink-0">🧭</div>
            <div class="companion-bubble-bot bg-white dark:bg-slate-800 px-3 py-2 shadow-sm">
                <div class="flex gap-1.5 py-0.5">
                    <span class="companion-typing-dot w-2 h-2 rounded-full bg-slate-400"></span>
                    <span class="companion-typing-dot companion-typing-dot-delay-1 w-2 h-2 rounded-full bg-slate-400"></span>
                    <span class="companion-typing-dot companion-typing-dot-delay-2 w-2 h-2 rounded-full bg-slate-400"></span>
                </div>
            </div>
        </div>

        <!-- Bottom spacing -->
        <div class="h-4"></div>
    </div>

    <!-- Coming Soon banner -->
    <div class="companion-coming-soon-banner relative shrink-0 py-3 px-4 overflow-hidden border-t border-white/5">
        <div class="companion-coming-soon-glow absolute inset-0 pointer-events-none"></div>
        <div class="companion-coming-soon-line absolute top-0 left-0 right-0 h-px"></div>
        <div class="relative z-10 flex items-center justify-center gap-2.5">
            <span class="companion-coming-soon-badge inline-flex items-center gap-1.5 text-[10px] font-bold text-white/90 px-2.5 py-0.5 rounded-full shrink-0">
                <span class="w-1 h-1 rounded-full bg-emerald-400 animate-pulse"></span>
                @L["CompanionComingSoon"]
            </span>
            <p class="text-[12.5px] text-slate-400">
                @L["CompanionComingSoonDesc"]
            </p>
        </div>
    </div>
</div>

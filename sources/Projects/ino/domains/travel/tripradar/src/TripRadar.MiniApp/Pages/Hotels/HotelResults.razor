@attribute [Route(AppRoutes.HotelResults)]
@inject HotelSearchState SearchState
@inject IHotelManager HotelApi
@inject UserPreferencesState UserPrefs
@inject IStringLocalizer<SharedResource> L
@using TripRadar.MiniApp.Client.Infrastructure.Contracts
@using TripRadar.MiniApp.Client.Infrastructure.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.State
@implements IDisposable

<PageHeader Title="@SearchState.Params.Query" ShowBack BackRoute="@AppRoutes.Hotels">
    <RightContent>
        <button class="w-8 h-8 rounded-lg flex items-center justify-center hover:bg-slate-100 dark:hover:bg-slate-800">
            <span class="material-symbols-outlined text-xl">search</span>
        </button>
    </RightContent>
</PageHeader>

<div class="miniapp-scroll-surface">
    @if (SearchState.IsLoading)
    {
        <LoadingSpinner Message="@L["HotelsSearching"]" />
    }
    else if (SearchState.Error is not null)
    {
        <ErrorDisplay Title="@L["HotelsSearchFailed"]" Message="@SearchState.Error" OnRetry="LoadResults" />
    }
    else if (SearchState.Results is not null)
    {
        <div class="p-4 space-y-4">
            <div class="flex items-center gap-2 miniapp-horizontal-scroll no-scrollbar pb-1">
                <FilterPill Label="@L["HotelsFilters"]" Icon="tune" />
                <FilterPill Label="@L["HotelsPrice"]" ShowDropdown />
                <FilterPill Label="@L["HotelsRating"]" ShowDropdown />
                <FilterPill Label="@L["HotelsAmenities"]" ShowDropdown />
            </div>

            @if (SearchState.Results.SearchInformation?.TotalResults is { } total)
            {
                <p class="text-xs text-slate-500">@string.Format(L["HotelsPropertiesFound"], total)</p>
            }

            @if (SearchState.Results.Properties is { Count: > 0 })
            {
                <div class="space-y-4">
                    @foreach (var hotel in SearchState.Results.Properties)
                    {
                        <HotelCard Hotel="hotel" Currency="@UserPrefs.Currency" />
                    }

                    @if (SearchState.NextPageToken is not null)
                    {
                        <button @onclick="LoadMore"
                                disabled="@SearchState.IsLoadingMore"
                                class="w-full py-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-sm font-semibold text-primary hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors disabled:opacity-50 flex items-center justify-center gap-2">
                            @if (SearchState.IsLoadingMore)
                            {
                                <span class="material-symbols-outlined text-sm animate-spin">progress_activity</span>
                                @L["HotelsLoadingMore"]
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-sm">expand_more</span>
                                @L["HotelsLoadMore"]
                            }
                        </button>
                    }
                </div>
            }
            else
            {
                <EmptyState Icon="hotel" Title="@L["HotelsNoResults"]" Message="@L["HotelsNoResultsHint"]" />
            }
        </div>
    }
</div>

@if (IsOpen)
{
    <div class="fixed inset-0 z-40 flex flex-col justify-end">
        <div class="absolute inset-0 bg-black/40" @onclick="Close"></div>
        <div class="relative bg-white dark:bg-slate-900 rounded-t-2xl max-h-[85vh] flex flex-col animate-slide-up">
            <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100 dark:border-slate-800">
                <h3 class="text-base font-bold">@Title</h3>
                <button @onclick="Close" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-slate-100 dark:hover:bg-slate-800">
                    <span class="material-symbols-outlined text-xl">close</span>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto p-4">
                @ChildContent
            </div>
            @if (FooterContent is not null)
            {
                <div class="border-t border-slate-100 dark:border-slate-800 p-4">
                    @FooterContent
                </div>
            }
        </div>
    </div>
}

<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TripRadar.MiniApp</RootNamespace>
    <BlazorIcuDataFileName>icudt_no_CJK.dat</BlazorIcuDataFileName>
  </PropertyGroup>

  <!-- Workaround: dotnet/aspnetcore#65271 — stale .gz on incremental builds breaks MapStaticAssets(). Fixed in preview.3+ -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DisableBuildCompression>true</DisableBuildCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\TripRadar.MiniApp.Infrastructure\TripRadar.MiniApp.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <MiniAppComponentScss Include="**\*.razor.scss" Exclude="node_modules\**;bin\**;obj\**;wwwroot\**" />
    <Watch Include="**\*.scss" Exclude="node_modules\**;bin\**;obj\**" />
  </ItemGroup>

  <Target Name="RestoreMiniAppNpmDependencies"
          Inputs="package.json;package-lock.json"
          Outputs="node_modules\.package-lock.json">
    <Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="CompileMiniAppScss"
          DependsOnTargets="RestoreMiniAppNpmDependencies"
          BeforeTargets="ResolveScopedCssInputs">
    <Exec Command="npm run sass -- --no-source-map --style=compressed wwwroot/styles/app.scss wwwroot/styles/app.css"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(MiniAppComponentScss.Identity)', '.*[/\\]_.*'))"
          Command="npm run sass -- --no-source-map --style=compressed &quot;%(MiniAppComponentScss.Identity)&quot; &quot;%(MiniAppComponentScss.RelativeDir)%(Filename).css&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>


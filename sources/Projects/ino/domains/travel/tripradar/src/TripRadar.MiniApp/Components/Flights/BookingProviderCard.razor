@using TripRadar.MiniApp.Client.Infrastructure.Localization
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden hover:shadow-md transition-shadow">
    @if (Option.IsAirline)
    {
        <div class="text-[10px] font-semibold text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950 px-3.5 py-1 border-b border-blue-100 dark:border-blue-900">
            ✈ @L["BookingAirlineDirect"]
        </div>
    }

    <div class="flex items-center gap-3 p-3.5">
        @if (!string.IsNullOrEmpty(ProviderLogo))
        {
            <div class="provider-logo-frame">
                <img src="@ProviderLogo" alt="" />
            </div>
        }
        else
        {
            <div class="provider-logo-frame">
                <span class="provider-logo-fallback">@ProviderInitial</span>
            </div>
        }

        <div class="flex-1 min-w-0">
            <span class="text-sm font-semibold truncate block">@(Option.BookWith ?? L["BookingBook"])</span>
            @if (Option.MarketedAs is { Count: > 0 })
            {
                <span class="text-[11px] text-slate-400 truncate block">@string.Join(" · ", Option.MarketedAs)</span>
            }
        </div>

        <div class="flex items-center gap-3 flex-shrink-0">
            @if (Option.Price.HasValue)
            {
                <span class="text-lg font-bold">@CurrencyFormat.FormatPrice(Option.Price.Value, Currency)</span>
            }
            <button @onclick="Open"
                    class="px-4 py-2 rounded-lg text-sm font-semibold bg-primary text-white hover:bg-primary-dark transition-colors flex items-center gap-1">
                @L["BookingBook"]
                <span class="material-symbols-outlined text-base">open_in_new</span>
            </button>
        </div>
    </div>

    @if (HasBaggageOrSeparateTickets)
    {
        <div class="flex flex-wrap gap-1.5 px-3.5 pb-3">
            @if (Option.BaggagePrices is { Count: > 0 })
            {
                @foreach (var bag in Option.BaggagePrices)
                {
                    <span class="@BaggageTagCss(bag)">@BaggageLabel(bag)</span>
                }
            }
            @if (Option.SeparateTickets)
            {
                <span class="text-[11px] bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800 px-2 py-0.5 rounded-md cursor-pointer inline-flex items-center gap-1 hover:bg-amber-100 dark:hover:bg-amber-900 transition-colors"
                      @onclick="ShowSeparateInfo" @onclick:stopPropagation>
                    ⚠ @L["BookingSeparateTickets"]
                </span>
            }
        </div>
    }
</div>

<BottomSheet IsOpen="_showSeparateInfo" OnClose="CloseSeparateInfo"
             Icon="⚠️" Title="@L["BookingSeparateTickets"]"
             BadgeText="@L["BookingGoodToKnow"]" BadgeCss="bg-amber-100 text-amber-700 dark:bg-amber-900 dark:text-amber-300">
    <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
        @L["BookingSeparateTicketsExplanation"]
    </p>
</BottomSheet>

@using TripRadar.MiniApp.Client.Infrastructure.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.State
@attribute [Route(AppRoutes.FlightAirportDetail)]
@inject NavigationManager Nav
@inject FlightSearchState SearchState
@inject IStringLocalizer<SharedResource> L
@inject CountryNameLocalizer Countries
@inject CityNameLocalizer CityNames
@inject AirportNameLocalizer AirportNames

@if (_city is not null)
{
    <div class="fixed inset-0 z-50 bg-white dark:bg-slate-900 flex flex-col">
        <div class="flex items-center gap-3 p-3 border-b border-slate-200 dark:border-slate-800">
            <button @onclick="GoBack" class="text-primary p-1">
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <div>
                <p class="text-sm font-semibold text-slate-900 dark:text-white">@string.Format(L["AirportDetailTitle"], CityNames.GetName(_city.City))</p>
                <p class="text-xs text-slate-500">@L["AirportDetailSubtitle"]</p>
            </div>
        </div>

        <div class="flex-1 overflow-y-auto">
            <div class="flex items-center gap-3 px-4 py-4 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50">
                <span class="text-2xl">@_city.Flag</span>
                <div>
                    <p class="text-base font-bold text-slate-900 dark:text-white">@CityNames.GetName(_city.City), @Countries.GetName(_city.CountryCode)</p>
                    <p class="text-xs text-slate-500">@string.Format(L["AirportDetailServeCity"], _city.Airports.Count)</p>
                </div>
            </div>

            @foreach (var airport in _city.Airports)
            {
                var isChecked = _selected.Contains(airport.Code);
                var isFar = airport.DistanceFromCenter > 50;

                <button @onclick="() => ToggleAirport(airport.Code)"
                        class="w-full flex items-center gap-3 px-4 py-3 border-b border-slate-100 dark:border-slate-800 text-left transition-colors @(isFar ? "bg-amber-50/50 dark:bg-amber-900/5" : "")">
                    <div class="w-6 h-6 rounded-md border-2 flex items-center justify-center transition-colors @(isChecked ? "bg-primary border-primary" : "border-slate-300 dark:border-slate-600")">
                        @if (isChecked)
                        {
                            <span class="material-symbols-outlined text-white text-sm">check</span>
                        }
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <span class="text-base font-bold @(isFar ? "text-amber-600 dark:text-amber-400" : "text-primary")">@airport.Code</span>
                            <span class="text-sm text-slate-700 dark:text-slate-300">@AirportNames.GetName(airport.Code, airport.Name)</span>
                        </div>
                        @if (airport.DistanceFromCenter is not null)
                        {
                            <p class="text-xs mt-0.5 @(isFar ? "text-amber-600 dark:text-amber-400" : "text-slate-500")">
                                @if (isFar)
                                {
                                    <span>⚠ </span>
                                }
                                @string.Format(L["AirportDetailKmFromCenter"], airport.DistanceFromCenter)
                            </p>
                        }
                    </div>
                </button>
            }
        </div>

        <div class="p-4 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
            <button @onclick="Confirm"
                    disabled="@(_selected.Count == 0)"
                    class="w-full bg-primary disabled:opacity-40 text-white font-bold py-3 rounded-xl transition-all active:scale-[0.98]">
                @if (_selected.Count == _city.Airports.Count)
                {
                    <span>@string.Format(L["AirportDetailSelectAll"], _city.Airports.Count)</span>
                }
                else if (_selected.Count > 0)
                {
                    <span>@string.Format(L["AirportDetailSelectCodes"], string.Join(", ", _selected))</span>
                }
                else
                {
                    <span>@L["AirportDetailSelectAirports"]</span>
                }
            </button>
        </div>
    </div>
}

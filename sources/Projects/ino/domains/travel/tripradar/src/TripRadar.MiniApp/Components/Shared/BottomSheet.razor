@using TripRadar.MiniApp.Client.Infrastructure.Localization
@inject IStringLocalizer<SharedResource> L

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-end justify-center" @onclick="Close">
        <div class="absolute inset-0 bg-black/40"></div>
        <div class="relative bg-white dark:bg-slate-900 rounded-t-2xl w-full max-w-lg p-6 pb-8 bottom-sheet-panel"
             @onclick:stopPropagation>
            <div class="w-10 h-1 bg-slate-300 dark:bg-slate-600 rounded-full mx-auto mb-5"></div>
            <div class="text-center">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <div class="text-4xl mb-3">@Icon</div>
                }
                <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-1">@Title</h3>
                @if (!string.IsNullOrEmpty(BadgeText))
                {
                    <span class="inline-block text-[10px] font-bold px-2 py-0.5 rounded-full mb-4 @(BadgeCss ?? "bg-primary/10 text-primary")">@BadgeText</span>
                }
                @ChildContent
            </div>
            <button class="w-full mt-6 py-3 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-semibold rounded-xl text-sm active:scale-[0.98] transition-transform"
                    @onclick="Close">
                @(CloseText ?? L["CommonGotIt"])
            </button>
        </div>
    </div>
}



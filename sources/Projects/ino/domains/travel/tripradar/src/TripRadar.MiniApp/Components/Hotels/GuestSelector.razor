@using TripRadar.MiniApp.Client.Infrastructure.Localization
@inject IStringLocalizer<SharedResource> L

<div class="relative">
    <button @onclick="Toggle"
            class="w-full flex items-center bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-3 text-sm font-medium text-slate-900 dark:text-white">
        <span class="material-symbols-outlined text-slate-400 mr-3">group</span>
        <span class="flex-1 text-left">@Summary</span>
        <span class="material-symbols-outlined text-slate-400 text-sm">expand_more</span>
    </button>

    @if (_open)
    {
        <div class="absolute z-30 left-0 right-0 mt-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-lg p-4 space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-sm text-slate-700 dark:text-slate-300">@L["GuestSelectorAdults"]</span>
                <div class="flex items-center gap-3">
                    <button disabled="@(Adults <= 1)" @onclick="async () => await Update(Adults - 1, Children)" class="w-8 h-8 rounded-full border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 disabled:opacity-30 hover:bg-slate-50 dark:hover:bg-slate-700">
                        <span class="material-symbols-outlined text-lg">remove</span>
                    </button>
                    <span class="w-6 text-center text-sm font-semibold">@Adults</span>
                    <button disabled="@(Adults >= 20)" @onclick="async () => await Update(Adults + 1, Children)" class="w-8 h-8 rounded-full border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 disabled:opacity-30 hover:bg-slate-50 dark:hover:bg-slate-700">
                        <span class="material-symbols-outlined text-lg">add</span>
                    </button>
                </div>
            </div>
            <div class="flex items-center justify-between">
                <span class="text-sm text-slate-700 dark:text-slate-300">@L["GuestSelectorChildren"]</span>
                <div class="flex items-center gap-3">
                    <button disabled="@(Children <= 0)" @onclick="async () => await Update(Adults, Children - 1)" class="w-8 h-8 rounded-full border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 disabled:opacity-30 hover:bg-slate-50 dark:hover:bg-slate-700">
                        <span class="material-symbols-outlined text-lg">remove</span>
                    </button>
                    <span class="w-6 text-center text-sm font-semibold">@Children</span>
                    <button disabled="@(Children >= 10)" @onclick="async () => await Update(Adults, Children + 1)" class="w-8 h-8 rounded-full border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 disabled:opacity-30 hover:bg-slate-50 dark:hover:bg-slate-700">
                        <span class="material-symbols-outlined text-lg">add</span>
                    </button>
                </div>
            </div>
            <button @onclick="Toggle" class="w-full py-2 bg-primary text-white rounded-lg text-sm font-semibold">
                @L["GuestSelectorDone"]
            </button>
        </div>
    }
</div>

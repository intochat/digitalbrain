@using TripRadar.MiniApp.Client.Infrastructure.Localization
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<div class="flex flex-col rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md transition-shadow cursor-pointer"
     @onclick="ViewDetails">
    @if (Hotel.Images is { Count: > 0 })
    {
        <div class="relative w-full aspect-[16/9]">
            <img src="@Hotel.Images[0].Thumbnail" alt="@Hotel.Name" class="w-full h-full object-cover" loading="lazy" />
            <button @onclick:stopPropagation @onclick="() => {}" class="absolute top-3 right-3 p-2 bg-white/90 dark:bg-slate-800/90 rounded-full shadow-sm hover:bg-white transition-colors">
                <span class="material-symbols-outlined text-xl text-slate-600">bookmark</span>
            </button>
            @if (!string.IsNullOrEmpty(Hotel.Deal))
            {
                <div class="absolute bottom-3 left-3 px-2 py-1 bg-green-600 text-white text-xs font-bold rounded-md">
                    @Hotel.Deal
                </div>
            }
        </div>
    }

    <div class="p-4 space-y-2">
        <div class="flex justify-between items-start">
            <div class="flex-1 mr-2">
                <h3 class="text-base font-bold">@Hotel.Name</h3>
                @if (Hotel.ExtractedHotelClass is > 0 and var stars)
                {
                    <div class="flex items-center gap-0.5 mt-0.5" title="@string.Format(L["HotelDetailsStars"], stars)">
                        @for (var i = 0; i < stars; i++)
                        {
                            <span class="material-symbols-outlined text-amber-400 text-xs icon-filled">star</span>
                        }
                    </div>
                }
            </div>
            @if (Hotel.OverallRating.HasValue)
            {
                <div class="flex items-center gap-1 text-sm">
                    <span class="material-symbols-outlined text-yellow-500 text-base icon-filled">star</span>
                    <span class="font-semibold">@Hotel.OverallRating.Value.ToString("0.0")</span>
                    @if (Hotel.Reviews.HasValue)
                    {
                        <span class="text-slate-500 font-normal text-xs">(@Hotel.Reviews)</span>
                    }
                </div>
            }
        </div>

        @if (Hotel.Amenities is { Count: > 0 })
        {
            <p class="text-xs text-slate-500 flex items-center gap-1 flex-wrap">
                @foreach (var amenity in Hotel.Amenities.Take(3))
                {
                    <span>@amenity</span>
                    <span class="last:hidden">·</span>
                }
            </p>
        }

        <div class="flex items-end justify-between pt-2 border-t border-slate-100 dark:border-slate-800">
            <div>
                @if (Hotel.RatePerNight?.ExtractedLowest is { } rate)
                {
                    <p class="text-lg font-bold text-primary">
                        @CurrencyFormat.FormatPrice(rate, Currency)<span class="text-xs font-normal text-slate-500">@L["HotelsPerNight"]</span>
                    </p>
                }
                @if (Hotel.TotalRate?.ExtractedLowest is { } total)
                {
                    <p class="text-xs text-slate-400">@CurrencyFormat.FormatPrice(total, Currency) @L["HotelsTotal"]</p>
                }
            </div>
            <button class="bg-primary text-white px-5 py-2 rounded-lg text-sm font-semibold hover:bg-primary-dark transition-colors">
                @L["HotelsViewDetails"]
            </button>
        </div>
    </div>
</div>

@inject NavigationManager Nav
@inject TopBarState TopBar
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS
@using TripRadar.MiniApp.Client.Infrastructure.Localization
@using TripRadar.MiniApp.Client.Infrastructure.Services.State
@implements IDisposable

<header class="sticky top-0 z-20 bg-white/90 dark:bg-slate-950/90 backdrop-blur-md border-b border-slate-100 dark:border-slate-800">
    <div class="flex items-center h-14 px-4 gap-3">

        @* Left side: back button + title OR branding *@
        <div class="flex items-center gap-2 flex-1 min-w-0">
            @if (ShowBack)
            {
                <button @onclick="GoBack"
                        class="flex items-center justify-center w-8 h-8 -ml-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none">
                    <span class="material-symbols-outlined text-xl">arrow_back</span>
                </button>
            }

            @if (ShowBranding)
            {
                <div class="cursor-pointer outline-none" @onclick="@(() => Nav.NavigateTo(AppRoutes.Home))" tabindex="-1">
                    <h1 class="text-lg font-extrabold text-slate-900 dark:text-white leading-tight">TripRadar</h1>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 -mt-0.5">@L["HomeSubtitle"]</p>
                </div>
            }
            else
            {
                <div class="min-w-0">
                    <h1 class="text-lg font-bold truncate outline-none">@Title</h1>
                    @if (!string.IsNullOrEmpty(Subtitle))
                    {
                        <p class="text-xs text-slate-500 dark:text-slate-400 -mt-0.5 truncate">@Subtitle</p>
                    }
                </div>
            }
        </div>

        @* Right side: page-specific content + bell + avatar *@
        <div class="flex items-center gap-3 flex-shrink-0">
            @if (RightContent is not null)
            {
                @RightContent
            }

            @* Notification bell *@
            <button @onclick="@(() => Nav.NavigateTo(AppRoutes.Alerts))"
                    class="relative flex items-center justify-center w-8 h-8 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none">
                <span class="material-symbols-outlined text-xl text-slate-600 dark:text-slate-300">notifications</span>
                @if (TopBar.AlertCount > 0)
                {
                    <span class="absolute -top-0.5 -right-0.5 min-w-[16px] h-4 px-1 flex items-center justify-center bg-red-500 text-white text-[9px] font-bold rounded-full">
                        @(TopBar.AlertCount > 99 ? "99+" : TopBar.AlertCount)
                    </span>
                }
            </button>

            @* User avatar *@
            <button @onclick="@(() => Nav.NavigateTo(AppRoutes.Account))"
                    class="relative active:scale-95 transition-all duration-200 focus:outline-none">
                <div class="w-[38px] h-[38px] rounded-full ring-2 ring-slate-200 dark:ring-slate-700 overflow-hidden p-0.5 bg-white dark:bg-slate-900">
                    @if (TopBar.Profile?.ProfilePictureUrl is not null)
                    {
                        <img src="@TopBar.Profile.ProfilePictureUrl" alt="" class="w-full h-full rounded-full object-cover" />
                    }
                    else
                    {
                        <div class="w-full h-full rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                            <span class="material-symbols-outlined text-base text-slate-500">person</span>
                        </div>
                    }
                </div>
                @if (UserTier.IsPaid(TopBar.Profile?.TierName))
                {
                    <span class="tier-indicator absolute -right-1 -bottom-1" title='@L["AccountPaidTierIndicator", TopBar.Profile?.TierName ?? string.Empty]'>
                        <span class="material-symbols-outlined">workspace_premium</span>
                    </span>
                }
            </button>
        </div>

    </div>
</header>

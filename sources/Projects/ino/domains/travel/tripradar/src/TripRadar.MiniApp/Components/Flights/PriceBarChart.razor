@if (Points is { Count: > 0 })
{
    var maxPrice = Points.Max(p => p.Price);
    var minPrice = Points.Min(p => p.Price);
    var chartWidth = Points.Count * 8;

    <svg class="price-bar-chart" viewBox="@($"0 0 {chartWidth} 100")" preserveAspectRatio="none" role="img">
        @for (var i = 0; i < Points.Count; i++)
        {
            var point = Points[i];
            var height = PriceBarHeight(point.Price, maxPrice);
            var x = i * 8 + 1;
            var y = 100 - height;
            var isCheapest = point.Price == minPrice;
            var isSelected = SelectedPoint is not null && SelectedPoint.Date == point.Date;

            <rect class="@PriceBarClass(isSelected, isCheapest)"
                  x="@x"
                  y="@y"
                  width="6"
                  height="@height"
                  rx="1.5"
                  @onclick="() => OnPointClicked.InvokeAsync(point)">
                <title>@point.Date: @CurrencyFormat.FormatPrice(point.Price, Currency)</title>
            </rect>
        }
    </svg>

    @if (SelectedPoint is not null)
    {
        <div class="flex justify-between items-center mt-2 px-1">
            <span class="text-xs text-slate-500 dark:text-slate-400">@SelectedPoint.Date</span>
            <span class="text-sm font-semibold text-primary">@CurrencyFormat.FormatPrice(SelectedPoint.Price, Currency)</span>
        </div>
    }
}

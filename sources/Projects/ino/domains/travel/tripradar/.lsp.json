{
  "csharp": {
    "command": "dotnet",
    "args": ["tool", "run", "csharp-ls", "--", "--solution", "../../../ino.slnx"],
    "extensionToLanguage": {
      ".cs": "csharp"
    },
    "restartOnCrash": true,
    "maxRestarts": 3
  },
  "typescript": {
    "command": "npx",
    "args": ["--prefix", "src/TripRadar.WebUI", "typescript-language-server", "--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".js": "javascript",
      ".jsx": "javascriptreact"
    },
    "workspaceFolder": "src/TripRadar.WebUI",
    "restartOnCrash": true,
    "maxRestarts": 3
  }
}

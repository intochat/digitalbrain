<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Reqnroll" />
    <PackageReference Include="Reqnroll.xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generate the C# gRPC client from the gateway proto so the rich-flow
         e2e can drive Chat() + RfwEvent() RPCs against the running kernel
         silo without the Flutter UI in the loop. The Gateway.Grpc project
         only generates server stubs; here we ask for client. -->
    <Protobuf Include="..\..\..\src\Ino.Gateway.Grpc\Protos\ino.proto"
              GrpcServices="Client"
              Link="Protos\ino.proto" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ino.Testing.E2E supplies InoBrowserFixture<T> + InoBrowserCollection<T>;
         Ino.AppHost is referenced for Projects.Ino_AppHost which the fixture
         types over to know which AppHost to boot. -->
    <ProjectReference Include="..\..\..\src\Ino.Core\Ino.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Ino.Testing.E2E\Ino.Testing.E2E.csproj" />
    <ProjectReference Include="..\..\..\src\Ino.Testing\Ino.Testing.csproj" />
    <ProjectReference Include="..\..\..\src\Ino.AppHost\Ino.AppHost.csproj" />
    <ProjectReference Include="..\Ino.Domains.Travel\Ino.Domains.Travel.csproj" />
  </ItemGroup>

  <!-- Reqnroll.xunit.v3 3.3.4 generates xUnit3.AssemblyHooks with ValueTask-based
       Xunit.IAsyncLifetime, but the code generator emits Task-based impls.
       We provide a Task-based shadow of IAsyncLifetime in ReqnrollXunitV3Compat.cs
       and supply a replacement assembly fixture here. The autogenerated hooks file
       is removed to avoid the contradictory interface implementation. -->
  <ItemGroup>
    <Compile Remove="obj\**\xUnit3.AssemblyHooks.*.cs" />
  </ItemGroup>

  <Target Name="EnsurePlaywrightBrowsersInstalled" AfterTargets="Build">
    <Exec Command="pwsh -NoProfile -File &quot;$(OutDir)playwright.ps1&quot; install chromium"
          ContinueOnError="WarnAndContinue"
          IgnoreExitCode="true" />
  </Target>

  <!-- Re-exports the Tokyo storyboard from Tokyo.feature into the Flutter
       asset bundle. Uses the StoryboardExporterHooks AfterScenario hook gated
       by INO_EXPORT_STORYBOARDS=1. Run with:
         dotnet build <thisproj> /t:ExportStoryboards
       Outputs to clients/ino.flutter/assets/storyboards/. -->
  <Target Name="ExportStoryboards" DependsOnTargets="Build">
    <Message Importance="high"
             Text="Exporting ino-shell storyboards to Flutter assets..." />
    <Exec Command="dotnet test &quot;$(MSBuildProjectFullPath)&quot; --no-build --nologo --filter &quot;FullyQualifiedName~TokyoPlanDemoStoryboardFeature&quot;"
          EnvironmentVariables="INO_EXPORT_STORYBOARDS=1" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>Ino.Domains.Travel</RootNamespace>
    <AssemblyName>Ino.Domains.Travel</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Server" />
    <InternalsVisibleTo Include="Ino.Domains.Travel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Ino.Core\Ino.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Ino.Core.Hosting\Ino.Core.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\Ino.ServiceDefaults\Ino.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\src\Ino.Llm.Xai\Ino.Llm.Xai.csproj" />
    <ProjectReference Include="..\..\..\src\Ino.Kernel.Contracts\Ino.Kernel.Contracts.csproj" />
    <ProjectReference Include="..\Ino.Domains.Travel.Contracts\Ino.Domains.Travel.Contracts.csproj" />
  </ItemGroup>

  <!-- Gherkin scenarios consumed by BddMockChatClient. Travel is the v0.1 demo
       neuron, so its feature files are the primary fixtures for the mock
       LLM's prompt/response matching and the inspector Reasoning panel. -->
  <ItemGroup>
    <Content Include="Features\**\*.feature">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Features\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Orleans 10.1 — newest stable line; no 11.x prereleases on nuget yet. -->
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Orleans.TestingHost" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Orleans.Persistence.Memory" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Orleans.Reminders" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Orleans.Journaling" Version="10.1.0-alpha.1" />
    <!-- .NET extensions — 11 preview line for Hosting/DI/Logging, 10.5 stable line for AI/Resilience/ServiceDiscovery -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.5.0" />
    <PackageVersion Include="OpenAI" Version="2.10.0" />
    <!-- Testing — xunit.v3 3.2.2 stable, runner 4.0.0-pre.4 (aggressive prerelease) -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0-pre.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0-rc.1" />
    <!-- Reqnroll 3.3.4 — BDD/Gherkin test automation; Reqnroll.xunit.v3 is the xUnit v3-native adapter -->
    <PackageVersion Include="Reqnroll" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.xunit.v3" Version="3.3.4" />
    <!-- Aspire 13.2.4 across the line. Aspire.Hosting.Testing now matches Hosting
         (the prior 13.1.2 pin existed only because 13.2.x transitively required Grpc.Tools
         2.78 prerelease — we now ride prereleases freely). -->
    <PackageVersion Include="Aspire.Hosting" Version="13.2.4" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.2.4" />
    <PackageVersion Include="Aspire.Hosting.Orleans" Version="13.2.4" />
    <!-- OpenTelemetry 1.15.3 — bumped from 1.15.1 to clear GHSA-g94r-2vxg-569j
         (excessive memory allocation in baggage/B3/Jaeger header parsing).
         OpenTelemetry.Api is pinned explicitly so transitive resolution can't
         drag in a vulnerable 1.15.1 from any indirect dependency. -->
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Propagators" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <!-- Instrumentation packages ship on a slower cadence than core OTel:
         AspNetCore 1.15.2 / Http + Runtime 1.15.1 are current. The transitive
         OpenTelemetry.Api dep is force-pinned above to 1.15.3 to clear the CVE. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <!-- Service discovery + HTTP resilience — 10.5 stable line. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.5.0" />
    <!-- Utilities -->
    <PackageVersion Include="YamlDotNet" Version="17.0.1" />
    <PackageVersion Include="Ulid" Version="1.4.1" />
    <PackageVersion Include="Gherkin" Version="39.0.0" />
    <!-- gRPC — 2.80.0-pre1 line (matches Aspire.Hosting 13.2.4 SDK floor) -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.80.0-pre1" />
    <PackageVersion Include="Grpc.AspNetCore.Web" Version="2.80.0-pre1" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.80.0-pre1" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.80.0-pre1" />
    <PackageVersion Include="Grpc.Tools" Version="2.80.0" />
    <!-- Google.Protobuf pinned at last 3.x stable. 4.0.0-rc2 removed MapField<K,V>.MergeFrom
         which the gRPC-generated code in Ino.Gateway.Grpc still calls — bumping past 3.34.1
         requires regenerating against a Grpc.Tools that knows about the new MergeFrom shape. -->
    <PackageVersion Include="Google.Protobuf" Version="3.34.1" />
    <!-- Browser-driven E2E experience tests (Microsoft.Playwright). -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.59.0" />
    <!-- Fluent assertion extension methods for test projects. -->
    <PackageVersion Include="FluentAssertions" Version="8.9.0" />
    <!-- Telegram bot client (clients/Telegram). The bot serves the Flutter
         mini-app from /wwwroot, transcribes voice messages locally via Foundry
         Local Whisper, and forwards transcribed text + plain text to the system
         silo over gRPC. Concentus + NAudio decode Telegram's Opus/Ogg voice
         payloads to the WAV format Whisper expects. -->
    <PackageVersion Include="Telegram.BotAPI" Version="9.6.0" />
    <PackageVersion Include="Concentus" Version="2.2.2" />
    <PackageVersion Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageVersion Include="NAudio" Version="2.3.0" />
    <PackageVersion Include="Microsoft.AI.Foundry.Local" Version="1.0.0" />
    <!-- IAW substrate (iaw/src/*). See `iaw/CLAUDE.md` for the agent runtime
         this carries. Versions are bumped to ino's Aspire 13.2.4 / Orleans 10.1
         line where the iaw-only pins overlapped. -->
    <PackageVersion Include="Microsoft.Orleans.Streaming" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Orleans.BroadcastChannel" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Orleans.Dashboard" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Orleans.DurableJobs" Version="10.1.0-alpha.1" />
    <PackageVersion Include="Microsoft.Orleans.DurableJobs.AzureStorage" Version="10.1.0-alpha.1" />
    <PackageVersion Include="Microsoft.Orleans.Persistence.Cosmos" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Orleans.Clustering.Cosmos" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Orleans.Reminders.Cosmos" Version="10.1.0" />
    <PackageVersion Include="Aspire.Hosting.Qdrant" Version="13.2.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.2.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.CosmosDB" Version="13.2.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.AIFoundry" Version="13.1.3-preview.1.26166.8" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.2.4" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.2.4" />
    <PackageVersion Include="Aspire.Qdrant.Client" Version="13.2.4" />
    <PackageVersion Include="Aspire.Microsoft.Azure.Cosmos" Version="13.2.4" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Ngrok" Version="13.1.2-beta.518" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="13.1.2-beta.518" />
    <PackageVersion Include="CommunityToolkit.Aspire.OllamaSharp" Version="13.1.2-beta.518" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.0.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.0.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.0.0" />
    <PackageVersion Include="Microsoft.Agents.AI.DevUI" Version="1.0.0-preview.260402.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting" Version="1.0.0-preview.260402.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.OpenAI" Version="1.0.0-alpha.260402.1" />
    <PackageVersion Include="ModelContextProtocol" Version="1.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
    <PackageVersion Include="Anthropic" Version="12.11.0" />
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.1.0" />
    <PackageVersion Include="OllamaSharp" Version="5.4.25" />
    <PackageVersion Include="Octokit" Version="14.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" />
    <!-- Roslyn scripting — Phase 4 Slice E.2 (Ino.Domains.Genesis). The
         L1 loop's CreatorNeuron compiles draft script bodies (validation
         only) and RoslynPlan executes the registered body at routing time
         via CSharpScript.RunAsync<NeuronResult>. Scripting.Common +
         Workspaces.Common are transitively required at the same major
         line as CSharp.Workspaces 5.3.0 so the closure stays consistent
         (CentralPackageTransitivePinningEnabled is set on this file). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Scripting.Common" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.3.0" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.28.0-beta.1" />
    <PackageVersion Include="PdfPig" Version="0.1.14" />
    <PackageVersion Include="Qdrant.Client" Version="1.17.0" />
    <PackageVersion Include="ElBruno.LocalEmbeddings" Version="1.1.4" />
    <PackageVersion Include="ElBruno.PersonaPlex" Version="0.6.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.102" />
    <!-- ML.NET — Phase 4 Slice D. NeuronOptimizer trains a LightGBM binary
         classifier per neuron+user from journaled DecisionRecords; high-
         confidence predictions short-circuit the LLM call. 4.0.2 is the
         current stable line. -->
    <PackageVersion Include="Microsoft.ML" Version="4.0.2" />
    <PackageVersion Include="Microsoft.ML.LightGbm" Version="4.0.2" />
  </ItemGroup>
</Project>

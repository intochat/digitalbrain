<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>DigitalBrain.Ino</PackageId>
    <Description>Ino - the AI assistant in DigitalBrain. Agent neuron, InoLang parser/interpreter/runner for .ino software 2.0 authoring and execution, context pipeline, capabilities. Depends on abstractions and kernel contracts.</Description>
    <PackageTags>digitalbrain;ino;ai;assistant;inolang;software2.0</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.1.1-preview.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local dogfood feed for the digitalbraintech split packages (Abstractions, Kernel, Sdk) -->
    <add key="local-digitalbraintech" value="localpkgs" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-digitalbraintech">
      <package pattern="DigitalBrain.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

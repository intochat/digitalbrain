<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>DigitalBrain.Abstractions</PackageId>
    <Description>Core abstractions for DigitalBrain: contracts for neurons, synapses, bundles, brains and distribution. Thin layer for core/kernel/ino/sdk separation.</Description>
    <PackageTags>digitalbrain;orleans;neurons;synapses;abstractions</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.1.1-preview.1" />
    <PackageReference Include="Microsoft.Orleans.Core.Abstractions" Version="10.1.1-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DigitalBrain.Core\DigitalBrain.Core.csproj" />
  </ItemGroup>

</Project>

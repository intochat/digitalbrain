<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>DigitalBrain.Kernel</PackageId>
    <Description>DigitalBrain kernel: silo runtime, clustering, distribution, bundle installation, durable tasks. Depends on abstractions. Open source core with Orleans integration.</Description>
    <PackageTags>digitalbrain;orleans;kernel;clustering;distribution</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.1.1-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\DigitalBrain.Abstractions\DigitalBrain.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>

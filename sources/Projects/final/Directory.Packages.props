<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Always latest per rules. Update frequently. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire (latest verified via package search + dnx dotnet-inspect)
         For single-file AppHost (ino.cs + `dotnet run ino.cs`):
         - Central PackageVersion here for CPM (ManagePackageVersionsCentrally=true).
         - ino.cs uses bare #:package Aspire.Hosting.AppHost (no @ver) so the temp ino.cs.csproj
           generated by Aspire.AppHost.Sdk does not emit Version= on the PackageReference (avoids NU1008).
         - #:sdk keeps its preview pin (matches src/DigitalBrain.AppHost/DigitalBrain.AppHost.csproj).
         - Projects (AppHost, Sdk) ref without Version (CPM supplies).
         See ino.cs and src/DigitalBrain.AppHost/DigitalBrain.AppHost.csproj. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.3" />
    <PackageVersion Include="Aspire.Hosting.Orleans" Version="13.4.3" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.4.3" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.4.3" />
    <!-- For ino E2E port (NeuronE2ETest + Playwright/gRPC surfaces stub per 01/02/03/09/review); latest matching Aspire 13.x. -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.3" />
    <!-- Playwright for full ino E2E browser automation over generated UI surfaces (Flutter web or hex1b rendered) + gRPC transport tests. Latest 1.60.0 per nuget 2026. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.60.0" />
    <!-- For coordination projects like the Flutter client (named Flutter.proj to match v1). Latest for NoTargets. -->
    <PackageVersion Include="Microsoft.Build.NoTargets" Version="3.7.0" />
    <!-- gRPC for real UiSurface/surfaces transport (kernel service stream + client consume per review prod blocker #3, E2E harness "kernel gRPC UiSurface streaming service", 09 "gRPC in ino style or streams" for terminals/Flutter, 01 matrix, ino/terminals/TUI/2c priority). Latest stable matching Aspire 13 / .NET 11 era (Grpc.AspNetCore for server, Grpc.Net.ClientFactory for Aspire discovery clients). Small slice: pkgs + seam notes only (no full .proto/impl this turn). --> 
    <PackageVersion Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageVersion Include="Grpc.AspNetCore.Web" Version="2.80.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.80.0" />
    <PackageVersion Include="Grpc.Net.Client.Web" Version="2.80.0" />
    <!-- Grpc.Tools for proto generation in kernel (for Surfaces.proto server streaming). Matched to Grpc.AspNetCore version for compatibility (central for CPM; bumped to satisfy Aspire.Hosting.AppHost transitive >=2.80 from Sdk ref). Latest per ecosystem. --> 
    <PackageVersion Include="Grpc.Tools" Version="2.81.1" />
    <PackageVersion Include="Google.Protobuf" Version="3.34.1" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0-preview.5.26302.115" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <!-- Orleans 10.2.0 official release onboarded from https://github.com/dotnet/orleans/releases/tag/v10.2.0.
         Microsoft.Orleans.Journaling has no 10.2.0 NuGet package under this id, so the custom IDurableList<Synapse>
         journal adapter keeps the alpha package while the supported runtime/provider/dashboard packages move to 10.2.0.
         These provide the durable causal history/replay on grain re-activation for AI (LlmAgent, Memory, Creator, full brain journal). 
         Self-explanatory package names + this comment document the mandate. Do not replace the journaling adapter without new user direction. -->
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.2.0" />
    <PackageVersion Include="Microsoft.Orleans.Client" Version="10.2.0" />
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.2.0" />
    <PackageVersion Include="Microsoft.Orleans.Streaming" Version="10.2.0" />
    <PackageVersion Include="Microsoft.Orleans.Core.Abstractions" Version="10.2.0" />
    <PackageVersion Include="Microsoft.Orleans.Clustering.Redis" Version="10.2.0" />
    <PackageVersion Include="Microsoft.Orleans.Persistence.Redis" Version="10.2.0" />
    <PackageVersion Include="Microsoft.Orleans.TestingHost" Version="10.2.0" />
    <PackageVersion Include="Microsoft.Orleans.Journaling" Version="10.1.1-preview.1.alpha.1" />
    <!-- For real durable reminders/scheduling in KernelTaskSupervisor plus Redis reminder durability on root worlds. -->
    <PackageVersion Include="Microsoft.Orleans.Reminders" Version="10.2.0" />
    <PackageVersion Include="Microsoft.Orleans.Reminders.Redis" Version="10.2.0" />
    <!-- mTLS complete: gateway + silo TLS using the package (dev LAN AllowAny + prod cert notes). -->
    <PackageVersion Include="Microsoft.Orleans.Connections.Security" Version="10.2.0" />
    <!-- Orleans 10.2 Dashboard provides the lifecycle dependency graph and live runtime counters at /orleans-dashboard. -->
    <PackageVersion Include="Microsoft.Orleans.Dashboard" Version="10.2.0" />
    <!-- Custom Orleans.Journaling alpha for DurableNeuron + IDurableList<Synapse> (Incoming/Outgoing journals for causal AI history/replay on re-activate). -->
    <!-- Testing / BDD (MTP + xUnit v3 + Reqnroll for net11 dotnet test from root) -->
    <PackageVersion Include="Reqnroll" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.xunit.v3" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.Tools.MsBuild.Generation" Version="3.3.4" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- Imposter for fast mocks in simulations (0.1.9) -->
    <PackageVersion Include="Imposter" Version="0.1.9" />
    <!-- C# / runtime (latest .NET 11 preview per SDK) -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0-preview.5.26302.115" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0-preview.4.26230.115" />
    <!-- For AddKeyedSingleton in test Simulation (in-mem durable for Journaling switch); version common for .NET 8+ DI, compatible with the graph. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <!-- For unions / preview features if needed explicit -->
    <!-- AI (latest per official Microsoft.Extensions.AI docs + nuget 2026-06; IChatClient as ILLM, UseOpenTelemetry for neuron telemetry, UseFunctionInvocation) -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Ollama" Version="9.7.0-preview.1.25356.2" />
    <!-- For extremely clean Aspire Ollama + model hosting (Gemma 26b/27b + Nemotron), matching IAW/ino/v1-v2 patterns. Latest matching Aspire 13.x era. -->
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="13.4.0" />
    <!-- MCP for digitalbrain-mcp Aspire resource (http transport server exposing brain/marketplace/history/restart tools to external agents like Claude Code / Copilot). Latest 1.4.0 verified via nuget.org search + learn.microsoft.com / csharp.sdk.modelcontextprotocol.io patterns (AddMcpServer/WithHttpTransport/WithTools<T>/MapMcp + stateless). Matches IAW/ino/v1 usage but pinned latest per central policy. --> 
    <PackageVersion Include="ModelContextProtocol" Version="1.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <!-- System.Collections.Immutable (provides System.Collections.Frozen for perf caches per doc08; version exact latest from official learn.microsoft.com web_fetch for FrozenDictionary in net-11.0-pp preview, matches global.json sdk 11.0.100-preview.4.26230.115) -->
    <PackageVersion Include="System.Collections.Immutable" Version="11.0.0-preview.4.26230.115" />
    <!-- Roslyn for source generators (latest per web_search/nuget for Microsoft.CodeAnalysis.CSharp 5.3.0; used for incremental source gen per doc08 for dispatch manifest; analyzers version matched to avoid downgrade with CSharp 5.3.0 transitive) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
    <!-- Microsoft.CodeAnalysis.Workspaces.Common 5.0.0 (with old Analyzers 3.11 + Humanizer) is pulled by the retained Orleans.Journaling alpha/analyzer chain. Pin latest 5.3.0 centrally per 'always use latest versions of nuget packages' rule. NU1608 expected on exact [5.0.0] dep from Orleans analyzer; our direct CSharp 5.3 (CreatorNeuron Roslyn codegen + SourceGen) + this pin ensures latest for intentional usage. Analyzer bits are build-time. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.3.0" />
    <!-- Hex1b for real interactive TUI console client (task manager etc). Latest per search (0.164+). Used in Clients.Console for hex1b task mgr from start per req. -->
    <PackageVersion Include="Hex1b" Version="0.165.0-alpha.1337.1.4f44be7" />
    <!-- Whisper.net 1.9.1 for local speech-to-text (voice recorder in flutter -> backend transcription). Verified latest via nuget.org search 2026 + github.com/sandrohanea/whisper.net examples (WhisperFactory.FromPath, CreateProcessor, ProcessAsync on audio bytes/stream, GGML models). Used with small ggml-base for CPU local like gemma/Ollama. Runtime package for native libs. -->
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0-beta.98" />
    <!-- MessagePack: bumped to latest (3.1.7 per dnx dotnet-inspect) to address high-severity vuln in 2.5.192
         (seen as NU1903 warning in Sdk, Kernel, AppHost, Clients, Core.Tests, simulation). CPM central pin
         overrides transitive pulls from Orleans etc. Always use latest per rules. -->
    <PackageVersion Include="MessagePack" Version="3.1.7" />
    <!-- YamlDotNet 18.0.0 (latest per Context7 dnx dotnet-inspect on 2026-06-15) for os-on-yaml schema parsing.
         Added after exhaustive Context7 lookup of DeserializerBuilder, IDeserializer.Deserialize<string>, WithCaseInsensitivePropertyMatching etc.
         Used for Y2+ per OS-ON-YAML-SPEC.md and PLAN. Central management for latest. -->
    <PackageVersion Include="YamlDotNet" Version="18.0.0" />
  </ItemGroup>
</Project>

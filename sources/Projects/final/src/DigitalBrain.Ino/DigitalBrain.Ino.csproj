<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <!-- Suppress experimental for IDurableList etc from Orleans.Journaling alpha; brought back per user request for custom Durable. Matching Kernel. -->
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
    <!-- Suppress CS0436 for Orleans codegen duplicate invokable types (shared IHandle<T> across Kernel + Awesome + tests + now Ino) -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- PackPropsForInoPerT2: IsPackable + PackageId + Generate=false per T2 of polyrepo-decomp plan + vision §4 (ino the assistant bundles on SDK after connectors extraction start). Dot-notation DigitalBrain.Ino. Descriptions match "ino (the assistant...)". Central only, bare refs unchanged. -->
    <IsPackable>true</IsPackable>
    <PackageId>DigitalBrain.Ino</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Version aspirational (review apply pack verify in run-ci exercises the full props for polyrepo DAG readiness). Update on real publish; central CPM for dep versions only. -->
    <Version>0.1.0-preview</Version>
    <Description>ino (the assistant + context/memory/nav tools; bundles on the SDK per vision §4). OSS.</Description>
    <PackageTags>orleans;digitalbrain;ino;assistant;navigation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Core.Abstractions" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <!-- Microsoft.Extensions.AI* for Llm base + 20+ navigation tools (AIFunctionFactory, IChatClient, UseFunctionInvocation, ChatOptions etc). Latest via central Directory.Packages.props only (no Version attr here). -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <!-- Force MessagePack 3.1.7 central (latest) to kill transitive high-sev from lower layers. -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.Extensions.AI.Ollama" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigitalBrain.Hosting\DigitalBrain.Hosting.csproj" />
    <!-- F T2 follow-up (per code-quality review + findings): Awesome ref for review_project tool only; kept for now (polyrepo extraction + ino-as-independent-SDK-boundary moved to separate PR per Elon split). Honest-gates/source-gen/parser/HasRules first. No behavior leak. -->
    <ProjectReference Include="..\DigitalBrain.Awesome\DigitalBrain.Awesome.csproj" />
    <!-- Source generator for dispatch manifest + full constellation catalog (IHandle/IEmit + unions) must reach the moved grains/tools. Analyzer ref (no runtime assembly). Matches pattern in Kernel/Sdk. -->
    <ProjectReference Include="..\DigitalBrain.SourceGen\DigitalBrain.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

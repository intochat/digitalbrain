<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
    <AssemblyName>DigitalBrain.Hosting</AssemblyName>
    <RootNamespace>DigitalBrain.Hosting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Core.Abstractions" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <!-- For launcher real AspireHosted path (IClusterClient construction to launched gateway, ClusterOptions, static connect). Latest via Directory.Packages.props central. -->
    <PackageReference Include="Microsoft.Orleans.Client" />
    <!-- For the Microsoft.Aspire boundary (real DistributedApplication + ResourceCommandService control from IAspire neuron).
         Version from central Directory.Packages.props (always latest). -->
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <!-- For AddDefaultDigitalBrainTopology (shared by AppHost + ino.cs single-file): Redis durability resource + Ollama + models. Latest central. -->
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" />
    <!-- Force central MessagePack 3.1.7 latest to squash transitive vuln warnings from Orleans pulls. -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigitalBrain.Os\DigitalBrain.Os.csproj" />
    <ProjectReference Include="..\DigitalBrain.Protocol\DigitalBrain.Protocol.csproj" />
    <!-- Brings in ConfigureDigitalBrainClientDefaults (and the shared silo defaults) so launcher client builders can register the DigitalBrainTimeline stream provider. -->
    <ProjectReference Include="..\DigitalBrain.Aspire.Hosting\DigitalBrain.Aspire.Hosting.csproj" />
    <ProjectReference Include="..\DigitalBrain.SourceGen\DigitalBrain.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- gRPC client for Surfaces.proto so fire-demo / mcp can deliver ClientTap over the same gRPC path the Flutter browser uses (bypasses orleans gw discovery issues). -->
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.Client.Web" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" />
    <Protobuf Include="..\DigitalBrain.Kernel\Protos\Surfaces.proto" GrpcServices="Client" />
  </ItemGroup>
</Project>
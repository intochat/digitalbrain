<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>DigitalBrain.Sdk</AssemblyName>
    <RootNamespace>DigitalBrain.Sdk</RootNamespace>
    <!-- Suppress experimental for IDurableList etc from Orleans.Journaling alpha (connectors like GoogleAuth/Gmail use GrainFactory + journals compat); matching Ino/Kernel. -->
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
    <!-- Suppress CS0436 for Orleans codegen duplicate invokable types (shared IHandle<T> across Kernel + Awesome + Ino + Sdk + tests) -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- IsPackable + PackageId per polyrepo decomp plan + vision §4 DAG (sdk layer; extracted Google/fs/gmail connectors). Central CPM for versions (bare refs only). -->
    <IsPackable>true</IsPackable>
    <PackageId>DigitalBrain.Sdk</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Version aspirational (review apply pack verify in run-ci exercises the full props for polyrepo DAG readiness). Update on real publish; central CPM for dep versions only. -->
    <Version>0.1.0-preview</Version>
    <Description>DigitalBrain SDK — app-author neuron surface (fs/http/google/oauth/gmail connector neurons; IHandle/IEmit authoring base). OSS.</Description>
    <PackageTags>orleans;digitalbrain;sdk;connectors;google;auth;fs;gmail;filesystem</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Core.Abstractions" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <!-- Additional Orleans for any streaming/client patterns in sdk if activated; bare central only (latest per rules + Directory.Packages.props). No versions in this csproj. -->
    <PackageReference Include="Microsoft.Orleans.Streaming" />
    <!-- Force central MessagePack latest to suppress 2.5.192 vuln warnings. -->
    <PackageReference Include="MessagePack" />
    <!-- IHttpClientFactory for connector neurons (Telegram, Gmail DI seam). Direct dep replacing transitive from the dropped Hosting ref. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core for contracts (INeuron, IHandle<T>, Synapse events like SaveFileRequest, Google*); bare ProjectRef. -->
    <ProjectReference Include="..\DigitalBrain.Os\DigitalBrain.Os.csproj" />
    <!-- SourceGen analyzer (OutputItemType Analyzer, no runtime assembly) so IHandle/IEmit dispatch manifest + fast invokers reach the sdk grains (GoogleAuthConnectorNeuron, GmailConnector, FileSystemConnectorGrain). Matches Ino + Kernel pattern exactly. -->
    <ProjectReference Include="..\DigitalBrain.SourceGen\DigitalBrain.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

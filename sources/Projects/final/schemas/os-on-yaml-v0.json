{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrain.dev/schemas/os-on-yaml-v0.json",
  "title": "os-on-yaml/v0",
  "description": "JSON Schema for the os-on-yaml v0 vocabulary (Schema: Neuron + synapses + structured rules/UI + boot manifests). See docs/OS-ON-YAML-SPEC.md for the full grammar, canonical form, and mapping to InoExperience / BootManifest / RuleSet. This schema makes the schemaVersion a real, toolable artifact (IDE completion, LLM structured outputs, yaml-language-server, author-time validation, Creator forms). Append-only: v1+ will extend without breaking v0 documents.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference for editors (yaml-language-server etc)."
    },
    "schemaVersion": {
      "type": "string",
      "const": "os-on-yaml/v0",
      "description": "Required vocabulary marker. Must be exactly os-on-yaml/v0 for this version."
    },
    "neuron": {
      "description": "Schema:Neuron declaration for an experience capsule (maps to InoExperience + contract + rules). Use this OR boot at top level.",
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "grainType": { "type": "string", "description": "For future L0 schema-driven grains (informational in v0)." },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
        "desc": { "type": "string" },
        "handles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["synapse"],
            "properties": {
              "synapse": { "type": "string" },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type"],
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string" },
                    "required": { "type": "boolean", "default": false }
                  }
                }
              }
            }
          }
        },
        "emits": {
          "type": "array",
          "items": { "type": "string" }
        },
        "region": { "type": "string" },
        "pinned": { "type": "boolean", "default": false },
        "order": { "type": "integer", "default": 0 },
        "requires": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requiresGrant": {
          "type": "array",
          "items": { "type": "string" }
        },
        "observedSynapses": { "type": "integer", "default": 0 },
        "isSystem": { "type": "boolean", "default": false },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["on"],
            "properties": {
              "on": { "type": "string" },
              "as": { "type": "string" },
              "do": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "emit": {
                      "type": "object",
                      "required": ["type"],
                      "properties": {
                        "type": { "type": "string" },
                        "args": {
                          "type": "object",
                          "additionalProperties": { "type": "string" }
                        }
                      }
                    },
                    "show": {
                      "type": "object",
                      "properties": {
                        "card": {
                          "type": "object",
                          "properties": {
                            "title": { "type": "string" },
                            "content": { "$ref": "#/properties/neuron/properties/rules/items/properties/do/items/properties/show/properties/card/properties/content" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "synapses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type"],
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string" },
                    "required": { "type": "boolean", "default": false }
                  }
                }
              }
            }
          }
        },
        "escalate": { "type": "string", "description": "Optional D-escape marker (e.g. 'codegen FooNeuron'). Produces YIN005 warning." }
      }
    },
    "boot": {
      "description": "Boot manifest (brain.yaml). Alternative to neuron at top level.",
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "llms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["model", "tier"],
            "properties": {
              "model": { "type": "string" },
              "tier": { "type": "string", "enum": ["fast", "balanced", "reasoning"] }
            }
          }
        },
        "voice": { "type": "string" },
        "durability": { "type": "string" },
        "ui": { "type": "string" },
        "discovery": { "type": "boolean", "default": false },
        "advertisedIpEnv": { "type": "string" },
        "seeds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "worlds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "from"],
            "properties": {
              "name": { "type": "string" },
              "from": { "type": "string" }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "description": "Optional replay/evidence scenarios (Gherkin-like). Not executed by kernel but used by SimulationCatalog + tests.",
      "items": {
        "type": "object",
        "required": ["name", "when", "then"],
        "properties": {
          "name": { "type": "string" },
          "when": {
            "type": "object",
            "properties": {
              "emit": { "type": "string" },
              "args": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          },
          "then": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "broadcast": { "type": "string" },
                "with": { "type": "object", "additionalProperties": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    { "required": ["neuron"] },
    { "required": ["boot"] }
  ],
  "additionalProperties": true
}
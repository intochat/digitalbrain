  </Folder>
  <Folder Name="/tests/">
    <Project Path="DigitalBrain.Context.Tests/DigitalBrain.Context.Tests.csproj" />
    <Project Path="DigitalBrain.Experience.PersonalAssistant.Tests/DigitalBrain.Experience.PersonalAssistant.Tests.csproj" />
    <Project Path="DigitalBrain.Google.Tests/DigitalBrain.Google.Tests.csproj" />
    <Project Path="DigitalBrain.Salesforce.Tests/DigitalBrain.Salesforce.Tests.csproj" />
    <Project Path="DigitalBrain.Telegram.Tests/DigitalBrain.Telegram.Tests.csproj" />
    <Project Path="DigitalBrain.TestKit/DigitalBrain.TestKit.csproj" />

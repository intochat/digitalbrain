    <Project Path="DigitalBrain.Marketplace.Contracts/DigitalBrain.Marketplace.Contracts.csproj" />
    <Project Path="DigitalBrain.Mcp/DigitalBrain.Mcp.csproj" />
    <Project Path="DigitalBrain.Pack.Contracts/DigitalBrain.Pack.Contracts.csproj" />
    <Project Path="DigitalBrain.SeedPacks/DigitalBrain.SeedPacks.csproj" />
    <Project Path="DigitalBrain.Ui.Contracts/DigitalBrain.Ui.Contracts.csproj" />
    <Project Path="DigitalBrain.Ui.Runtime/DigitalBrain.Ui.Runtime.csproj" />
  </Folder>
  <Folder Name="/integrations/">
    <Project Path="DigitalBrain.Context/DigitalBrain.Context.csproj" />
    <Project Path="DigitalBrain.Experience.PersonalAssistant/DigitalBrain.Experience.PersonalAssistant.csproj" />
    <Project Path="DigitalBrain.Google/DigitalBrain.Google.csproj" />
    <Project Path="DigitalBrain.Ino/DigitalBrain.Ino.csproj" />
    <Project Path="DigitalBrain.Salesforce/DigitalBrain.Salesforce.csproj" />

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Azure": "Warning",
      "Azure.Core": "Warning",
      "Azure.Data": "Warning",
      "Azure.Storage": "Warning",
      "Microsoft.Azure": "Warning",
      "System.Net.Http": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Orleans": "Warning",
      "Microsoft.Orleans": "Warning",
      "Microsoft.Extensions.Http": "Warning",
      "Microsoft.AspNetCore.Hosting": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning"
    }
  },
  "DigitalBrain": {
    "Marketplace": {
      "RejectUnsignedPacks": true
    }
  },
  "Aspire": {
    "Azure": {
      "Data": {
        "Tables": {
          "DisableTracing": true
        }
      },
      "Storage": {
        "Blobs": {
          "DisableTracing": true
        }
      }
    }
  }
}

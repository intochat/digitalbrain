<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA2007;CA1812</NoWarn>
    <!-- Host pin for Foundry Local native assets on Windows desktop runs only. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <!-- SDK container publish (release workflow → Docker Hub), same pattern as v0.1.18.
         Do NOT set ContainerRuntimeIdentifier/RuntimeIdentifiers here — on Linux CI that
         forces net11.0/linux-x64 assets during plain `dotnet build` and breaks AI/tests. -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>digitalbrain-kernel</ContainerRepository>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:11.0-preview</ContainerBaseImage>
  </PropertyGroup>
  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
    <!-- Production module set matching AppHost AddModule declarations (overridable at run). -->
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__0" Value="DigitalBrain.AI.AIModule, DigitalBrain.Modules.AI" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__1" Value="DigitalBrain.Memory.MemoryModule, DigitalBrain.Modules.Memory" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__2" Value="DigitalBrain.Time.TimeModule, DigitalBrain.Modules.Time" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__3" Value="DigitalBrain.Execution.ExecutionModule, DigitalBrain.Modules.Execution" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__4" Value="DigitalBrain.Integrations.IntegrationsModule, DigitalBrain.Modules.Integrations" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__5" Value="DigitalBrain.SmartPrompt.SmartPromptModule, DigitalBrain.Modules.SmartPrompt" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__6" Value="DigitalBrain.UI.UIModule, DigitalBrain.Modules.UI" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!-- Native Foundry assets for the host process; STT code lives in AI module. -->
    <PackageReference Include="Microsoft.AI.Foundry.Local" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Modules/AI/AI/DigitalBrain.Modules.AI.csproj" />
    <ProjectReference Include="../../Modules/UI/DigitalBrain.Modules.UI/DigitalBrain.Modules.UI.csproj" />
    <ProjectReference Include="../../Modules/Time/Time/DigitalBrain.Modules.Time.csproj" />
    <ProjectReference Include="../../Modules/Memory/Memory/DigitalBrain.Modules.Memory.csproj" />
    <ProjectReference Include="../../Modules/Execution/Execution/DigitalBrain.Modules.Execution.csproj" />
    <ProjectReference Include="../../Modules/Integrations/DigitalBrain.Modules.Integrations.csproj" />
    <ProjectReference Include="../../Modules/SmartPrompt/SmartPrompt/DigitalBrain.Modules.SmartPrompt.csproj" />
    <ProjectReference Include="../../Aspire/DigitalBrain.Aspire/DigitalBrain.Aspire.csproj" />
    <ProjectReference Include="../DigitalBrain.Core/DigitalBrain.Core.csproj" />
    <ProjectReference Include="../DigitalBrain.Client/DigitalBrain.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DigitalBrain.E2E.Tests" />
  </ItemGroup>
</Project>

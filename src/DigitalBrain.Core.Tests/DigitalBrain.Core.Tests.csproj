<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- CA1062: null-check ceremony inside module handlers contradicts the zero-ceremony
         module surface the flows ratify (Core never delivers a null fact); CA1515: module
         neuron classes are hosted grains and must stay public. -->
    <NoWarn>$(NoWarn);ORLEANSEXP005;CA2007;CA1515;CA1062</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Park only concurrent WIP that is not part of the S01/S03/S04 acceptance proofs. -->
    <Compile Remove="NeuronConcurrencyTests.cs" />
    <Compile Remove="_wip_park\**" />
    <None Include="_wip_park\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DigitalBrain.Core\DigitalBrain.Core.csproj" />
    <ProjectReference Include="..\DigitalBrain.Mocks\DigitalBrain.Mocks.csproj" />
    <ProjectReference Include="..\DigitalBrain.Testing\DigitalBrain.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Journaling" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>

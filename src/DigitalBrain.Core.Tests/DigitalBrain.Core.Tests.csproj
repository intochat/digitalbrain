<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- CA1062: null-check ceremony inside behavior handlers contradicts the concise
         facade (Hosting never delivers a null synapse); CA1515: test behavior types are
         public so composition can discover and construct them. -->
    <NoWarn>$(NoWarn);ORLEANSEXP005;CA2007;CA1515;CA1062</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DigitalBrain.Core\DigitalBrain.Core.csproj" />
    <ProjectReference Include="..\DigitalBrain.Hosting\DigitalBrain.Hosting.csproj" />
    <ProjectReference Include="..\DigitalBrain.Testing\DigitalBrain.Testing.csproj" />
    <ProjectReference Include="..\DigitalBrain.Testing.Mechanics\DigitalBrain.Testing.Mechanics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>

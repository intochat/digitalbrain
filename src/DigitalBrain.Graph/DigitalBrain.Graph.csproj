<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>DigitalBrain.Graph</RootNamespace>
    <PackageId>DigitalBrain.Graph</PackageId>
    <Description>The brain as one graph: neurons, apps, contracts, signals, grants and memory, derived from existing state, with analysis and grouping.</Description>
    <PackageReadmeFile Condition="Exists('README.md')">README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DigitalBrain/DigitalBrain.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" Condition="Exists('README.md')" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DigitalBrain.Graph.Tests.Unit" />
  </ItemGroup>
</Project>

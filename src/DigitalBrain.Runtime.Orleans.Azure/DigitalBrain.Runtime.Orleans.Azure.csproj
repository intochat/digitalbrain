<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>DigitalBrain.Runtime.Orleans.Azure</RootNamespace>
    <PackageId>DigitalBrain.Runtime.Orleans.Azure</PackageId>
    <Description>Cloud topology for DigitalBrain on Azure: Table clustering and reminders, Blob grain storage, Queue streams, Key Vault secrets and blob-lease brain ownership.</Description>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DigitalBrain.Runtime.Orleans/DigitalBrain.Runtime.Orleans.csproj" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AzureStorage" />
    <PackageReference Include="Microsoft.Orleans.Persistence.AzureStorage" />
    <PackageReference Include="Microsoft.Orleans.Reminders.AzureStorage" />
    <PackageReference Include="Microsoft.Orleans.Streaming.AzureStorage" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Storage.Queues" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DigitalBrain.Runtime.Orleans.Azure.Tests.Integration" />
  </ItemGroup>
</Project>

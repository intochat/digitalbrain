<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>DigitalBrain.Runtime.Orleans</RootNamespace>
    <PackageId>DigitalBrain.Runtime.Orleans</PackageId>
    <Description>Orleans runtime for DigitalBrain: topology, storage, reminders, hosting.</Description>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DigitalBrain/DigitalBrain.csproj" />
    <ProjectReference Include="../DigitalBrain.Capabilities.Storage/DigitalBrain.Capabilities.Storage.csproj" />
    <ProjectReference Include="../DigitalBrain.Capabilities.Secrets/DigitalBrain.Capabilities.Secrets.csproj" />
    <ProjectReference Include="../DigitalBrain.Capabilities.Identity/DigitalBrain.Capabilities.Identity.csproj" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Orleans.Streaming" />
    <PackageReference Include="Microsoft.Orleans.Reminders" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DigitalBrain.Runtime.Orleans.Tests.Unit" />
    <InternalsVisibleTo Include="DigitalBrain.Runtime.Orleans.Tests.Integration" />
    <!-- 04-15: the framework e2e reaches RuntimeTestHooks; the hooks stay internal so no production host can call them. -->
    <InternalsVisibleTo Include="DigitalBrain.Framework.Tests.E2E" />
    <InternalsVisibleTo Include="IntoChat.OS.Kernel.Composition" />
    <InternalsVisibleTo Include="IntoChat.OS.Kernel.Tests.Integration" />
    <InternalsVisibleTo Include="IntoChat.OS.Kernel.Composition.Tests.Integration" />
  </ItemGroup>
</Project>

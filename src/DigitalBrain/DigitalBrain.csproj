<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <Description>Consumer metapackage: Abstractions + Client + Aspire. Kernel stays silo-side and is not pulled into pure clients.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="_._" Pack="true" PackagePath="lib\$(TargetFramework)\_._" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DigitalBrain.Abstractions\DigitalBrain.Abstractions.csproj" />
    <ProjectReference Include="..\DigitalBrain.Client\DigitalBrain.Client.csproj" />
    <ProjectReference Include="..\DigitalBrain.Aspire\DigitalBrain.Aspire.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Aspire.AppHost.Sdk/13.5.2">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <IsPackable>false</IsPackable>
    <UserSecretsId>digitalbrain-os-apphost-7c3e9a2f-4b81-4d6e-9f0a-1e5c8b2d6a44</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Modules/AI/Aspire.Hosting/DigitalBrain.Modules.AI.Aspire.Hosting.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../Modules/UI/DigitalBrain.Modules.UI.Aspire.Hosting/DigitalBrain.Modules.UI.Aspire.Hosting.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../Modules/Memory/Aspire.Hosting/DigitalBrain.Modules.Memory.Aspire.Hosting.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../Modules/Time/Time/DigitalBrain.Modules.Time.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../Modules/Execution/Execution/DigitalBrain.Modules.Execution.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../Modules/Integrations/DigitalBrain.Modules.Integrations.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../Modules/SmartPrompt/SmartPrompt/DigitalBrain.Modules.SmartPrompt.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../DigitalBrain.Aspire.Hosting/DigitalBrain.Aspire.Hosting.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../Kernel/DigitalBrain.Kernel/DigitalBrain.Kernel.csproj" />
    <ProjectReference Include="../../Kernel/DigitalBrain.Mcp/DigitalBrain.Mcp.csproj" />
    <ProjectReference Include="../../Testing/DigitalBrain.Integrations.Fakes/DigitalBrain.Integrations.Fakes.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <CodeGraphRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..'))</CodeGraphRoot>
  </PropertyGroup>
  <Target Name="RefreshCodeGraph" BeforeTargets="Build">
    <PropertyGroup>
      <CodeGraphIndexed>$([System.IO.File]::Exists('$(CodeGraphRoot)\.codegraph\codegraph.db'))</CodeGraphIndexed>
    </PropertyGroup>
    <Exec Command="npx -y @colbymchenry/codegraph@latest init &quot;$(CodeGraphRoot)&quot;" WorkingDirectory="$(CodeGraphRoot)" Condition="'$(CodeGraphIndexed)' != 'True'" />
    <Exec Command="npx -y @colbymchenry/codegraph@latest sync &quot;$(CodeGraphRoot)&quot;" WorkingDirectory="$(CodeGraphRoot)" Condition="'$(CodeGraphIndexed)' == 'True'" />
  </Target>
</Project>

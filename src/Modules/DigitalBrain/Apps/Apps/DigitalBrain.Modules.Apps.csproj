<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>App manifests, install, versions and Save as app.</Description>
    <RootNamespace>DigitalBrain.Apps</RootNamespace>
    <!-- Packages are vouched for by the Coding check, whose Roslyn loader carries Microsoft.Build.Framework. -->
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DigitalBrain.Modules.Apps.Tests.Unit" />
    <ProjectReference Include="../Contracts/DigitalBrain.Modules.Apps.Contracts.csproj" />
    <ProjectReference Include="../../../Discovery/Contracts/DigitalBrain.Modules.Discovery.Contracts.csproj" />
    <ProjectReference Include="../../Kernel/Kernel/DigitalBrain.csproj" />
    <ProjectReference Include="../../../Coding/Coding/DigitalBrain.Modules.Coding.csproj" />
    <ProjectReference Include="../../Behaviors/Contracts/DigitalBrain.Modules.Behavior.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../../Apps/files/app.json" LogicalName="DigitalBrain.Apps.FirstParty.files.app.json" />
    <EmbeddedResource Include="../../../../Apps/forms/app.json" LogicalName="DigitalBrain.Apps.FirstParty.forms.app.json" />
    <EmbeddedResource Include="../../../../Apps/image-editor/app.json" LogicalName="DigitalBrain.Apps.FirstParty.image-editor.app.json" />
    <EmbeddedResource Include="../../../../Apps/customer-tables/app.json" LogicalName="DigitalBrain.Apps.FirstParty.customer-tables.app.json" />
    <EmbeddedResource Include="../../../../Apps/leadgenerator/app.json" LogicalName="DigitalBrain.Apps.FirstParty.leadgenerator.app.json" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Connects single-file C# apps to a DigitalBrain cluster: neuron calls and live signal subscriptions.</Description>
    <RootNamespace>DigitalBrain.Client</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DigitalBrain.Kernel" />
    <InternalsVisibleTo Include="DigitalBrain.Platform" />
    <InternalsVisibleTo Include="DigitalBrain.Testing" />
    <InternalsVisibleTo Include="DigitalBrain.Testing.Unit" />
    <InternalsVisibleTo Include="DigitalBrain.Testing.E2E" />
    <!-- The script edge speaks the same protocol records as the client. -->
    <InternalsVisibleTo Include="DigitalBrain.Modules.Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Orleans.Client" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../DigitalBrain.Contracts/DigitalBrain.Contracts.csproj" /></ItemGroup>
</Project>

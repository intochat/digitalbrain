<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Flutter module integration for the neuron kernel.</Description>
    <RootNamespace>DigitalBrain.Flutter</RootNamespace>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Activities/**" />
    <Compile Remove="Chart/**" />
    <Compile Remove="Chat/**" />
    <Compile Remove="Graph/**" />
    <Compile Remove="Image/**" />
    <Compile Remove="Surface/**" />
    <Compile Remove="Table/**" />
    <Compile Remove="Ui/**" />
    <Compile Remove="Workspaces/**" />
    <Compile Remove="BoundedList.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Contracts/DigitalBrain.Modules.Flutter.Contracts.csproj" />
    <ProjectReference Include="../../DigitalBrain/DigitalBrain/DigitalBrain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DigitalBrain.Modules.ClickHouse" />
    <InternalsVisibleTo Include="DigitalBrain.Modules.Supabase" />
  </ItemGroup>
</Project>

# Production sandbox: sessions have no repository mount, so the brain client and every module's
# contracts are baked in at /brain and built once, leaving scripts only their own compile.
# Build from the repository root:
#   docker build -f src/Modules/Microsoft/CSharp/DigitalBrain.Modules.Microsoft.CSharp.Sandbox/Dockerfile.production -t <registry>/csharp-sandbox:<tag> .
FROM mcr.microsoft.com/dotnet/sdk:11.0.100-rc.1 AS host
WORKDIR /src
COPY src/Modules/Microsoft/CSharp/DigitalBrain.Modules.Microsoft.CSharp.Sandbox/ .
RUN dotnet publish DigitalBrain.Modules.Microsoft.CSharp.Sandbox.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/sdk:11.0.100-rc.1
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    CodeGraphRefresh=false \
    ASPNETCORE_HTTP_PORTS=8080
WORKDIR /brain
COPY .editorconfig global.json Directory.Build.props Directory.Build.targets Directory.Packages.props ./
COPY src/Modules/ src/Modules/
RUN dotnet build src/Modules/DigitalBrain/Kernel/DigitalBrain.Client/DigitalBrain.Client.csproj -c Debug \
    && for contracts in $(find src/Modules -name '*.Contracts.csproj'); do dotnet build "$contracts" -c Debug || exit 1; done
WORKDIR /app
COPY --from=host /app .
EXPOSE 8080
ENTRYPOINT ["dotnet", "DigitalBrain.Modules.Microsoft.CSharp.Sandbox.dll"]

  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AI/DigitalBrain.Modules.AI.csproj" />
    <ProjectReference Include="../../DigitalBrain/Kernel/Aspire.Hosting/DigitalBrain.Aspire.Hosting.csproj" />
  </ItemGroup>
</Project>

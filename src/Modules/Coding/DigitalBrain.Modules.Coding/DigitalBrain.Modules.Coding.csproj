<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Coding module: change sets and git.</Description>
    <RootNamespace>DigitalBrain.Coding</RootNamespace>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
    <!-- Roslyn's MSBuild loader flows Microsoft.Build.Framework into this project. -->
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DigitalBrain.Modules.Coding.Tests.Unit" />
    <ProjectReference Include="../DigitalBrain.Modules.Coding.Contracts/DigitalBrain.Modules.Coding.Contracts.csproj" />
    <ProjectReference Include="../../Microsoft/DotNet/DigitalBrain.Modules.Microsoft.DotNet/DigitalBrain.Modules.Microsoft.DotNet.csproj" />
    <ProjectReference Include="../../Microsoft/Roslyn/DigitalBrain.Modules.Microsoft.Roslyn/DigitalBrain.Modules.Microsoft.Roslyn.csproj" />
    <ProjectReference Include="../../DigitalBrain/Kernel/DigitalBrain.Core/DigitalBrain.Core.csproj" />
  </ItemGroup>
</Project>
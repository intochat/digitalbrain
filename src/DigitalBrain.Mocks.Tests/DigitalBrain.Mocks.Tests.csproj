<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- CA1515: test-local dashboard neuron is a hosted grain and must stay public. -->
    <NoWarn>$(NoWarn);ORLEANSEXP005;CA2007;CA1515;CA1062</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DigitalBrain.Mocks\DigitalBrain.Mocks.csproj" />
    <ProjectReference Include="..\DigitalBrain.Testing\DigitalBrain.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Journaling" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>

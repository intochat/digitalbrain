<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Local runs write grain state under this folder. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.digitalbrain/**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Client" />
    <InternalsVisibleTo Include="IntoChat.Tests.E2E" />
    <InternalsVisibleTo Include="IntoChat.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../IntoChat.ServiceDefaults/IntoChat.ServiceDefaults.csproj" />
    <ProjectReference Include="../../DigitalBrain/OS/DigitalBrain.OS/DigitalBrain.OS.csproj" />
    <ProjectReference Include="../../DigitalBrain/Sdk/DigitalBrain.Sdk/DigitalBrain.Sdk.csproj" />
    <ProjectReference Include="../../DigitalBrain/Platform/DigitalBrain.Platform/DigitalBrain.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Apps/**/*" LogicalName="IntoChat.ShippedApps/%(RecursiveDir)%(Filename)%(Extension)" Link="ShippedApps/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

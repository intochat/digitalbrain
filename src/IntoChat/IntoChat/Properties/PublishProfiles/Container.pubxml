<?xml version="1.0" encoding="utf-8"?>
<!-- Used only by deploy.yml PublishContainer — keeps Container* props out of plain CI builds.
     The module set is checked against AppHost composition by the host unit suite.
     Managed identity and Key Vault are configuration, not code: set AZURE_CLIENT_ID and
     DigitalBrain__KeyVault__Uri on the container app, or provide them through the hosted profile. -->
<Project>
  <PropertyGroup>
    <PublishProtocol>Container</PublishProtocol>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>digitalbrain-kernel</ContainerRepository>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:11.0.0-rc.1</ContainerBaseImage>
    <ContainerRuntimeIdentifier>linux-x64</ContainerRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
    <ContainerEnvironmentVariable Include="IntoChat__Hosted__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Standalone" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__ai__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__clickhouse__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__supabase__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__time__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__gmail__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__salesforce__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__github__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__flutter__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__compute__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__registry__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__apps__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__qdrant__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__files__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__postgres__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__assistant__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__playwright__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__specs__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__aspire__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__csharp__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__csharp-authoring__Enabled" Value="true" />
  </ItemGroup>
</Project>


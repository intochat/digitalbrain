<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>DigitalBrain.Testing</RootNamespace>
    <PackageId>DigitalBrain.Simulation</PackageId>
    <Description>The deterministic simulator: DigitalBrain neurons on an in-memory journal and a clock that moves only when told. No test framework.</Description>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DigitalBrain/DigitalBrain.csproj" />
    <ProjectReference Include="../DigitalBrain.UI/DigitalBrain.UI.csproj" />
    <ProjectReference Include="../DigitalBrain.Capabilities.Storage/DigitalBrain.Capabilities.Storage.csproj" />
    <ProjectReference Include="../DigitalBrain.Capabilities.Secrets/DigitalBrain.Capabilities.Secrets.csproj" />
    <ProjectReference Include="../DigitalBrain.Capabilities.Identity/DigitalBrain.Capabilities.Identity.csproj" />
    <ProjectReference Include="../DigitalBrain.Capabilities.Connections/DigitalBrain.Capabilities.Connections.csproj" />
    <ProjectReference Include="../DigitalBrain.Runtime.Synapses/DigitalBrain.Runtime.Synapses.csproj" />
    <ProjectReference Include="../DigitalBrain.Capabilities.Http/DigitalBrain.Capabilities.Http.csproj" />
    <ProjectReference Include="../DigitalBrain.Capabilities.Tools/DigitalBrain.Capabilities.Tools.csproj" />

    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />

    <InternalsVisibleTo Include="DigitalBrain.Testing" />
    <InternalsVisibleTo Include="DigitalBrain.Testing.Silo" />
    <InternalsVisibleTo Include="DigitalBrain.Testing.Tests.Unit" />
    <InternalsVisibleTo Include="DigitalBrain.Framework.Tests.E2E" />
    <InternalsVisibleTo Include="DigitalBrain.Architecture.Tests.Unit" />
  </ItemGroup>
</Project>

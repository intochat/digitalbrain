<Project Sdk="Microsoft.NET.Sdk">
  <!-- 08-03: code fixes need Workspaces, which an analyzer assembly must not reference (RS1038), so they live in
       their own netstandard2.0 assembly packed next to DigitalBrain.Analyzers.dll under analyzers/dotnet/cs in both
       the DigitalBrain.Analyzers and the DigitalBrain packages. Not a package of its own. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <RootNamespace>DigitalBrain.Analyzers.CodeFixes</RootNamespace>
    <IncludeSymbols>false</IncludeSymbols>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <ProjectReference Include="../DigitalBrain.Analyzers/DigitalBrain.Analyzers.csproj" />
  </ItemGroup>
</Project>

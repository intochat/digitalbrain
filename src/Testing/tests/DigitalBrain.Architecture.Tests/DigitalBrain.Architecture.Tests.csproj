<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <ProjectReference Include="../../DigitalBrain.Testing/DigitalBrain.Testing.csproj" />
    <ArchitectureProject Include="../../../DigitalBrain/**/*.csproj;../../../Modules/**/*.csproj"
                         Exclude="../../../**/tests/**;../../../**/*.Testing/**;../../../**/*.Aspire.Hosting/**;../../../**/*.Deployment/**;../../../DigitalBrain/Deployment/**;../../../**/*.Sandbox/**" />
    <ProjectReference Include="@(ArchitectureProject)" />
    <None Include="PersistedStateIds.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="CollectionCompatibilitySamples.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="WriteArchitectureAssemblies" AfterTargets="Build">
    <WriteLinesToFile File="$(OutDir)ArchitectureAssemblies.txt"
                      Lines="@(ArchitectureProject->'%(Filename)')" Overwrite="true" />
  </Target>
</Project>

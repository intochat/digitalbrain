<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);ORLEANSEXP005;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="xunit.v3.mtp-v2" /><Using Include="Xunit" /></ItemGroup>
</Project>

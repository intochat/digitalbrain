<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Tests against a brain in a real process: Aspire-managed storage, real HTTP, and a browser when a module runs a frontend.</Description>
    <!-- Launched as the module runtime process by ModuleTestHost; never shipped as a native host. -->
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.Orleans.Client" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AzureStorage" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DigitalBrain.Testing/DigitalBrain.Testing.csproj" />
    <ProjectReference Include="../../Modules/DigitalBrain/Aspire.Hosting/DigitalBrain.Aspire.Hosting.csproj" />
    <ProjectReference Include="../../Modules/DigitalBrain/Aspire/DigitalBrain.Aspire.csproj" />
    <ProjectReference Include="../../Modules/DigitalBrain/Sdk/DigitalBrain.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Build/DigitalBrain.Testing.E2E.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
</Project>

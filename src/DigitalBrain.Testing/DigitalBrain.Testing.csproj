    <Description>The DigitalBrain simulation and hosted-test machine (L1 Scenario + exclusive L2 Aspire HostedScenario). Development-only — includes Aspire.Hosting.Testing for L2 entry points.</Description>
    <NoWarn>$(NoWarn);ORLEANSEXP005;CA2007;CA1812</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" />

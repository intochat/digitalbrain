<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>DigitalBrain.Runtime.Synapses</RootNamespace>
    <PackageId>DigitalBrain.Runtime.Synapses</PackageId>
    <Description>Compiles synapse source to assemblies with the shipped DigitalBrain analyzers, including the synapse rules DB0041-DB0044, and loads them into collectible contexts. No Orleans.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DigitalBrain/DigitalBrain.csproj" />
    <!-- DigitalBrain.Analyzers packs analyzer-only (no lib/), so it is no package dependency: its dll ships in this package's lib/. -->
    <ProjectReference Include="../DigitalBrain.Analyzers/DigitalBrain.Analyzers.csproj" ReferenceOutputAssembly="true" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="$(OutDir)DigitalBrain.Analyzers.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DigitalBrain.Runtime.Synapses.Tests.Unit" />
    <InternalsVisibleTo Include="DigitalBrain.Testing.Tests.Unit" />
    <InternalsVisibleTo Include="DigitalBrain.Architecture.Tests.Unit" />
  </ItemGroup>
</Project>

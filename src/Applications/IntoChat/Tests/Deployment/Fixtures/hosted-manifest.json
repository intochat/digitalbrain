        "DigitalBrain__Google__Gmail__OAuth__HostGmail": "True",
        "DigitalBrain__Salesforce__Mcp__Endpoint": "https://api.salesforce.com/platform/mcp/v1/platform/sobject-all",
        "DigitalBrain__Salesforce__Hosting__HostMcp": "True",
        "DigitalBrain__Salesforce__Mcp__AllowLoopback": "False",
        "DigitalBrain__Salesforce__Hosting__PublicOrigin": "",

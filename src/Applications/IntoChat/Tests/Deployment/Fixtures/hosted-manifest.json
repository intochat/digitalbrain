        "CLICKHOUSE_HOST": "{ClickHouse.bindings.http.host}",
        "CLICKHOUSE_PORT": "{ClickHouse.bindings.http.port}",
        "CLICKHOUSE_USERNAME": "default",
        "CLICKHOUSE_PASSWORD": "{ClickHouse-password.value}",
        "CLICKHOUSE_DATABASENAME": "digitalbrain",
        "ConnectionStrings__supabase": "{supabase-connection.value}",
        "DigitalBrain__Google__Gmail__OAuth__ClientId": "{gmail-client-id.value}",
        "DigitalBrain__Google__Gmail__OAuth__ClientSecret": "{gmail-client-secret.value}",
        "DigitalBrain__Salesforce__OAuth__ConsumerKey": "{salesforce-consumer-key.value}",
        "DigitalBrain__Salesforce__OAuth__ConsumerSecret": "{salesforce-consumer-secret.value}",
        "DigitalBrain__Salesforce__OAuth__PublicOrigin": "{IntoChat.bindings.http.url}",
        "OTEL_DOTNET_EXPERIMENTAL_ASPNETCORE_DISABLE_URL_QUERY_REDACTION": "false",
        "OTEL_DOTNET_EXPERIMENTAL_HTTPCLIENT_DISABLE_URL_QUERY_REDACTION": "false",
        "IntoChat__Assistant__Model": "IGpt56Luna",
        "IntoChat__Hosted__Enabled": "true"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "port": 5080
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        },
        "orleans-silo": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 8000
        },
        "orleans-gateway": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 8001
        }
      }
    },
    "openai-api-key": {
      "type": "parameter.v0",
      "value": "{openai-api-key.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true
        }
      }
    },
    "ollama": {
      "type": "container.v0",
      "connectionString": "Endpoint={ollama.bindings.http.scheme}://{ollama.bindings.http.host}:{ollama.bindings.http.port}",
      "image": "docker.io/ollama/ollama:latest",
      "volumes": [
        {
          "name": "intochat.apphost-d570d561ba-ollama-ollama",
          "target": "/root/.ollama",
          "readOnly": false
        }
      ],
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 11434
        }
      }
    },
    "gemma4-e2b": {
      "type": "value.v0",
      "connectionString": "{ollama.connectionString};Model=gemma4:e2b"
    },
    "tavily-api-key": {
      "type": "parameter.v0",
      "value": "{tavily-api-key.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true
        }
      }
    },
    "qdrant": {
      "type": "container.v0",
      "connectionString": "Endpoint={qdrant.bindings.grpc.url};Key={qdrant-Key.value}",
      "image": "docker.io/qdrant/qdrant:v1.18.0",
      "volumes": [
        {
          "name": "intochat.apphost-d570d561ba-qdrant-data",
          "target": "/qdrant/storage",
          "readOnly": false
        }
      ],
      "env": {
        "QDRANT__SERVICE__API_KEY": "{qdrant-Key.value}",
        "QDRANT__SERVICE__ENABLE_STATIC_CONTENT": "0"
      },
      "bindings": {
        "grpc": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http2",
          "targetPort": 6334
        },
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 6333
        }
      }
    },
    "ClickHouse": {
      "type": "container.v0",
      "connectionString": "Host={ClickHouse.bindings.http.host};Port={ClickHouse.bindings.http.port};Username=default;Password={ClickHouse-password.value}",
      "image": "docker.io/clickhouse/clickhouse-server:latest",
      "volumes": [
        {
          "name": "intochat.apphost-d570d561ba-ClickHouse-data",
          "target": "/var/lib/clickhouse",
          "readOnly": false
        }
      ],
      "env": {
        "CLICKHOUSE_USER": "default",
        "CLICKHOUSE_PASSWORD": "{ClickHouse-password.value}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 8123
        }
      }
    },
    "clickhouse-db": {
      "type": "value.v0",
      "connectionString": "Host={ClickHouse.bindings.http.host};Port={ClickHouse.bindings.http.port};Username=default;Password={ClickHouse-password.value};Database=digitalbrain"
    },
    "supabase-connection": {
      "type": "parameter.v0",
      "value": "{supabase-connection.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true
        }
      }
    },
    "FlutterShell": {
      "type": "executable.v0",
      "workingDirectory": "../../../../../Modules/Google/Flutter/app/shell",
      "command": "E:\\tools\\flutter\\bin\\flutter",
      "args": [
        "run",
        "-d",
        "windows"
      ],
      "env": {
        "DIGITALBRAIN_SHELL": "desk",
        "DIGITALBRAIN_CHAT": "main",
        "DIGITALBRAIN_UI_BASE": "{IntoChat.bindings.http.url}"
      }

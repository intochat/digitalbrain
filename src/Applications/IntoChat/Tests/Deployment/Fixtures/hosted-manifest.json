        "Orleans__GrainStorage__Default__ServiceKey": "grainstate",
        "ConnectionStrings__grainstate": "{grainstate.connectionString}",
        "GRAINSTATE_URI": "{storage.outputs.blobEndpoint}",
        "Orleans__Endpoints__SiloPort": "{IntoChat.bindings.orleans-silo.targetPort}",
        "Orleans__Endpoints__GatewayPort": "{IntoChat.bindings.orleans-gateway.targetPort}",
        "DigitalBrain__Modules__0": "DigitalBrain.AI.AIModule, DigitalBrain.Modules.AI",

        "DigitalBrain__AI__Ollama__IGemma4__Model": "gemma4:e2b",
        "DigitalBrain__AI__OpenAI__ApiKey": "{openai-api-key.value}",
        "ConnectionStrings__memory-qdrant": "Endpoint={qdrant.bindings.grpc.url};Key={qdrant-Key.value}",
        "MEMORY_QDRANT_GRPCHOST": "{qdrant.bindings.grpc.host}",
        "MEMORY_QDRANT_GRPCPORT": "{qdrant.bindings.grpc.port}",
        "MEMORY_QDRANT_HTTPHOST": "{qdrant.bindings.http.host}",
        "MEMORY_QDRANT_HTTPPORT": "{qdrant.bindings.http.port}",
        "MEMORY_QDRANT_APIKEY": "{qdrant-Key.value}",
        "MEMORY_QDRANT_URI": "{qdrant.bindings.grpc.url}",
        "MEMORY_QDRANT_HTTPURI": "{qdrant.bindings.http.url}",

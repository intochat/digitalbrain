        "COMPUTE_DATABASENAME": "compute",
        "Orleans__Clustering__ProviderType": "AzureTableStorage",
        "Orleans__Clustering__ServiceKey": "clustering",
        "ConnectionStrings__clustering": "{clustering.connectionString}",
        "CLUSTERING_URI": "{storage.outputs.tableEndpoint}",
        "Orleans__ClusterId": "digitalbrain-8dd5653331814da09f6d388ce4bdb857",
        "Orleans__ServiceId": "digitalbrain-8dd5653331814da09f6d388ce4bdb857",
        "Orleans__EnableDistributedTracing": "true",
        "Orleans__Reminders__ProviderType": "AzureTableStorage",
        "Orleans__Reminders__ServiceKey": "reminders",
        "ConnectionStrings__reminders": "{reminders.connectionString}",
        "REMINDERS_URI": "{storage.outputs.tableEndpoint}",

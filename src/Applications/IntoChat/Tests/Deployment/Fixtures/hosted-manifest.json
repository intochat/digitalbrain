        "DigitalBrain__Flutter__Hosting__FlutterCommand": "",
        "DigitalBrain__Flutter__Hosting__WorkingDirectory": "",
        "DigitalBrain__Flutter__Hosting__ReleaseBuild": "False",
        "OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT": "false",

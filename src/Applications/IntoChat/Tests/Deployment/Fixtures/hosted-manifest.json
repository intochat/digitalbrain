    "gmail-client-id": {
      "type": "parameter.v0",
      "value": "{gmail-client-id.inputs.value}",
      "inputs": {
        "value": {
          "type": "string"
        }
      }
    },
    "gmail-client-secret": {
      "type": "parameter.v0",
      "value": "{gmail-client-secret.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",

      "inputs": {
        "value": {
          "type": "string",
          "secret": true
        }
      }
    },
    "salesforce-consumer-secret": {
      "type": "parameter.v0",
      "value": "{salesforce-consumer-secret.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true
        }
      }
    },
    "storage-roles": {
      "type": "azure.bicep.v0",
      "path": "storage-roles.module.bicep",
      "params": {
        "storage_outputs_name": "{storage.outputs.name}",
        "principalType": "",
        "principalId": ""
      }
    },
    "compute-postgres-password": {
      "type": "parameter.v0",
      "value": "{compute-postgres-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22
            }
          }
        }
      }
    },
    "compute-postgres-password-uri-encoded": {
      "type": "annotated.string",
      "value": "{compute-postgres-password.value}",
      "filter": "uri"
    },
    "qdrant-Key": {
      "type": "parameter.v0",
      "value": "{qdrant-Key.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22,
              "special": false
            }
          }

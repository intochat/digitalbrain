    "compute-postgres": {
      "type": "container.v0",
      "connectionString": "Host={compute-postgres.bindings.tcp.host};Port={compute-postgres.bindings.tcp.port};Username=postgres;Password={compute-postgres-password.value}",
      "image": "docker.io/library/postgres:18.3",

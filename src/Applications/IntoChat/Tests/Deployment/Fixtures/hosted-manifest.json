        "DigitalBrain__AI__Hosting__Llms__0": "IGpt56Luna",
        "DigitalBrain__AI__Hosting__Llms__1": "IGemma4",
        "DigitalBrain__AI__Hosting__Embeddings__0": "ITextEmbedding3Small",
        "DigitalBrain__Memory__Provider": "Qdrant",
        "DigitalBrain__Memory__HostQdrant": "True",
        "DigitalBrain__Memory__Qdrant__ConnectionName": "memory-qdrant",
        "DigitalBrain__Memory__Qdrant__CollectionName": "",
        "DigitalBrain__ClickHouse__Provider": "ClickHouse",
        "DigitalBrain__ClickHouse__ConnectionName": "clickhouse",
        "DigitalBrain__ClickHouse__Hosting__Enabled": "True",

          "name": "intochat.apphost-d570d561ba-compute-postgres-data",
          "target": "/var/lib/postgresql",
          "readOnly": false
        }
      ],
      "env": {
        "POSTGRES_HOST_AUTH_METHOD": "scram-sha-256",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256 --auth-local=scram-sha-256",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "{compute-postgres-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 5432
        }
      }
    },
    "compute-database": {
      "type": "value.v0",
      "connectionString": "{compute-postgres.connectionString};Database=compute"
    },
    "IntoChat": {
      "type": "project.v0",

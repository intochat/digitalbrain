<?xml version="1.0" encoding="utf-8"?>
<!-- Used only by deploy.yml PublishContainer — keeps Container* props out of plain CI builds.
     Hosted product deployment: only the product-profile modules are baked in, so the Windows
     developer executor (Coding / Behavior / Roslyn / DotNet / Aspire) is absent by construction.
     Managed identity and Key Vault are configuration, not code: set AZURE_CLIENT_ID and
     DigitalBrain__KeyVault__Uri on the container app, or provide them through the hosted profile. -->
<Project>
  <PropertyGroup>
    <PublishProtocol>Container</PublishProtocol>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>digitalbrain-kernel</ContainerRepository>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:11.0.0-rc.1</ContainerBaseImage>
    <ContainerRuntimeIdentifier>linux-x64</ContainerRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
    <ContainerEnvironmentVariable Include="IntoChat__Hosted__Enabled" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Standalone" Value="true" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__0" Value="DigitalBrain.AI.AIModule, DigitalBrain.Modules.AI" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__1" Value="DigitalBrain.Memory.MemoryModule, DigitalBrain.Modules.Memory" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__2" Value="DigitalBrain.ClickHouse.ClickHouseModule, DigitalBrain.Modules.ClickHouse" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__3" Value="DigitalBrain.Supabase.SupabaseModule, DigitalBrain.Modules.Supabase" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__4" Value="DigitalBrain.Time.TimeModule, DigitalBrain.Modules.Time" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__5" Value="DigitalBrain.Google.Gmail.GmailModule, DigitalBrain.Modules.Google.Gmail" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__6" Value="DigitalBrain.Salesforce.SalesforceModule, DigitalBrain.Modules.Salesforce" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__7" Value="DigitalBrain.Microsoft.GitHub.GitHubModule, DigitalBrain.Modules.Microsoft.GitHub" />
    <ContainerEnvironmentVariable Include="DigitalBrain__Modules__8" Value="DigitalBrain.Flutter.FlutterModule, DigitalBrain.Modules.Flutter" />
  </ItemGroup>
</Project>

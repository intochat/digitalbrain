    <InternalsVisibleTo Include="IntoChat.Tests.E2E" />
    <InternalsVisibleTo Include="IntoChat.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ServiceDefaults/IntoChat.ServiceDefaults.csproj" />
    <ProjectReference Include="../../../Modules/DigitalBrain/Kernel/Aspire/DigitalBrain.Aspire.csproj" />
    <ProjectReference Include="../../../Modules/DigitalBrain/Kernel/Kernel/DigitalBrain.csproj" />
    <ProjectReference Include="../../../Modules/DigitalBrain/Kernel/Sdk/DigitalBrain.Sdk.csproj" />
    <ProjectReference Include="../../../Modules/Time/Time/DigitalBrain.Modules.Time.csproj" />
    <ProjectReference Include="../../../Modules/DigitalBrain/Compute/Contracts/DigitalBrain.Modules.Compute.Contracts.csproj" />
    <ProjectReference Include="../../../Modules/DigitalBrain/Compute/Compute/DigitalBrain.Modules.Compute.csproj" />
    <ProjectReference Include="../../../Modules/Google/Gmail/Gmail/DigitalBrain.Modules.Google.Gmail.csproj" />
    <ProjectReference Include="../../../Modules/Google/Flutter/Flutter/DigitalBrain.Modules.Flutter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Modules/AI/AI/DigitalBrain.Modules.AI.csproj" />
    <ProjectReference Include="../../../Modules/Memory/Memory/DigitalBrain.Modules.Memory.csproj" />
    <ProjectReference Include="../../../Modules/ClickHouse/ClickHouse/DigitalBrain.Modules.ClickHouse.csproj" />
    <ProjectReference Include="../../../Modules/Supabase/Supabase/DigitalBrain.Modules.Supabase.csproj" />
    <ProjectReference Include="../../../Modules/Salesforce/Salesforce/DigitalBrain.Modules.Salesforce.csproj" />
    <ProjectReference Include="../../../Modules/Microsoft/GitHub/GitHub/DigitalBrain.Modules.Microsoft.GitHub.csproj" />
    <ProjectReference Include="../../../Modules/Microsoft/Aspire/Aspire/DigitalBrain.Modules.Microsoft.Aspire.csproj" />
    <ProjectReference Include="../../../Modules/Coding/Coding/DigitalBrain.Modules.Coding.csproj" />
    <ProjectReference Include="../../../Modules/Microsoft/Roslyn/Roslyn/DigitalBrain.Modules.Microsoft.Roslyn.csproj" />

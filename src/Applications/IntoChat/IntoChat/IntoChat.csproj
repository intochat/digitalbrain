  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Apps/**/*" LogicalName="IntoChat.ShippedApps/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Marketplace/Agents/*.md" LogicalName="IntoChat.Agents.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DigitalBrain.Sdk</RootNamespace>
    <AssemblyName>DigitalBrain.Sdk</AssemblyName>
    <PackageId>DigitalBrain.Sdk</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Module infrastructure: southbound MCP rail and shared webhook ingress for DigitalBrain modules.</Description>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Orleans.Journaling" />
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\kernel\DigitalBrain.Abstractions\DigitalBrain.Abstractions.csproj" />
    <ProjectReference Include="..\..\kernel\DigitalBrain.Core\DigitalBrain.Core.csproj" />
    <ProjectReference Include="..\..\security\DigitalBrain.Security\DigitalBrain.Security.csproj" />
    <ProjectReference Include="..\..\kernel\DigitalBrain.SourceGeneration\DigitalBrain.SourceGeneration.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>

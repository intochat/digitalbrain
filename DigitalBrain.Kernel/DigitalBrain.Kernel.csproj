<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DigitalBrain.Kernel</RootNamespace>
    <AssemblyName>DigitalBrain.Kernel</AssemblyName>
    <UserSecretsId>dotnet-DigitalBrain.Kernel-ea55b00e-5a06-4791-b7d3-a9f3aabb83f9</UserSecretsId>
    <!-- Allow alpha/experimental Orleans Journalling APIs (DurableGrain etc) -->
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>digitalbrain-kernel</ContainerRepository>
    <!-- noble-chiseled not yet published for .NET 11 preview; use standard preview base -->
    <!-- aspnet base: the kernel transitively references Microsoft.AspNetCore.App (Aspire ServiceDefaults /
         health checks / OpenTelemetry), so the plain runtime image fails to launch it. -->
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:11.0-preview</ContainerBaseImage>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <ContainerRuntimeIdentifier>linux-x64</ContainerRuntimeIdentifier>
  </PropertyGroup>


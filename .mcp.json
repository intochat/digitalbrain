{
  "mcpServers": {
    "digitalbrain": {
      "command": "dotnet",
      "args": [
        "run",
        "--no-build",
        "--project",
        "src/DigitalBrain.Mcp/DigitalBrain.Mcp.csproj",
        "--no-launch-profile"
      ],
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "digitalbrain-http": {
      "type": "http",
      "url": "http://localhost:5000/mcp"
    },
    "codegraph": {
      "command": "npx",
      "args": ["@colbymchenry/codegraph", "serve", "--mcp"]
    },
    "aspire": {
      "command": "aspire",
      "args": ["agent", "mcp"]
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp@latest"]
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Description>Shell and surface compositions over IDigitalBrain and module contracts only.</Description>
    <RootNamespace>DigitalBrain</RootNamespace>
    <NoWarn>$(NoWarn);CA2007;CA1822</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DigitalBrain.Client\DigitalBrain.Client.csproj" />
    <ProjectReference Include="..\..\src\DigitalBrain.Abstractions\DigitalBrain.Abstractions.csproj" />
    <ProjectReference Include="..\..\modules\DigitalBrain.Modules.Flutter.Contracts\DigitalBrain.Modules.Flutter.Contracts.csproj" />
    <ProjectReference Include="..\..\modules\DigitalBrain.Modules.Time.Contracts\DigitalBrain.Modules.Time.Contracts.csproj" />
    <ProjectReference Include="..\..\modules\DigitalBrain.Modules.AI.Contracts\DigitalBrain.Modules.AI.Contracts.csproj" />
  </ItemGroup>
  <Target Name="StripOrleansUsingsFromCompositions" BeforeTargets="CoreCompile;GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="Orleans" />
      <Using Remove="Orleans.Hosting" />
      <Using Remove="Orleans.Runtime" />
    </ItemGroup>
  </Target>
</Project>

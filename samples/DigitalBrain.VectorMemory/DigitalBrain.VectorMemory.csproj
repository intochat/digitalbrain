<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Description>Community-style IVectorMemory sample consumer — public Memory contracts + Client only; no Qdrant or Memory module implementation types.</Description>
    <RootNamespace>DigitalBrain.VectorMemory</RootNamespace>
    <NoWarn>$(NoWarn);CA2007;CA1822</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\core\kernel\DigitalBrain.Client\DigitalBrain.Client.csproj" />
    <ProjectReference Include="..\..\src\core\kernel\DigitalBrain.Abstractions\DigitalBrain.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\modules\memory\DigitalBrain.Modules.Memory.Contracts\DigitalBrain.Modules.Memory.Contracts.csproj" />
  </ItemGroup>
  <Target Name="StripOrleansUsingsFromVectorMemorySample" BeforeTargets="CoreCompile;GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="Orleans" />
      <Using Remove="Orleans.Hosting" />
      <Using Remove="Orleans.Runtime" />
    </ItemGroup>
  </Target>
</Project>

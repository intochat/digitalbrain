<Project>
  <PropertyGroup>
    <_CodeGraphSentinel>$(MSBuildThisFileDirectory).config\.codegraph-initialized</_CodeGraphSentinel>
  </PropertyGroup>

  <Target Name="InitCodeGraph" BeforeTargets="Build"
          Condition=" ! $([System.String]::new('$(MSBuildProjectName)').Contains('AppHost')) And !Exists('$(_CodeGraphSentinel)') ">
    <MakeDir Directories="$(MSBuildThisFileDirectory).config" />
    <Exec Command="npx --yes @colbymchenry/codegraph init"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_CodeGraphExitCode" />
    </Exec>
    <Touch Files="$(_CodeGraphSentinel)" AlwaysCreate="true" />
    <Warning Condition="'$(_CodeGraphExitCode)' != '0'"
             Text="CodeGraph init failed with exit code $(_CodeGraphExitCode). The codegraph MCP server has no index, so the Pre-Change Ritual's step 2 cannot be followed. Run 'npx @colbymchenry/codegraph init' manually, read the output, then delete .config/.codegraph-initialized to re-arm this check." />
  </Target>
</Project>

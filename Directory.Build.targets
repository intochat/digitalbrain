<Project>
  <!-- Runs after SDK/package props. Keep CI solution builds framework-dependent / portable. -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <RuntimeIdentifier></RuntimeIdentifier>
    <EnableSdkContainerSupport>false</EnableSdkContainerSupport>
  </PropertyGroup>

  <!-- IsPackable is false in Directory.Build.props and projects opt in from their own body,
       which imports later. Evaluating the pack items there always saw false, so the declared
       README and icon were never packed and pack failed with NU5039. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)src/Assets/nuget/icon.png" Pack="true" PackagePath="/" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)src/Assets/nuget/icon.png')" />
    <None Include="README.md" Pack="true" PackagePath="/" Visible="false" Condition="Exists('$(MSBuildProjectDirectory)/README.md')" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" Condition="!Exists('$(MSBuildProjectDirectory)/README.md')" />
  </ItemGroup>

  <!-- One file, two consumers: imported here for in-repo test projects and packed into the
       DigitalBrain.Testing.E2E package's buildTransitive for everyone else. -->
  <Import Project="$(MSBuildThisFileDirectory)src/Testing/DigitalBrain.Testing.E2E/Build/DigitalBrain.Testing.E2E.targets"
          Condition="$(MSBuildProjectName.EndsWith('.Tests.E2E'))" />

  <Target Name="RefreshCodeGraph"
          BeforeTargets="BeforeBuild"
          Inputs="@(Compile);$(MSBuildProjectFullPath)"
          Outputs="$(_CodeGraphStamp)"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(MSBuildProjectExtension)' == '.csproj' And '$(CI)' != 'true' And '$(CodeGraphRefresh)' != 'false'">
    <PropertyGroup>
      <_CodeGraphIndexExists>$([System.IO.Directory]::Exists('$(_CodeGraphIndex)'))</_CodeGraphIndexExists>
    </PropertyGroup>
    <Exec Command="$(_CodeGraphCommand) init &quot;$(_CodeGraphRepositoryRoot)&quot;"
          WorkingDirectory="$(_CodeGraphRepositoryRoot)"
          Condition="'$(_CodeGraphIndexExists)' != 'True'"
          IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="_CodeGraphExitCode" />
    </Exec>
    <Exec Command="$(_CodeGraphCommand) sync --quiet &quot;$(_CodeGraphRepositoryRoot)&quot;"
          WorkingDirectory="$(_CodeGraphRepositoryRoot)"
          Condition="'$(_CodeGraphIndexExists)' == 'True'"
          IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="_CodeGraphExitCode" />
    </Exec>
    <Touch Files="$(_CodeGraphStamp)" AlwaysCreate="true" Condition="'$(_CodeGraphExitCode)' == '0'" />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <DevelopmentDependency>true</DevelopmentDependency>
    <Description>Development-only DigitalBrain testing: assembly-owned real multi-silo fixtures, method-scoped TestBrain, deterministic time, typed journal evidence, closed durability faults, and exclusive Aspire AppHost testing.</Description>
    <NoWarn>$(NoWarn);ORLEANSEXP005;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\behaviors\DigitalBrain.Behaviors\DigitalBrain.Behaviors.csproj" />
    <ProjectReference Include="..\..\kernel\DigitalBrain.Client\DigitalBrain.Client.csproj" />
    <ProjectReference Include="..\..\kernel\DigitalBrain.Kernel\DigitalBrain.Kernel.csproj" />
    <ProjectReference Include="..\..\kernel\DigitalBrain.SourceGeneration\DigitalBrain.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\kernel\DigitalBrain.SourceGeneration\bin\$(Configuration)\netstandard2.0\DigitalBrain.SourceGeneration.dll"
          Pack="true"
          PackagePath="analyzers\dotnet\cs"
          Visible="false" />
  </ItemGroup>
</Project>

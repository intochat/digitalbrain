<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SkipBuild Condition="'$(SkipDeployBuild)' == 'true'">true</SkipBuild>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DigitalBrain.Deploy</RootNamespace>
    <AssemblyName>DigitalBrain.Deploy</AssemblyName>
    <!-- Standalone deployment project. Its Pulumi/Azure dependency graph does not affect the
         main solution build. Build directly with dotnet build deploy/DigitalBrain.Deploy.csproj. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageReference Include="Pulumi" Version="3.107.3" />
    <PackageReference Include="Pulumi.AzureNative" Version="3.19.0" />
  </ItemGroup>

</Project>
